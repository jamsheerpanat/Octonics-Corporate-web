---
import "../../styles/global.css";
import HeaderAr from "../../components/HeaderAr.astro";
import FooterAr from "../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const values = [
  {
    title: "الابتكار",
    desc: "نؤمن أن التكنولوجيا لازم تفكر قبل الوقت. كل حل من أوكتونيكس مصمم بعقلية متقدمة تجمع بين الذكاء، الأتمتة، والراحة لتجعل الحياة أسهل وأذكى.",
  },
  {
    title: "الشفافية والمصداقية",
    desc: "نبني الثقة من خلال الوضوح، الصراحة، والعلاقات الطويلة الأمد — نضمن إن كل مشروع نقدمه يحقق رؤية العميل ويلتزم بأعلى المعايير العالمية.",
  },
  {
    title: "التميز والجودة",
    desc: "من الكود إلى الكيبل — شغفنا بالتفاصيل يميزنا. فريقنا يضمن الدقة في كل تفصيلة تقنية، تصميم، وتنفيذ.",
  },
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>عن أوكتونيكس إنوفيشنز | الأتمتة الذكية وحلول التقنية في الكويت</title>
    <meta
      name="description"
      content="أوكتونيكس إنوفيشنز هي شركة كويتية متخصصة في الأتمتة الذكية، أنظمة KNX، البرمجيات ERP، الذكاء الاصطناعي، والبنية التحتية لتقنية المعلومات — مع مختبر تطوير متكامل في الهند."
    />
    <meta
      name="keywords"
      content="أوكتونيكس الكويت, الأتمتة الذكية, KNX الكويت, ERP الكويت, شركة تقنية الكويت, الذكاء الاصطناعي الكويت, أوكتونيكس إنوفيشنز, كينفرا تكنو بارك"
    />
    <meta property="og:title" content="عن أوكتونيكس إنوفيشنز | الأتمتة الذكية وحلول التقنية في الكويت" />
    <meta property="og:description" content="اكتشف أوكتونيكس إنوفيشنز — شركة كويتية معتمدة من KNX تعيد تعريف الأتمتة، ERP، والذكاء الاصطناعي من خلال مختبر تطوير عالمي في الهند." />
    <meta property="og:image" content="/images/about/og-about.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden">
    <!-- الهيدر -->
    <HeaderAr />

    <!-- القسم الرئيسي -->
    <section id="hero" class="relative isolate flex min-h-[90vh] items-center justify-center overflow-hidden text-center">
      <img
        src="/images/about/dark-octopus.jpg"
        alt="مكتب أوكتونيكس إنوفيشنز في الكويت"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/80 via-indigo-950/70 to-slate-900/90"></div>

      <div class="relative z-10 max-w-4xl px-4 text-white sm:px-6" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-6xl md:text-7xl">
          عن <span class="text-sky-400">أوكتونيكس</span> إنوفيشنز
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-slate-200 text-lg">
          شركة كويتية معتمدة من KNX ومزودة بتقنيات الذكاء الاصطناعي — تبني أنظمة المستقبل في الأتمتة، ERP، والبنية التحتية لتقنية المعلومات.
        </p>
      </div>
    </section>

    <!-- الفلسفة -->
    <section id="philosophy" class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div class="order-2 md:order-1">
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">الفلسفة وراء الاسم</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            اسم <strong>«أوكتونيكس»</strong> مأخوذ من كلمة <em>Octo</em> المستوحاة من ذكاء الأخطبوط وقدرته على التكيّف.
            بثمانية أذرع تعمل بتناغم تام، يرمز إلى طريقة عملنا في دمج تخصصات متعددة —
            الأتمتة، ERP، الذكاء الاصطناعي، البنية التحتية، والأمن السيبراني — ضمن نظام ذكي موحد.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            أما اللاحقة <em>-nics</em> فهي من كلمات <strong>Electronics, Technics, Dynamics</strong> وتعبر عن الدقة والانسيابية.
            معًا، تمثل <span class="text-sky-600 font-semibold">أوكتونيكس إنوفيشنز</span> التكنولوجيا القابلة للتطور مع الإنسان والأعمال.
          </p>
        </div>

        <figure class="relative order-1 md:order-2">
          <img
            src="/images/about/octopus-tech.jpg"
            alt="الأخطبوط مصدر إلهام أوكتونيكس"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-2 text-center text-xs text-slate-500">
            الأخطبوط — رمز الذكاء، التحكم، والقدرة على التكيّف.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- العمليات -->
    <section class="relative bg-gradient-to-br from-sky-50 via-white to-indigo-50 py-24" data-animate>
      <div class="mx-auto max-w-7xl grid gap-14 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
        <figure>
          <img
            src="/images/about/india-lab.jpg"
            alt="مختبر تطوير البرمجيات - كينفرا تكنو بارك الهند"
            loading="lazy"
            class="rounded-3xl shadow-xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-3 text-center text-xs text-slate-500">
            مختبر تطوير البرمجيات – كينفرا تكنو بارك، كاليكوت، الهند.
          </figcaption>
        </figure>

        <div class="flex flex-col justify-center">
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">حضور عالمي بقوة محلية</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            انطلاقاً من <strong>الكويت</strong> وبقوة فريق <strong>البحث والتطوير في الهند</strong>،
            تجمع أوكتونيكس بين الفهم المحلي والاحتراف الهندسي العالمي.
            يقع مختبرنا في <strong>كينفرا تكنو بارك – كاليكوت</strong>، ويضم مهندسين متخصصين في البرمجيات، الذكاء الاصطناعي، والأتمتة KNX.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            معًا، نقدم حلولاً مخصصة وآمنة وقابلة للتوسع — تربط المنازل، الشركات، والمدن ضمن بيئة ذكية واحدة.
          </p>
        </div>
      </div>
    </section>

    <!-- الفريق -->
    <section id="team" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-center" data-animate>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">فريقنا الهندسي</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        شباب مبدعين ومعتمدين دوليًا — يجمعون بين الإبداع والدقة في مجالات الأتمتة، الذكاء الاصطناعي، والبرمجيات.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { name: "جمشیر پانات", title: "مستشار تقني", img: "/images/team/jamsheer.jpg" },
          { name: "مهندس الأتمتة الرئيسي", title: "أخصائي KNX & DALI", img: "/images/team/lead-eng.jpg" },
          { name: "مهندس واجهات المستخدم", title: "مختبر التصميم – الهند", img: "/images/team/uiux.jpg" },
          { name: "مطور البرمجيات", title: "مسؤول التسويق", img: "/images/team/dev.jpg" },
        ].map((m) => (
          <div class="rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <img src={m.img} alt={m.name} loading="lazy" class="mx-auto h-24 w-24 rounded-full object-cover shadow-md" />
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{m.name}</h3>
            <p class="text-sm text-slate-500">{m.title}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- القيم -->
    <section id="values" class="relative bg-gradient-to-br from-indigo-700 via-sky-600 to-sky-500 py-24 text-white" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 text-center lg:px-8">
        <h2 class="text-3xl font-bold sm:text-4xl">قيمنا الأساسية</h2>
        <p class="mx-auto mt-3 max-w-2xl text-indigo-100">
          أساس كل ابتكار في أوكتونيكس هو الإنسان، الدقة، والهدف.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          {values.map((v) => (
            <article class="rounded-3xl bg-white/10 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-sm transition hover:-translate-y-1 hover:shadow-2xl">
              <h3 class="text-xl font-semibold text-white">{v.title}</h3>
              <p class="mt-2 text-sm text-indigo-100">{v.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- تواصل -->
    <section id="cta" class="relative mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 lg:px-8" data-animate>
      <div class="rounded-3xl bg-gradient-to-br from-indigo-600 to-sky-600 p-10 text-white shadow-2xl">
        <h2 class="text-2xl font-bold sm:text-3xl">انضم لرحلتنا نحو الابتكار الذكي</h2>
        <p class="mt-3 text-indigo-100">
          شاركنا في بناء المستقبل — من الأتمتة إلى التحليلات، نصمم أنظمة الغد اليوم.
        </p>
        <a
          href="/ar/contact"
          class="mt-6 inline-flex rounded-2xl bg-white px-6 py-3 font-semibold text-slate-900 shadow-md transition hover:scale-105"
        >
          تواصل معنا
        </a>
      </div>
    </section>

    <!-- الفوتر -->
    <FooterAr year={currentYear} />
  </body>
</html>