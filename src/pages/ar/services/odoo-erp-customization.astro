---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "تخصيص نظام Odoo ERP في الكويت",
  subtitle:
    "حلول Odoo ERP مصممة خصيصًا للشركات في الكويت — مترجمة، مؤتمتة، وقابلة للتوسع.",
  image: "/images/odoo-erp-kuwait.jpg",
  keywords: [
    "Odoo ERP الكويت",
    "تخصيص Odoo الكويت",
    "تنفيذ ERP الكويت",
    "شريك Odoo الكويت",
    "Octonics Odoo",
    "برامج إدارة الأعمال الكويت",
    "وحدات Odoo ERP",
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | أوكتونيكس إنوفيشنز الكويت</title>
    <meta
      name="description"
      content="تقدم أوكتونيكس إنوفيشنز خدمات تخصيص وتنفيذ نظام Odoo ERP في الكويت — مع دعم اللغة العربية، الأتمتة، والذكاء الاصطناعي لتبسيط إدارة الأعمال."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta property="og:image" content={service.image} />
    <meta
      property="og:description"
      content="نخصص نظام Odoo ERP لإدارة المحاسبة والمبيعات والموارد البشرية والتصنيع — متوافق مع متطلبات الأعمال في الكويت."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Odoo ERP Customization",
        description:
          "تخصيص وتطوير نظام Odoo ERP في الكويت — مع دعم اللغة العربية، والأتمتة، والتكامل مع الذكاء الاصطناعي.",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        areaServed: "Kuwait",
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- ===== الهيدر ===== -->
    <Header />

    <!-- ===== البانر الرئيسي ===== -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>
      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          تخصيص نظام Odoo ERP
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          بسّط عملياتك باستخدام <strong>نظام Odoo ERP المحلي</strong> — مصمم لإدارة المحاسبة، الموارد
          البشرية، المبيعات، والتصنيع في بيئة الأعمال الكويتية.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
          >تحدث مع خبير Odoo →</a
        >
      </div>
    </section>

    <!-- ===== لماذا Odoo ===== -->
    <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 text-right" data-animate>
      <div class="text-center">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
          لماذا تختار نظام Odoo ERP؟
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-slate-600">
          Odoo هو النظام المفتوح المصدر الأكثر مرونة في العالم — يضم أكثر من 30 تطبيقًا إداريًا متكاملًا
          لدعم نمو الشركات.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["المحاسبة والمالية", "أتمتة الفواتير، والتسويات البنكية، والامتثال الضريبي."],
          ["الموارد البشرية", "إدارة الحضور والرواتب والتوظيف بسهولة."],
          ["المبيعات وإدارة العملاء", "تتبع العملاء والعروض والمبيعات من أي مكان."],
          ["المخزون والتصنيع", "تحكم كامل في المستودعات وخطوط الإنتاج وسلسلة التوريد."],
          ["إدارة المشاريع", "تخطيط وتعاون ومتابعة المهام بوضوح وكفاءة."],
          ["التجارة الإلكترونية ونقاط البيع", "ربط متكامل بين المتجر الإلكتروني والبيع بالتجزئة."],
        ].map(([title, desc]) => (
          <div
            class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300"
          >
            <div
              class="absolute inset-0 -z-10 rounded-3xl bg-gradient-to-r from-sky-200/20 to-indigo-200/20 opacity-0 transition group-hover:opacity-100"
            ></div>
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== التخصيص المحلي ===== -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-24 text-white" data-animate>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">مصمم خصيصًا للكويت</h3>
        <p class="mx-auto mt-4 max-w-2xl text-indigo-100">
          نخصص نظام Odoo ERP ليتوافق مع <strong>ضريبة القيمة المضافة الكويتية</strong>،
          <strong>اللغة العربية</strong>، و<strong>قوانين العمل المحلية</strong> — لضمان أداء مثالي وسلس
          لفرقك التشغيلية.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {[
            ["🇰🇼 واجهة عربية", "واجهة مستخدم مترجمة بالكامل مع دعم الاتجاه من اليمين لليسار (RTL)."],
            ["💰 الفواتير والضرائب", "نظام محاسبي متكامل متوافق مع متطلبات الضرائب الكويتية."],
            ["⚙️ الأتمتة الذكية", "تدفقات عمل ذكية تعتمد على الذكاء الاصطناعي لتقليل الأخطاء وتسريع الأداء."],
          ].map(([icon, desc]) => (
            <div class="rounded-3xl bg-white/10 p-6 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <div class="text-2xl mb-2">{icon}</div>
              <p class="text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== التكامل الذكي ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-right" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            وسّع Odoo بالذكاء الاصطناعي والتكاملات الذكية
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            تقوم أوكتونيكس بدمج Odoo ERP مع لوحات تحكم ذكية تعتمد على الذكاء الاصطناعي، وبيانات أتمتة
            المباني KNX، وأجهزة إنترنت الأشياء — لتوحيد المعلومات التشغيلية والبيئية.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>🤖 تحليلات ولوحات ذكاء اصطناعي متقدمة</li>
            <li>🌐 تكامل مع أنظمة KNX وDALI وإنترنت الأشياء</li>
            <li>📊 تنبؤات وتنبيهات بالأداء التجاري</li>
            <li>🔗 تكامل API متطور ومزامنة مع سحابة Odoo</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/odoo-ai.jpg"
            alt="تكامل Odoo مع الذكاء الاصطناعي"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- ===== الدعوة للتواصل ===== -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-16 text-white text-center">
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">ابدأ بناء نظام Odoo الخاص بك</h3>
        <p class="mt-3 text-indigo-100">
          من الشركات الصغيرة إلى المؤسسات الكبرى — أوكتونيكس تخصص Odoo ERP بما يناسب بيئة الأعمال
          الكويتية الفريدة.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
          >احصل على استشارة مجانية →</a
        >
      </div>
    </section>

    <!-- ===== الفوتر ===== -->
    <FooterAr year={currentYear} />
  </body>
</html>