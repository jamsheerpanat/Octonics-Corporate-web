---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";

import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const page = {
  title: "أنظمة المراقبة والتحكم في الدخول في الكويت | Octonics Innovations",
  description:
    "توفر شركة أوكتونيكس إنوفيشنز حلول مراقبة ذكية متقدمة تشمل أنظمة كاميرات المراقبة (CCTV)، التحكم البيومتري في الدخول، وأنظمة قراءة لوحات المركبات (ANPR) في الكويت — مصممة للفيلات، المكاتب، والمنشآت الصناعية.",
  image: "/images/surveillance/hero-security.jpg",
};
---

<html lang="ar" dir="rtl">
  <head>
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta
      name="keywords"
      content="كاميرات مراقبة الكويت, CCTV الكويت, أنظمة أمنية الكويت, بصمة الدخول الكويت, التحكم في الأبواب الكويت, أنظمة ANPR الكويت, أوكتونيكس الكويت, أنظمة الحضور والانصراف الكويت, الذكاء الاصطناعي الأمني الكويت"
    />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={page.image} />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "أنظمة المراقبة والتحكم في الدخول",
        description:
          "توفر أوكتونيكس إنوفيشنز أنظمة مراقبة CCTV بالذكاء الاصطناعي، والتحكم البيومتري في الدخول، وأنظمة قراءة لوحات المركبات ANPR — للفيلات والمكاتب والمباني التجارية في الكويت.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        serviceType: "CCTV, Access Control, Security Systems",
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={page.image}
          alt="أنظمة المراقبة والتحكم في الدخول في الكويت"
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          أنظمة المراقبة والتحكم في الدخول في الكويت
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          احمِ منزلك أو مكتبك أو منشأتك الصناعية باستخدام
          <strong>أنظمة المراقبة والتحكم البيومتري المدعومة بالذكاء الاصطناعي</strong> —
          مصممة من قبل أوكتونيكس لضمان الموثوقية والوعي الفوري.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          احجز زيارة ميدانية →
        </a>
      </div>
    </section>

    <!-- SOLUTIONS OVERVIEW -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-right" data-animate dir="rtl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
          حلول أمنية ومراقبة متكاملة
        </h2>
        <p class="mt-3 max-w-2xl mx-auto text-slate-600">
          أنظمتنا تجمع بين المراقبة والتحكم والتحليل الذكي — لتمنحك رؤية كاملة وتحكمًا شاملاً من منصة واحدة.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["🎥 مراقبة CCTV بنظام IP", "كاميرات 4K مزودة بالرؤية الليلية وكشف الحركة وتحليل الصور باستخدام الذكاء الاصطناعي."],
          ["🔐 التحكم في الدخول بالبصمة", "دخول عبر الوجه أو البصمة أو بطاقة RFID مع نظام حضور وانصراف وإدارة الزوار."],
          ["🚗 قراءة لوحات المركبات ANPR", "تعرف تلقائي على أرقام المركبات لإدارة البوابات والمواقف الذكية."],
          ["🧠 تحليلات الفيديو الذكية", "كشف التسلل والكثافة والحوادث في الوقت الفعلي مع تنبيهات سحابية فورية."],
          ["🏢 منصة أمنية موحدة", "دمج أنظمة الكاميرات والدخول والإنذار في لوحة تحكم واحدة."],
          ["📡 المراقبة السحابية عن بُعد", "الوصول إلى البث المباشر والسجلات من أي مكان عبر تطبيق الجوال أو المتصفح."],
        ].map(([title, desc]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ADVANCED SECURITY INTEGRATION -->
    <section
      class="relative bg-gradient-to-r from-indigo-700 to-sky-700 py-24 text-white text-center"
      data-animate
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h3 class="text-3xl font-bold sm:text-4xl">
          ذكاء متكامل لأماكن أكثر أمانًا
        </h3>
        <p class="mt-3 max-w-3xl mx-auto text-indigo-100">
          أنظمتنا المدعومة بالذكاء الاصطناعي تتجاوز حدود المراقبة التقليدية — فهي تدمج أجهزة الاستشعار والأتمتة والتحليلات لتحقيق الحماية الاستباقية.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
          {[
            ["🌡️ أجهزة مقاومة للمناخ", "كاميرات وقارئات بمعيار IP66 مصممة لتحمل حرارة وغبار الكويت."],
            ["⚙️ تكامل ذكي مع الأتمتة", "تشغيل الإضاءة أو الإنذار أو البوابات تلقائيًا عبر تكامل KNX أو RTI."],
            ["📲 إشعارات فورية", "تنبيهات عبر الجوال ونسخ احتياطي سحابي عند أي خرق أمني أو دخول غير مصرح."],
          ].map(([title, desc]) => (
            <div class="rounded-3xl bg-white/10 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold">{title}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VISUALIZATION & CONTROL -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-right" data-animate dir="rtl">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            تحكم مركزي شامل بالأمن
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            إدارة جميع الكاميرات والأبواب والإنذارات من واجهة واحدة — مع عرض الحالة في الوقت الفعلي والتحليلات والتقارير الدقيقة.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• لوحة موحدة لأنظمة الكاميرات والدخول والحرائق</li>
            <li>• كشف تلقائي للحوادث مدعوم بالذكاء الاصطناعي</li>
            <li>• إمكانية النشر السحابي أو المحلي</li>
            <li>• تكامل مع أنظمة الإضاءة والتكييف الذكية</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/surveillance/control-center.jpg"
            alt="التحكم المركزي الأمني في الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- WHY CHOOSE OCTONICS -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 text-center" data-animate>
      <h3 class="text-3xl font-bold text-slate-900 sm:text-4xl">
        لماذا تختار أنظمة أوكتونيكس الأمنية؟
      </h3>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        من الاستشارة إلى التركيب والدعم مدى الحياة — نضمن أن كل نظام أمني مُصمم بدقة واعتمادية تامة.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {[
          ["مهندسون معتمدون", "متخصصون في أنظمة المراقبة والتحكم بالذكاء الاصطناعي مع شهادات عالمية."],
          ["علامات تجارية عالمية", "شراكات مع Hikvision وDahua وSuprema وZKTeco وRTI لضمان أفضل أداء."],
          ["خبرة محلية", "فريقنا في الكويت يوفر التركيب والصيانة والدعم الفني المستمر."],
        ].map(([title, desc]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <h4 class="text-xl font-semibold text-indigo-700">{title}</h4>
            <p class="mt-2 text-slate-600 text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center">
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">أمان ذكي وسلس.</h3>
        <p class="mt-3 text-indigo-100">
          احمِ ما هو مهم مع أوكتونيكس إنوفيشنز — شريكك الموثوق في الكويت
          لأنظمة <strong>المراقبة والتحكم بالذكاء الاصطناعي.</strong>
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          احجز استشارة أمنية →
        </a>
      </div>
    </section>

    <FooterAr year={currentYear} />
  </body>
</html>