---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "تطوير أنظمة ERP مخصصة في الكويت",
  subtitle:
    "نصمم أنظمة ERP مخصصة بالكامل لتناسب طبيعة عملك — وليس العكس.",
  image: "/images/custom-erp-kuwait.jpg",
  keywords: [
    "تطوير ERP مخصص الكويت",
    "نظام ERP الكويت",
    "برامج إدارة الأعمال الكويت",
    "ERP بالذكاء الاصطناعي الكويت",
    "أوكتونيكس ERP مخصص",
    "برمجيات المؤسسات الكويت",
    "أنظمة ERP للشركات في الكويت",
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | أوكتونيكس إنوفيشنز الكويت</title>
    <meta
      name="description"
      content="تقدم أوكتونيكس إنوفيشنز خدمات تطوير أنظمة ERP مخصصة بالكامل في الكويت — مصممة لإدارة المالية، الموارد البشرية، التصنيع، واللوجستيات باستخدام تقنيات الذكاء الاصطناعي والأتمتة."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta property="og:image" content={service.image} />
    <meta
      property="og:description"
      content="تطوير أنظمة ERP مخصصة في الكويت — تصميم وأتمتة وتكامل متكامل ليتناسب مع سير عمل مؤسستك بدقة عالية."
    />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Custom ERP Development Arabic",
        description:
          "تطوير وتصميم نظام ERP مخصص للشركات في الكويت باستخدام الذكاء الاصطناعي والأتمتة.",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        areaServed: "Kuwait",
      })}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- الهيدر -->
    <Header />

    <!-- البانر الرئيسي -->
    <section
      id="hero"
      class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          تطوير أنظمة ERP مخصصة
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          عندما لا يناسبك نظام ERP الجاهز — نحن نصمم النظام الذي <strong>يفكر</strong> مثل عملك تمامًا.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
          >اطلب عرض توضيحي مجاني ←</a
        >
      </div>
    </section>

    <!-- لماذا ERP مخصص -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <div class="text-center">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
          لماذا تختار نظام ERP مخصص؟
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-slate-600">
          يمنحك النظام المخصص <strong>تحكمًا كاملاً</strong> و<strong>قابلية للتوسع</strong> و<strong>دقة تشغيلية</strong> — مصمم خصيصًا لتدفق عملك وليس قالبًا عامًا.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["وحدات مخصصة", "كل ميزة وتقرير ولوحة تحكم تُبنى لتناسب احتياجات إدارتك بدقة."],
          ["تكامل سلس", "ربط المالية والموارد البشرية وCRM والإنتاج في نظام واحد ذكي."],
          ["رؤى مدعومة بالذكاء الاصطناعي", "تحليلات تنبؤية وتنبيهات أداء لاتخاذ قرارات أكثر ذكاءً."],
          ["سحابي أو داخلي", "يمكن استضافته على بنيتك التحتية أو على سحابة أوكتونيكس الآمنة بالكويت."],
          ["هيكل قابل للتوسع", "مصمم للنمو مع مؤسستك واستراتيجيتك المستقبلية."],
          ["واجهة ثنائية اللغة", "واجهة عربية وإنجليزية بدعم كامل للاتجاه من اليمين إلى اليسار."],
        ].map(([title, desc]) => (
          <div
            class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300"
          >
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- وحدات النظام بالتفصيل -->
    <section class="bg-white py-24 border-y border-slate-100 text-right">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">وحدات ERP شاملة للمؤسسات الكويتية</h2>
          <p class="mt-4 text-slate-600">تغطي حلولنا المخصصة كل جانب من جوانب العمليات التجارية الحديثة في الكويت.</p>
        </div>
        
        <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-blue-100 rounded-2xl flex items-center justify-center text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h4 class="text-xl font-bold">الإدارة المالية</h4>
            <p class="text-slate-600 text-sm">محاسبة متقدمة، دعم العملات المتعددة، فوترة تلقائية، وتقارير مالية فورية متوافقة مع معايير التدقيق الكويتية.</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center text-green-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </div>
            <h4 class="text-xl font-bold">الموارد البشرية (HRMS)</h4>
            <p class="text-slate-600 text-sm">كشوف رواتب متوافقة مع قانون العمل الكويتي، تتبع الإقامات، إدارة الإجازات، وبوابات أداء الموظفين.</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
            </div>
            <h4 class="text-xl font-bold">سلاسل الإمداد والمخازن</h4>
            <p class="text-slate-600 text-sm">إدارة المستودعات في مواقع متعددة في الكويت، تتبع المخزون في الوقت الفعلي، ومنطق الشراء التلقائي.</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-orange-100 rounded-2xl flex items-center justify-center text-orange-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            </div>
            <h4 class="text-xl font-bold">CRM وأتمتة المبيعات</h4>
            <p class="text-slate-600 text-sm">تتبع العملاء المحتملين، ملفات العملاء، إدارة قنوات المبيعات، والتكامل مع بوابات الدفع المحلية مثل K-NET.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- الصناعات التي نخدمها -->
    <section class="py-24 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">لمن نصمم: قطاعات متخصصة في الكويت</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {["التجزئة والتجارة الإلكترونية", "الإنشاءات والهندسة", "خدمات النفط والغاز", "اللوجستيات والنقل", "المرافق الصحية", "التجارة والتوزيع", "إدارة العقارات", "التعليم والمدارس"].map(industry => (
            <span class="px-6 py-2 bg-white rounded-full border border-slate-200 text-slate-700 shadow-sm hover:border-blue-500 hover:text-blue-600 transition-colors cursor-default">
              {industry}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- قسم الامتثال المحلي -->
    <section class="py-24 bg-white overflow-hidden relative text-right">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1">
             <div class="p-8 bg-blue-600 rounded-[2.5rem] text-white shadow-2xl transform rotate-2">
                <h3 class="text-2xl font-bold mb-6">موطن بالكامل للكويت</h3>
                <ul class="space-y-4 text-blue-100">
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-blue-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>قانون العمل الكويتي:</strong> حساب تلقائي لمكافأة نهاية الخدمة، الإجازات السنوية، والتأمينات الاجتماعية.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-blue-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>دعم ثنائي اللغة:</strong> التبديل بسلاسة بين الواجهات العربية والإنجليزية.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-blue-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>تكامل البنوك المحلية:</strong> اتصال مباشر مع البنوك الكويتية للتسويات الآلية.</span>
                  </li>
                </ul>
             </div>
          </div>
          <div class="order-1 lg:order-2 text-right">
            <h2 class="text-4xl font-bold text-slate-900 mb-6 leading-tight">بني بمعايير عالمية، وخبرة محلية.</h2>
            <p class="text-slate-600 text-lg mb-8">يتطلب تنفيذ نظام ERP في الكويت أكثر من مجرد كود. يتطلب فهمًا لثقافة الأعمال المحلية والمتطلبات القانونية والفوارق التشغيلية.</p>
            <div class="flex gap-4">
                <div class="px-4 py-2 bg-slate-100 rounded-lg text-slate-700 font-semibold text-sm">جاهز لضريبة القيمة المضافة</div>
                <div class="px-4 py-2 bg-slate-100 rounded-lg text-slate-700 font-semibold text-sm">متوافق مع ISO</div>
                <div class="px-4 py-2 bg-slate-100 rounded-lg text-slate-700 font-semibold text-sm">متوافق مع GDPR</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- عملية التطوير -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-24 text-white text-center" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <h3 class="text-3xl font-bold sm:text-4xl">عملية تطوير نظام ERP</h3>
        <p class="mt-3 max-w-2xl mx-auto text-indigo-100">
          منهجية شفافة ومرنة وتعاونية — لضمان نظام يتناسب تمامًا مع متطلبات عملك.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-4 text-center">
          {[
            ["التحليل", "نقوم بتحليل سير العمل والأهداف والمشكلات التشغيلية."],
            ["التصميم", "نصمم الواجهة وتجربة المستخدم وهيكل قاعدة البيانات."],
            ["البرمجة", "تطوير مرن بخطوات متكررة واختبارات مستمرة."],
            ["الإطلاق", "تنفيذ سلس، تدريب المستخدمين، ودعم مستمر."],
          ].map(([step, desc]) => (
            <div class="rounded-3xl bg-white/10 p-6 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold text-white">{step}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- الذكاء الاصطناعي -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            نظام ERP أكثر ذكاءً بالذكاء الاصطناعي
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            أنظمتنا تدمج <strong>الأتمتة المدعومة بالذكاء الاصطناعي</strong> لتقديم موافقات ذكية، تنبيهات فورية، وتحليلات تنبؤية دقيقة.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>🤖 إدخال بيانات تلقائي ومطابقة الحسابات</li>
            <li>📊 تحليلات تنبؤية للمبيعات والمشتريات</li>
            <li>🧠 روبوت محادثة ذكي للتحكم الفوري داخل النظام</li>
            <li>🔔 اكتشاف تلقائي للأخطاء والتنبيهات</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/ai-dashboard.jpg"
            alt="لوحة تحكم ERP مدعومة بالذكاء الاصطناعي"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- قسم الأسئلة الشائعة -->
    <section class="py-24 bg-slate-50 text-right" dir="rtl">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-slate-900 text-center mb-12">تطوير ERP المخصص: الأسئلة الشائعة</h2>
        <div class="space-y-6">
          <details class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none uppercase tracking-tight">
              <span>لماذا أختار ERP مخصص بدلاً من Odoo أو SAP في الكويت؟</span>
              <span class="transition group-open:rotate-180"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">بينما تقدم المنصات الشهيرة ميزات عامة، غالبًا ما يكون للشركات في الكويت سير عمل فريد، واحتياجات خاصة بقانون العمل المحلي، وتكاملات محددة مع K-NET/البنوك التي لا تستطيع الأنظمة الجاهزة التعامل معها دون تخصيصات مكلفة ومعقدة. أنظمتنا المخصصة تُبنى لتكون رشيقة وسريعة ومناسبة تمامًا لاحتياجاتك.</p>
          </details>
          <details class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none uppercase tracking-tight">
              <span>كم من الوقت يستغرق بناء نظام ERP مخصص؟</span>
              <span class="transition group-open:rotate-180"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">يستغرق نظام ERP الأساسي مع الوحدات الجوهرية (المالية، الموارد البشرية) عادةً من 3 إلى 4 أشهر. الأنظمة الأكثر تعقيدًا التي تشمل وحدات المخزون والإنتاج تستغرق من 6 إلى 12 شهرًا. نستخدم نهجًا مرنًا، مما يعني أنك ترى وتستخدم الميزات أثناء بنائها.</p>
          </details>
          <details class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none uppercase tracking-tight">
              <span>هل بياناتنا آمنة ومستضافة في الكويت؟</span>
              <span class="transition group-open:rotate-180"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">نعم. نحن نقدم حلولاً داخلية (استضافة على خوادمك في الكويت) وحلول سحابية هجينة مع نسخ احتياطي مشفر للبيانات. نعطي الأولوية لإقامة البيانات وخصوصيتها وفقًا لمعايير الأعمال الكويتية.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- دعوة للتواصل -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-4xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">ابنِ نظام ERP الذكي الخاص بك</h3>
        <p class="mt-3 text-indigo-100">
          دعنا نصمم نظامًا يفكر مثل عملك — أسرع، أذكى، ومصمم خصيصًا لك.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
