---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const page = {
  title:
    "تحليلات البيانات وأدوات الذكاء الاصطناعي في الكويت | ذكاء الأعمال ولوحات التحكم والتحليلات التنبؤية | أوكتونيكس إنوفيشنز",
  description:
    "تساعد أوكتونيكس إنوفيشنز الشركات الكويتية على تحويل بياناتها إلى قرارات ذكية من خلال لوحات تحكم مدعومة بالذكاء الاصطناعي وتحليلات تنبؤية وأتمتة للأعمال. من بيانات ERP إلى التنبؤات الذكية — نجعل بياناتك تفكر.",
  image: "/images/data-analytics-hero.jpg",
  keywords: [
    "تحليل البيانات الكويت",
    "الذكاء الاصطناعي الكويت",
    "ذكاء الأعمال الكويت",
    "التحليلات التنبؤية الكويت",
    "تعلم الآلة الكويت",
    "تحليل ERP الكويت",
    "برامج الذكاء الاصطناعي الكويت",
    "لوحات بيانات الكويت",
    "أوكتونيكس إنوفيشنز",
    "علوم البيانات الكويت",
    "تحليل الأعمال الكويت",
    "رؤى الأعمال الكويت",
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="keywords" content={page.keywords.join(", ")} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={page.image} />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- الهيدر -->
    <Header />

    <!-- البانر الرئيسي -->
    <section class="relative flex min-h-[90vh] flex-col items-center justify-center text-center text-white overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <img src={page.image} alt="تحليل البيانات في الكويت" loading="lazy" class="w-full h-full object-cover opacity-80" />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sky-400/25 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/25 blur-3xl"></div>

      <div class="relative z-10 px-4 max-w-4xl mx-auto" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-6xl">
          تحليلات البيانات وأدوات الذكاء الاصطناعي في الكويت
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          حوّل بيانات عملك إلى قرارات قابلة للتنفيذ.  
          من <strong>لوحات التحكم اللحظية</strong> إلى <strong>التنبؤات الذكية</strong>،  
          تقدم أوكتونيكس حلول تحليل بيانات متكاملة مصممة خصيصًا للمؤسسات الكويتية.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          اطلب عرض توضيحي مجاني ←
        </a>
      </div>
    </section>

    <!-- المقدمة -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            تمكين الشركات الكويتية بالذكاء الاصطناعي
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            في عالم يعتمد على البيانات، لم تعد القرارات الحدسية كافية.  
            في <strong>أوكتونيكس إنوفيشنز</strong> نساعد المؤسسات في الكويت على استكشاف  
            إمكانيات <strong>تحليل البيانات بالذكاء الاصطناعي</strong> و<strong>التحليلات التنبؤية</strong>  
            و<strong>لوحات التحكم الذكية</strong>.
          </p>
          <p class="mt-4 text-slate-600">
            سواء كانت بياناتك من أنظمة ERP أو CRM أو إنترنت الأشياء،  
            نقوم بتوحيدها في منصة واحدة تكشف الفرص، تتنبأ بالنتائج، وتحسّن العمليات.
          </p>
        </div>
        <figure>
          <img src="/images/ai-dashboard.jpg" alt="لوحة تحكم ذكاء اصطناعي" loading="lazy"
               class="rounded-3xl shadow-2xl ring-1 ring-slate-200" />
          <figcaption class="mt-2 text-xs text-slate-500 text-center">
            لوحة تحكم تحليل بيانات فورية مصممة للمؤسسات الكويتية.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- القدرات التحليلية -->
    <section class="bg-gradient-to-r from-indigo-700 to-sky-700 py-24 text-white" data-animate>
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">قدراتنا في التحليلات</h3>
        <p class="mt-3 text-indigo-100 max-w-2xl mx-auto">
          مصممة لتحويل الأعمال — مدعومة بالذكاء الاصطناعي والأتمتة والرؤى القابلة للتنفيذ.
        </p>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            ["لوحات ذكاء الأعمال", "لوحات تفاعلية باستخدام Power BI أو Looker Studio أو حلول أوكتونيكس المخصصة."],
            ["التحليلات التنبؤية", "نماذج تعلم آلي تتنبأ بالمبيعات والمخاطر وتتكيف مع سوق الكويت."],
            ["الأتمتة الذكية", "أنظمة ذكية لاكتشاف الأخطاء وتحسين الأداء وتشغيل العمليات تلقائيًا."],
            ["تكامل ERP وCRM", "ربط أنظمة مثل Odoo وSAP وOracle لتوفير رؤية موحدة في الوقت الفعلي."],
            ["تقارير بلغة طبيعية", "اطرح سؤالك بالعربية أو الإنجليزية واحصل على نتائج فورية من واجهات الذكاء الاصطناعي."],
            ["نشر سحابي أو داخلي", "تشغيل آمن عبر AWS أو Azure أو مراكز بياناتك داخل الكويت."],
          ].map(([t, d]) => (
            <article class="rounded-3xl bg-white/10 p-8 backdrop-blur-md ring-1 ring-white/10 transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold mb-2">{t}</h4>
              <p class="text-sm text-indigo-100">{d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- الحلول -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <h3 class="text-3xl font-bold text-slate-900 sm:text-4xl text-center">حلول البيانات المدعومة بالذكاء الاصطناعي</h3>
      <p class="mx-auto mt-3 max-w-3xl text-center text-slate-600">
        حلول تحليلية مرنة وقابلة للتوسع تخدم أبرز القطاعات في الكويت —  
        من الصناعة إلى تجارة التجزئة.
      </p>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          ["تحليل العمليات التشغيلية", "مراقبة الإنتاج والتوقف ومؤشرات الأداء باستخدام الذكاء الاصطناعي."],
          ["الذكاء المالي", "تحليل الأرباح والتكاليف والتدفقات النقدية تلقائيًا."],
          ["تحليلات العملاء والتسويق", "تقسيم الجمهور وتحسين العائد من خلال نماذج تعلم الآلة."],
          ["تحسين سلسلة الإمداد", "التنبؤ بالطلب وتتبع اللوجستيات وتحسين المسارات."],
          ["تحليلات الموارد البشرية", "التنبؤ بالاستقالات وقياس الأداء وتخطيط القوى العاملة."],
          ["الطاقة والاستدامة", "مراقبة ذكية لاستهلاك الطاقة ومؤشرات ESG."],
        ].map(([t, d]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 hover:-translate-y-1 hover:shadow-2xl transition">
            <h4 class="text-lg font-semibold text-indigo-700">{t}</h4>
            <p class="mt-2 text-sm text-slate-600">{d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- التقنيات المستخدمة -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <h4 class="text-center text-sm font-semibold tracking-wider text-slate-500">التقنيات التي نستخدمها</h4>
      <div class="relative mt-6 overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200">
        <div class="no-scrollbar flex gap-12 whitespace-nowrap py-6 [animation:marquee_30s_linear_infinite] hover:[animation-play-state:paused]">
          {[
            "/images/brands/python.svg",
            "/images/brands/powerbi.svg",
            "/images/brands/odoo.svg",
            "/images/brands/azure.svg",
            "/images/brands/aws.svg",
            "/images/brands/looker.svg",
            "/images/brands/mysql.svg",
            "/images/brands/postgresql.svg",
            "/images/brands/knime.svg",
          ].map(src => (
            <img src={src} alt="Brand" loading="lazy" class="mx-8 inline-block h-10 w-auto opacity-70 hover:opacity-100 transition" />
          ))}
        </div>
      </div>
    </section>

    <!-- لماذا أوكتونيكس -->
    <section class="bg-gradient-to-br from-slate-900 via-indigo-900 to-sky-900 py-24 text-white" data-animate>
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">لماذا تختار أوكتونيكس في مجال الذكاء والتحليلات</h3>
        <p class="mt-4 text-indigo-100 max-w-3xl mx-auto">
          تثق الشركات الكويتية في أوكتونيكس إنوفيشنز لبناء بنية تحتية تحليلية آمنة، قابلة للتوسع وذكية.
        </p>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 text-right">
          {[
            ["خبرة متكاملة", "من تكامل البيانات إلى عرض النتائج — ندير دورة التحليل كاملة."],
            ["رؤى ERP الذكية", "تكامل خاص مع نظام ERP من أوكتونيكس للتحليل التنبؤي للأعمال."],
            ["مرونة في الاستضافة", "بياناتك تحت سيطرتك — محليًا أو عبر مزودي السحابة العالمية."],
            ["التعريب الكامل", "لوحات تحكم عربية وإنجليزية مع منطق مالي خليجي."],
            ["الامتثال والمعايير", "وفق GDPR وISO 27001 وأفضل ممارسات حوكمة البيانات."],
            ["التدريب والدعم", "ورش عمل عملية لتمكين فريقك من فهم التحليلات بعمق."],
          ].map(([t, d]) => (
            <div class="rounded-3xl bg-white/10 p-8 backdrop-blur-md ring-1 ring-white/10 hover:bg-white/20 transition">
              <h4 class="text-xl font-semibold mb-2">{t}</h4>
              <p class="text-sm text-indigo-100">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- دعوة للتواصل -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-4xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">حوّل بياناتك إلى قرارات ذكية</h3>
        <p class="mt-3 text-indigo-100 max-w-2xl mx-auto">
          دعنا نبني معًا أقوى منظومة تحليلات مدعومة بالذكاء الاصطناعي في الكويت —  
          حيث تتنبأ بياناتك وتتحكم وتطور أعمالك.
        </p>
        <a href="/ar/contact"
           class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg hover:scale-105 transition">
          احجز استشارة تحليلية مجانية ←
        </a>
      </div>
    </section>

    <!-- الفوتر -->
    <FooterAr year={currentYear} />

    <!-- شارة عائمة -->


    <script is:inline>
      const badge = document.getElementById("aiBadge");
      window.addEventListener("scroll", () => {
        const showAt = 200;
        if (window.scrollY > showAt) {
          badge.style.opacity = "1";
          badge.style.transform = "translateX(0)";
        } else {
          badge.style.opacity = "0";
          badge.style.transform = "translateX(-20px)";
        }
      });
    </script>

    <style>
      .no-scrollbar::-webkit-scrollbar { display: none; }
      @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    </style>
  </body>
</html>