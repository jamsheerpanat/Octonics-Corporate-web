---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const brands = [
  "/images/brands/cisco.png",
  "/images/brands/hpe.png",
  "/images/brands/dell.png",
  "/images/brands/fortinet.png",
  "/images/brands/paloalto.png",
  "/images/brands/ubiquiti.png",
  "/images/brands/mikrotik.png",
];

const solutions = [
  {
    title: "شبكات المؤسسات (LAN) والبنى التحتية الداخلية",
    desc: "حلول متقدمة من الطبقة الثانية والثالثة باستخدام Cisco وHPE Aruba وDell — تشمل إدارة طاقة PoE وكابلات هيكلية عالية الموثوقية.",
    icon: `<svg xmlns='http://www.w3.org/2000/svg' class='h-7 w-7' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 12l2-2m0 0l7-7 7 7M13 5v6h6m-6 8h6m2 0a2 2 0 01-2 2H5a2 2 0 01-2-2v-4a2 2 0 012-2h16a2 2 0 012 2v4z' /></svg>`,
    color: "from-sky-500 to-indigo-600",
  },
  {
    title: "تصميم ونشر شبكات Wi-Fi 6/6E",
    desc: "تخطيط ترددي متقدم، وتحسين التغطية، وحلول بوابات دخول (Captive Portal) مصممة لبيئات الكويت التجارية المكتظة.",
    icon: `<svg xmlns='http://www.w3.org/2000/svg' class='h-7 w-7' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8.5 16.5a6 6 0 017 0M6 13a10 10 0 0112 0M3 9a14 14 0 0118 0' /></svg>`,
    color: "from-teal-500 to-sky-500",
  },
  {
    title: "بنية مراكز البيانات",
    desc: "خزائن، تبريد، خوادم، افتراضية، تخزين SAN/NAS، ومواقع التعافي من الكوارث — محسّنة للموثوقية والاستمرارية.",
    icon: `<svg xmlns='http://www.w3.org/2000/svg' class='h-7 w-7' fill='none' viewBox='0 0 24 24' stroke='currentColor'><rect x='4' y='4' width='16' height='16' rx='2' /><path d='M8 8h8M8 12h8M8 16h8' /></svg>`,
    color: "from-indigo-600 to-purple-600",
  },
  {
    title: "الربط السحابي وSD-WAN",
    desc: "تصميم شبكات SD-WAN آمنة تدمج MPLS والإنترنت و5G مع توجيه ذكي يعتمد على التطبيقات.",
    icon: `<svg xmlns='http://www.w3.org/2000/svg' class='h-7 w-7' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3 15a4 4 0 004 4h10a4 4 0 004-4 4 4 0 00-4-4h-1a4 4 0 00-8 0H7a4 4 0 00-4 4z' /></svg>`,
    color: "from-blue-500 to-indigo-500",
  },
  {
    title: "الأمن الشبكي المتقدم ونموذج الثقة الصفرية",
    desc: "جدران حماية، أنظمة EDR/XDR، ونماذج ثقة صفرية لحماية المكاتب الهجينة والبيئات الموزعة.",
    icon: `<svg xmlns='http://www.w3.org/2000/svg' class='h-7 w-7' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' /></svg>`,
    color: "from-rose-500 to-pink-600",
  },
  {
    title: "إدارة تقنية المعلومات والمراقبة المستمرة",
    desc: "مركز عمليات شبكي (NOC) على مدار الساعة مع تنبيهات استباقية وإدارة تصحيحات ودعم وفق اتفاقيات SLA.",
    icon: `<svg xmlns='http://www.w3.org/2000/svg' class='h-7 w-7' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4l3 3m-6 0a9 9 0 1118 0 9 9 0 01-18 0z' /></svg>`,
    color: "from-indigo-500 to-sky-600",
  },
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>البنية التحتية لتقنية المعلومات والشبكات في الكويت | أوكتونيكس إنوفيشنز</title>
    <meta
      name="description"
      content="توفر أوكتونيكس إنوفيشنز حلول البنية التحتية والشبكات والواي فاي ومراكز البيانات وSD-WAN في الكويت باستخدام تقنيات Cisco وHPE وFortinet المعتمدة."
    />
    <meta
      name="keywords"
      content="البنية التحتية IT الكويت, الشبكات الكويت, سيسكو الكويت, فورتينت الكويت, مركز البيانات الكويت, واي فاي الكويت, SD-WAN الكويت, خوادم الكويت, تخزين البيانات الكويت, إدارة تقنية المعلومات الكويت, أمن الشبكات الكويت"
    />
    <meta property="og:title" content="البنية التحتية لتقنية المعلومات والشبكات في الكويت | أوكتونيكس إنوفيشنز" />
    <meta
      property="og:description"
      content="صمم ونفّذ وأدر الجيل الجديد من شبكات المؤسسات والبنية التحتية في الكويت مع مهندسين معتمدين وخبرة محلية."
    />
    <meta property="og:image" content="/images/infra/og-it.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- ===== الهيدر ===== -->
    <Header />

    <!-- ===== البانر الرئيسي ===== -->
    <section id="hero" class="relative isolate min-h-[90vh] flex items-center justify-center text-center overflow-hidden text-white">
      <img src="/images/infra/hero-datacenter.jpg" alt="مركز بيانات الكويت" class="absolute inset-0 h-full w-full object-cover opacity-80" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/85 via-indigo-900/70 to-slate-900/90"></div>
      <div class="absolute -top-20 -right-20 h-60 w-60 bg-sky-400/25 blur-3xl rounded-full"></div>
      <div class="absolute -bottom-20 -left-20 h-60 w-60 bg-indigo-500/25 blur-3xl rounded-full"></div>

      <div class="relative z-10 px-4 sm:px-6 max-w-4xl" data-animate>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs ring-1 ring-white/20">
          شبكات المؤسسات • مراكز البيانات • Wi-Fi • SD-WAN
        </p>
        <h1 class="mt-5 text-5xl font-extrabold leading-tight sm:text-6xl">
          البنية التحتية لتقنية المعلومات والشبكات في الكويت
        </h1>
        <p class="mt-4 text-indigo-100">
          نقدم بنى تحتية آمنة وعالية الأداء — من الكابلات الهيكلية حتى تصميم مراكز البيانات المتكاملة.
        </p>
        <a href="/ar/contact" class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105">
          اطلب عرضًا فنيًا ←
        </a>
      </div>
    </section>

    <!-- ===== الشركاء التقنيون ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <h4 class="text-center text-xs font-semibold tracking-widest text-slate-500">
        شركاؤنا المعتمدون في التقنية
      </h4>
      <div class="relative mt-6 overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200">
        <div class="flex gap-10 whitespace-nowrap py-6 [animation:marquee_30s_linear_infinite] hover:[animation-play-state:paused]">
          {[...brands, ...brands].map((src) => (
            <img src={src} alt="Brand" loading="lazy" class="mx-8 inline-block h-10 w-auto opacity-70 hover:opacity-100 transition" />
          ))}
        </div>
      </div>
    </section>

    <!-- ===== الحلول ===== -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 text-right" data-animate>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
          حلول متكاملة للبنية التحتية لتقنية المعلومات
        </h2>
        <p class="mt-3 max-w-2xl mx-auto text-slate-600">
          مصممة لتقديم أعلى مستويات الاعتمادية والأداء والأمان للشركات الكويتية الرائدة.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {solutions.map((s) => (
          <div class={`group relative rounded-3xl bg-gradient-to-br ${s.color} p-[1px] shadow-xl hover:shadow-2xl transition hover:-translate-y-1`}>
            <div class="flex flex-col h-full rounded-3xl bg-white p-8 backdrop-blur-md">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-indigo-700 shadow-inner mb-4" set:html={s.icon}></div>
              <h4 class="text-xl font-semibold text-slate-900">{s.title}</h4>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== لماذا أوكتونيكس ===== -->
    <section id="why" class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-animate>
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            لماذا تختار أوكتونيكس الكويت
          </h2>
          <p class="mt-4 text-slate-600">
            نجمع بين أفضل الممارسات العالمية والخبرة المحلية لضمان بنية تحتية مستقرة ومبتكرة تتوافق مع تحديات السوق الكويتي.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li>• مهندسون معتمدون من Cisco وFortinet وHPE</li>
            <li>• خبرة في مراكز البيانات بتصاميم Tier 3+</li>
            <li>• توثيق كامل ودعم وفق اتفاقيات SLA</li>
            <li>• تكامل مع أنظمة الأتمتة والـERP من أوكتونيكس</li>
          </ul>
        </div>
        <figure class="relative">
          <img src="/images/infra/network-cabling.jpg" alt="تركيب شبكة مؤسسية في الكويت" loading="lazy" class="rounded-3xl shadow-2xl ring-1 ring-slate-200" />
          <figcaption class="mt-2 text-xs text-slate-500 text-center">
            تركيب كابلات وهيكل شبكي بمستوى مؤسسي من تنفيذ أوكتونيكس إنوفيشنز.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ===== الدعوة للتواصل ===== -->
    <section class="relative bg-gradient-to-r from-slate-900 to-indigo-950 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold sm:text-4xl">
          ابدأ رحلة تحديث البنية التحتية لديك
        </h2>
        <p class="mt-3 text-slate-300 max-w-2xl mx-auto">
          احصل على تدقيق مجاني للشبكة واقتراح تصميم حديث لمنشأتك في الكويت.
        </p>
        <a href="/ar/contact" class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-slate-900 shadow-lg transition hover:scale-105">
          احجز استشارة فنية ←
        </a>
      </div>
    </section>

    <!-- ===== الفوتر ===== -->
    <FooterAr year={currentYear} />

    <style>
      @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
    </style>
  </body>
</html>