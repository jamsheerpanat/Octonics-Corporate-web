---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const frameworks = [
  "ISO 27001:2022 لأمن المعلومات",
  "إطار عمل NIST للأمن السيبراني",
  "ضوابط SOC 2 Type II و ITGC",
  "اللائحة العامة لحماية البيانات (GDPR) وحماية بيانات الكويت",
  "بنية الثقة الصفرية (Zero-Trust)",
  "استمرارية الأعمال وخطط التعافي من الكوارث (DRP)",
];

const offerings = [
  {
    icon: "🛡️",
    title: "تقييم الأمن السيبراني وتقوية الأنظمة",
    desc: "تقييم شامل للبنية التحتية والأجهزة والتطبيقات لتحديد الثغرات والأخطاء والإعدادات الخاطئة. وفقًا لمعايير NIST وISO 27001.",
  },
  {
    icon: "🔒",
    title: "بنية الثقة الصفرية وأمان الهوية",
    desc: "تصميم نماذج وصول آمنة باستخدام SSO وMFA وتقسيم الشبكات وسياسات أقل صلاحية لحماية الأصول السحابية والمحلية.",
  },
  {
    icon: "📊",
    title: "الحوكمة والمخاطر والامتثال (GRC)",
    desc: "لوحات تحكم مؤتمتة لتتبع السياسات، ورسم خرائط الضوابط، وإدارة التدقيق. تقارير فورية للمعايير المحلية والدولية.",
  },
  {
    icon: "🤖",
    title: "تحليلات التهديدات المدعومة بالذكاء الاصطناعي",
    desc: "كشف السلوكيات غير الطبيعية باستخدام تقنيات UEBA وSIEM والتعلم الآلي.",
  },
  {
    icon: "🧠",
    title: "التوعية والتدريب الأمني",
    desc: "محاكاة هجمات تصيّد، حملات التوعية الرقمية، وورش عمل لسياسات أمن المعلومات للشركات في الكويت.",
  },
  {
    icon: "🌐",
    title: "الاستجابة للحوادث والتحليل الجنائي",
    desc: "خدمة استجابة للحوادث وتحليل جنائي رقمي على مدار الساعة مع توثيق شامل بعد الحادث.",
  },
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>حوكمة تكنولوجيا المعلومات والأمن السيبراني في الكويت | أوكتونيكس إنوفيشنز</title>
    <meta
      name="description"
      content="تقدم أوكتونيكس إنوفيشنز خدمات الأمن السيبراني والحوكمة وإدارة المخاطر والامتثال في الكويت — تشمل تدقيق ISO 27001، بنية الثقة الصفرية، ومراقبة الذكاء الاصطناعي للتهديدات."
    />
    <meta
      name="keywords"
      content="الأمن السيبراني الكويت, حوكمة تكنولوجيا المعلومات الكويت, ISO 27001 الكويت, SOC 2 الكويت, NIST الكويت, Zero Trust الكويت, GRC الكويت, تقييم الثغرات الكويت, الاستجابة للحوادث الكويت"
    />
    <meta property="og:title" content="حوكمة تكنولوجيا المعلومات والأمن السيبراني في الكويت | أوكتونيكس إنوفيشنز" />
    <meta
      property="og:description"
      content="احمِ مؤسستك من خلال خدمات الحوكمة والأمن السيبراني المدعومة بالذكاء الاصطناعي من أوكتونيكس إنوفيشنز في الكويت."
    />
    <meta property="og:image" content="/images/cyber/og-cyber.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "حوكمة تكنولوجيا المعلومات والأمن السيبراني",
        description:
          "تقدم أوكتونيكس إنوفيشنز خدمات الأمن السيبراني والحوكمة وإدارة المخاطر والامتثال في الكويت وفق معايير ISO 27001 وNIST وبنية Zero-Trust.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- ===== الهيدر ===== -->
    <Header />

    <!-- ===== البانر الرئيسي ===== -->
    <section
      id="hero"
      class="relative isolate min-h-[90vh] flex items-center justify-center text-center overflow-hidden text-white"
    >
      <img
        src="/images/cyber/hero-cyber.jpg"
        alt="الأمن السيبراني في الكويت"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/80 via-indigo-950/70 to-slate-900/90"></div>
      <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-sky-400/20 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-indigo-500/20 blur-3xl"></div>

      <div class="relative z-10 max-w-4xl px-4 sm:px-6" data-animate>
        <p
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs ring-1 ring-white/20"
        >
          الأمن السيبراني • الحوكمة • المخاطر • الامتثال
        </p>
        <h1 class="mt-5 text-5xl font-extrabold leading-tight sm:text-6xl">
          حوكمة تكنولوجيا المعلومات والأمن السيبراني في الكويت
        </h1>
        <p class="mt-4 text-indigo-100">
          نبني أنظمة رقمية قوية ومتوافقة باستخدام الحوكمة، بنية الثقة الصفرية، والتحليل الذكي المدعوم بالذكاء الاصطناعي.
        </p>

        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          اطلب تدقيقًا أمنيًا ←
        </a>
      </div>
    </section>

    <!-- ===== الأطر والمعايير ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-center" data-animate>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">الامتثال والمعايير المعتمدة</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        تضمن أوكتونيكس توافق كل مشروع حوكمة مع أفضل الأطر والمعايير الأمنية المحلية والعالمية.
      </p>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
        {frameworks.map((fw) => (
          <div class="rounded-2xl bg-white p-4 text-sm font-semibold text-slate-700 shadow ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg">
            {fw}
          </div>
        ))}
      </div>
    </section>

    <!-- ===== الخدمات ===== -->
    <section id="offerings" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-right" data-animate>
      <h2 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">
        خدمات الأمن السيبراني والحوكمة
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
        من الأطر التنظيمية إلى الرؤية اللحظية لمراكز العمليات الأمنية —  
        نقدم حماية متكاملة ودائمة لمؤسستك.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {offerings.map((o) => (
          <article class="group rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-sky-50 to-indigo-50 text-indigo-600 ring-1 ring-slate-100">{o.icon}</div>
            <h3 class="text-lg font-semibold text-slate-900">{o.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{o.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== التميز في الحوكمة ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">حوكمة تبني الثقة والاستدامة</h2>
          <p class="mt-4 text-slate-600">
            برامج الحوكمة لدينا تتجاوز القوائم الشكلية لتبني المرونة الرقمية الحقيقية —  
            وتزوّد القيادة التنفيذية برؤية واضحة وقابلة للتنفيذ.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li>• سجل مخاطر مؤتمت مع تقييم امتثال مستمر</li>
            <li>• تقارير جاهزة لمجالس الإدارة وفق المتطلبات الكويتية</li>
            <li>• تكامل مع ERP وITSM لتتبع أدلة الضوابط</li>
            <li>• مراقبة سحابية فورية (Azure, AWS, GCP) مع تنبيهات الانحراف عن السياسات</li>
          </ul>
        </div>
        <figure class="relative">
          <img
            src="/images/cyber/governance-dashboard.jpg"
            alt="لوحة تحكم GRC الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-2 text-xs text-slate-500 text-center">
            مثال: لوحة تحكم مؤتمتة لإدارة الحوكمة والمخاطر والامتثال في الوقت الفعلي.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ===== الدعوة للتواصل ===== -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold sm:text-4xl">ابدأ رحلتك نحو الأمن والامتثال</h2>
        <p class="mt-3 max-w-2xl mx-auto text-indigo-100">
          قم بجدولة تقييم حوكمة لتحديد الثغرات والمخاطر ومستوى التوافق التنظيمي في مؤسستك.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          احجز استشارة مجانية ←
        </a>
      </div>
    </section>

    <!-- ===== الفوتر ===== -->
    <FooterAr year={currentYear} />
  </body>
</html>