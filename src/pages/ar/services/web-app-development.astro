---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const page = {
  title:
    "أفضل شركة تطوير مواقع في الكويت | تصميم مواقع احترافي و SEO | أوكتونيكس إنوفيشنز",
  description:
    "ارتقِ بعملك مع أوكتونيكس، الشركة الرائدة في تطوير المواقع في الكويت. متخصصون في بناء مواقع Astro فائقة السرعة، متاجر إلكترونية مع K-NET، تطبيقات ويب مخصصة، واستراتيجيات SEO متقدمة لتصدر نتائج جوجل.",
  image: "/images/web-dev-hero.jpg",
  keywords: [
    "تطوير مواقع الكويت",
    "تصميم مواقع الكويت",
    "أفضل شركة مواقع في الكويت",
    "تحسين محركات البحث الكويت",
    "SEO الكويت",
    "شركة برمجة الكويت",
    "برمجة تطبيقات الكويت",
    "مواقع الكترونية الكويت",
    "تصميم متجر الكتروني الكويت",
    "ربط كي نت",
    "K-NET الكويت",
    "Astro الكويت",
    "Tailwind CSS الكويت",
    "تطبيقات الجوال الكويت",
    "تطوير ويب الكويت",
    "أوكتونيكس إنوفيشنز",
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "كم تكلفة إنشاء موقع إلكتروني في الكويت؟",
      acceptedAnswer: {
        "@type": "Answer",
        text: "تتراوح تكلفة تطوير المواقع في الكويت عادةً من 150 دينار كويتي للمواقع التعريفية البسيطة إلى أكثر من 1,500 دينار كويتي للتطبيقات المخصصة والمتاجر الكبيرة. تعتمد التكلفة على التعقيد والمميزات المطلوبة.",
      },
    },
    {
      "@type": "Question",
      name: "كيف يمكن لموقعي أن يتصدر نتائج بحث جوجل في الكويت؟",
      acceptedAnswer: {
        "@type": "Answer",
        text: "تطلب تصدر النتائج سرعة فائقة للموقع، محتوى ثنائي اللغة (عربي وإنجليزي) عالي الجودة، تحسين الكلمات المفتاحية المحلية، وبنية برمجية متوافقة مع معايير جوجل التقنية مثل Schema Markup.",
      },
    },
    {
      "@type": "Question",
      name: "هل تقومون بربط بوابات الدفع المحلية مثل كي نت (K-NET)؟",
      acceptedAnswer: {
        "@type": "Answer",
        text: "نعم، نحن متخصصون في ربط حلول الدفع الكويتية مثل K-NET و MyFatoorah و Tap لضمان تجربة شراء سلسة لعملائك.",
      },
    },
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="keywords" content={page.keywords.join(", ")} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={page.image} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_KW" />
    <link
      rel="canonical"
      href="https://octonics.com/ar/services/web-app-development"
    />
    <meta name="geo.region" content="KW" />
    <meta name="geo.placename" content="Kuwait City" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- STRUCTURED DATA -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify([
        {
          "@context": "https://schema.org",
          "@type": "Service",
          name: "تطوير المواقع والتطبيقات في الكويت",
          description:
            "حلول تطوير مواقع وتطبيقات جوال متميزة في الكويت. متخصصون في Astro و Next.js وتحسين محركات البحث للحصول على أعلى التصنيفات.",
          areaServed: "Kuwait",
          provider: {
            "@type": "Organization",
            name: "أوكتونيكس إنوفيشنز",
            url: "https://octonics.com",
          },
        },
        faqSchema,
      ])}
    />
  </head>

  <body
    class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative text-right"
  >
    <Header />

    <!-- HERO -->
    <section
      class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={page.image}
          alt="تطوير مواقع احترافي في مدينة الكويت"
          class="h-full w-full object-cover opacity-70"
        />
        <div
          class="absolute inset-0 bg-gradient-to-br from-slate-900/95 via-indigo-900/90 to-sky-900/80"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-5xl px-4">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 text-sm font-bold uppercase tracking-widest mb-6 backdrop-blur-sm"
        >
          الوكالة رقم #1 لتطوير المواقع في الكويت
        </span>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl mb-6">
          تطوير <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-blue-400"
            >مواقع إلكترونية</span
          > متميزة في الكويت
        </h1>
        <p
          class="mt-4 text-xl text-indigo-100 max-w-3xl mx-auto leading-relaxed"
        >
          تصاميم مذهلة تلتقي مع هندسة برمجية عالية الأداء. نبني <strong
            >مواقع تركز على الـ SEO</strong
          > لتتصدر نتائج البحث في الكويت بذكاء.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4 text-center">
          <a
            href="/ar/contact"
            class="px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-700 font-bold text-white shadow-xl shadow-blue-600/20 transition-all hover:scale-105"
          >
            ناقش مشروعك معنا
          </a>
          <a
            href="#solutions"
            class="px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 font-bold text-white backdrop-blur-md border border-white/20 transition-all"
          >
            استعرض حلولنا
          </a>
        </div>
      </div>
    </section>

    <!-- TRUST STATS -->
    <section class="py-12 bg-white border-y border-slate-100">
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-blue-600">100%</div>
            <div class="text-sm text-slate-500 uppercase font-semibold">
              جاهز للـ SEO
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-blue-600">&lt;1 ثانية</div>
            <div class="text-sm text-slate-500 uppercase font-semibold">
              سرعة التحميل
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-blue-600">ثنائي اللغة</div>
            <div class="text-sm text-slate-500 uppercase font-semibold">
              عربي / إنجليزي
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-blue-600">24/7</div>
            <div class="text-sm text-slate-500 uppercase font-semibold">
              دعم فني
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE SERVICES DETAIL -->
    <section id="solutions" class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl mb-4">
          حلول رقمية متكاملة في الكويت
        </h2>
        <p class="max-w-2xl mx-auto text-slate-600 text-lg">
          من المشاريع الصغيرة إلى الشركات الكبرى، نقدم خدمات ويب متخصصة في مدينة
          الكويت وحولي وكافة المناطق.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        <!-- Corp Site -->
        <div
          class="group p-8 rounded-[2rem] bg-white border border-slate-100 shadow-sm hover:shadow-2xl transition-all hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-7 h-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path></svg
            >
          </div>
          <h3 class="text-2xl font-bold mb-4">مواقع الشركات</h3>
          <p class="text-slate-600 mb-6 leading-relaxed text-right">
            أنشئ حضوراً قوياً على الإنترنت بتصميمات واجهة مستخدم متميزة. نجسّد
            جوهر علامتك التجارية مع ضمان أعلى معايير الأداء.
          </p>
          <ul class="text-sm text-slate-500 space-y-2 mb-8 text-right">
            <li>✓ ربط أنظمة إدارة المحتوى المتقدمة</li>
            <li>✓ تصميم متجاوب للهواتف</li>
            <li>✓ أصول بصرية عالية الدقة</li>
          </ul>
        </div>

        <!-- E-com -->
        <div
          class="group p-8 rounded-[2rem] bg-white border border-slate-100 shadow-sm hover:shadow-2xl transition-all hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-green-600 group-hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-7 h-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg
            >
          </div>
          <h3 class="text-2xl font-bold mb-4">المتاجر الإلكترونية</h3>
          <p class="text-slate-600 mb-6 leading-relaxed text-right">
            بع منتجاتك في كافة أنحاء الكويت بمتجر إلكتروني يحقق أعلى مبيعات.
            متكامل مع الخدمات اللوجستية المحلية وسرعة تدعم الـ 5G.
          </p>
          <ul class="text-sm text-slate-500 space-y-2 mb-8 text-right">
            <li>✓ ربط كي نت (K-NET) و Tap</li>
            <li>✓ إدارة المخزون</li>
            <li>✓ ربط شركات الشحن المحلية</li>
          </ul>
        </div>

        <!-- Custom Apps -->
        <div
          class="group p-8 rounded-[2rem] bg-white border border-slate-100 shadow-sm hover:shadow-2xl transition-all hover:-translate-y-2"
        >
          <div
            class="w-14 h-14 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-purple-600 group-hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-7 h-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
            >
          </div>
          <h3 class="text-2xl font-bold mb-4">تطبيقات الويب</h3>
          <p class="text-slate-600 mb-6 leading-relaxed text-right">
            حلول برمجية خلفية معقدة، بوابات عملاء، ولوحات تحكم للمؤسسات. نبني
            أدوات قوية تتوسع مع نمو أعمالك في الكويت.
          </p>
          <ul class="text-sm text-slate-500 space-y-2 mb-8 text-right">
            <li>✓ هندسة React و Next.js</li>
            <li>✓ مزامنة بيانات فورية</li>
            <li>✓ استضافة سحابية آمنة</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SEO STRATEGY SECTION -->
    <section
      class="relative py-24 bg-slate-900 text-white overflow-hidden text-right"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl font-extrabold mb-8">
              تصدر نتائج بحث جوجل في الكويت
            </h2>
            <p class="text-slate-300 text-lg mb-8 leading-relaxed">
              بناء الموقع هو نصف المعركة فقط. الظهور للعملاء هو ما يحقق الأرباح.
              في أوكتونيكس، نحن لا نقوم بالـ SEO فقط—بل نجعله جزءاً لا يتجزأ من
              بنية موقعك.
            </p>

            <div class="space-y-6">
              <div class="flex gap-4">
                <div
                  class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center flex-shrink-0 font-bold"
                >
                  1
                </div>
                <div class="text-right">
                  <h4 class="font-bold text-xl mb-1">إتقان الكلمات المحلية</h4>
                  <p class="text-slate-400">
                    نستهدف العبارات الأكثر بحثاً في السوق الكويتي باللغتين
                    العربية والإنجليزية.
                  </p>
                </div>
              </div>
              <div class="flex gap-4">
                <div
                  class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center flex-shrink-0 font-bold"
                >
                  2
                </div>
                <div class="text-right">
                  <h4 class="font-bold text-xl mb-1">بنية فائقة السرعة</h4>
                  <p class="text-slate-400">
                    تتفوق مواقعنا في اختبارات Core Web Vitals من جوجل بتقييمات
                    95+، مما يمنحك أفضلية كبرى.
                  </p>
                </div>
              </div>
              <div class="flex gap-4">
                <div
                  class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center flex-shrink-0 font-bold"
                >
                  3
                </div>
                <div class="text-right">
                  <h4 class="font-bold text-xl mb-1">
                    التفوق في الـ SEO التقني
                  </h4>
                  <p class="text-slate-400">
                    نستخدم Schema markup متقدم وهيكلة HTML برمجية تفضلها
                    خوارزميات جوجل.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="relative">
            <div
              class="absolute -inset-4 bg-blue-500/20 rounded-[3rem] blur-2xl"
            >
            </div>
            <div
              class="relative bg-slate-800 p-8 rounded-[3rem] border border-slate-700 shadow-2xl"
            >
              <div class="flex items-center gap-2 mb-6">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
              </div>
              <div class="space-y-4 text-right" dir="rtl">
                <div class="h-4 w-3/4 bg-slate-700 rounded"></div>
                <div class="h-4 w-full bg-slate-700 rounded"></div>
                <div
                  class="h-20 w-full bg-blue-600/20 rounded border border-blue-500/30 flex items-center justify-center"
                >
                  <span class="text-blue-400 font-mono text-sm"
                    >تصنيف جوجل: #1 (الكويت)</span
                  >
                </div>
                <div class="h-4 w-1/2 bg-slate-700 rounded"></div>
                <div class="grid grid-cols-3 gap-2">
                  <div class="h-12 bg-slate-700 rounded"></div>
                  <div class="h-12 bg-slate-700 rounded"></div>
                  <div class="h-12 bg-slate-700 rounded"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY STACK -->
    <section class="py-24 bg-white text-center">
      <div class="mx-auto max-w-7xl px-4">
        <h2 class="text-3xl font-bold mb-16">تكنولوجيا عالمية. خبرة محلية.</h2>
        <div
          class="flex flex-wrap justify-center gap-12 opacity-60 grayscale hover:grayscale-0 transition-all duration-500"
        >
          <span class="text-2xl font-black">ASTRO</span>
          <span class="text-2xl font-black">NEXT.JS</span>
          <span class="text-2xl font-black">REACT</span>
          <span class="text-2xl font-black">NODE.JS</span>
          <span class="text-2xl font-black">TAILWIND</span>
          <span class="text-2xl font-black">POSTGRES</span>
        </div>

        <div
          class="mt-20 max-w-4xl mx-auto grid md:grid-cols-2 gap-10 text-right"
        >
          <div class="p-8 bg-slate-50 rounded-3xl">
            <h4 class="font-bold text-xl mb-4">
              لماذا Astro للمواقع الكويتية؟
            </h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              يعتبر Astro السلاح السري للـ SEO. فهو يوفر مواقع خالية من أكواد
              جافا سكريبت غير الضرورية، مما يؤدي لسرعة تحميل فورية على شبكات الـ
              5G في الكويت.
            </p>
          </div>
          <div class="p-8 bg-slate-50 rounded-3xl">
            <h4 class="font-bold text-xl mb-4">البرمجة الخاصة vs ووردبريس</h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              على عكس مواقع ووردبريس التي غالباً ما تكون بطيئة وغير آمنة، حلولنا
              البرمجية المخصصة خفيفة الوزن، آمنة للغاية، ومصممة خصيصاً لتناسب
              متطلبات السوق الكويتي.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-24 bg-slate-50 border-t border-slate-100 text-right">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-slate-900 text-center mb-12">
          تطوير المواقع في الكويت: الأسئلة الشائعة
        </h2>
        <div class="space-y-6">
          <details
            class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200"
          >
            <summary
              class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none"
            >
              <span>ما هو الجدول الزمني المتوسط لإتمام المشروع؟</span>
              <span class="transition group-open:rotate-180"
                ><svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                ></span
              >
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              تستغرق مواقع الشركات البسيطة حوالي أسبوع إلى أسبوعين. المتاجر
              الإلكترونية المعقدة أو تطبيقات الويب المخصصة تستغرق عادةً من 4 إلى
              8 أسابيع.
            </p>
          </details>
          <details
            class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200"
          >
            <summary
              class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none"
            >
              <span
                >هل تدعم المواقع اللغة العربية والواجهات من اليمين لليسار؟</span
              >
              <span class="transition group-open:rotate-180"
                ><svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                ></span
              >
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              بالتأكيد. كل موقع نبنيه للسوق الكويتي يدعم اللغتين بشكل كامل
              وبمحاذاة مثالية من اليمين إلى اليسار (RTL) مع خطوط عربية فائقة
              الجودة.
            </p>
          </details>
          <details
            class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200"
          >
            <summary
