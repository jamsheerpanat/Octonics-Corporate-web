---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const page = {
  title: "تطوير المواقع والتطبيقات في الكويت | مواقع سريعة وحديثة | Octonics Innovations",
  description:
    "تقدم شركة أوكتونيكس إنوفيشنز خدمات تطوير مواقع وتطبيقات ويب حديثة عالية الأداء في الكويت باستخدام Astro وTailwind CSS وأحدث الأطر البرمجية. مواقع فائقة السرعة، محسّنة لمحركات البحث، ومتجاوبة لجميع الأجهزة.",
  image: "/images/web-dev-hero.jpg",
};
---

<html lang="ar" dir="rtl">
  <head>
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta
      name="keywords"
      content="تطوير مواقع الكويت, تصميم مواقع الكويت, تطبيقات الويب الكويت, تطوير تطبيقات الجوال الكويت, Astro الكويت, Tailwind CSS الكويت, مواقع سريعة, تحسين SEO الكويت, Octonics Kuwait"
    />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={page.image} />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "تطوير المواقع والتطبيقات",
        description:
          "تطوير مواقع وتطبيقات ويب حديثة في الكويت باستخدام Astro وTailwind CSS من شركة أوكتونيكس إنوفيشنز — سرعة فائقة وتجربة مستخدم ذكية.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        serviceType: "تطوير مواقع, تطوير تطبيقات, تحسين SEO",
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={page.image}
          alt="تطوير المواقع الحديثة في الكويت"
          loading="lazy"
          class="h-full w-full object-cover opacity-80"
        />
        <div
          class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"
        ></div>
      </div>

      <div class="relative z-10 mx-auto max-w-4xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          تطوير المواقع والتطبيقات الحديثة في الكويت
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          نحن لا نبني مواقع فقط — نحن <strong>نُنشئ تجارب رقمية</strong> فائقة السرعة، محسّنة لمحركات البحث، وتجذب العملاء بذكاء.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          ابنِ موقعك الآن →
        </a>
      </div>
    </section>

    <!-- ABOUT OUR STACK -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 text-right" data-animate dir="rtl">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            مصممة للأداء. مُهندسة للتأثير.
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            في <strong>أوكتونيكس إنوفيشنز</strong>، كل سطر من الكود وكل بكسل مصمم لتحقيق الكمال.
            ندمج سرعة <strong>Astro</strong>، ودقة <strong>Tailwind CSS</strong>، وقوة <strong>Next.js</strong>
            لبناء أنظمة ويب ذكية تُحقق نتائج حقيقية.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• Astro وTailwind لأقصى سرعة وجمال</li>
            <li>• Next.js وReact لتفاعلية عالية وقابلية توسع</li>
            <li>• بنية محسّنة لتحسين نتائج SEO</li>
            <li>• تصميم متعدد اللغات ومتجاوب لجميع الأجهزة</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/web-stack.jpg"
            alt="Astro Tailwind الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- PERFORMANCE HIGHLIGHTS -->
    <section
      class="relative bg-gradient-to-r from-indigo-700 to-sky-700 py-24 text-white"
      data-animate
    >
      <div class="max-w-6xl mx-auto px-4 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">أداء يتحدث عن نفسه</h3>
        <p class="mt-3 text-indigo-100 max-w-2xl mx-auto">
          مواقعنا ليست جميلة فقط — بل تتفوق في الأداء على 99٪ من المواقع حول العالم.
        </p>
        <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-8">
          {[
            ["⚡", "سرعة التحميل", "أقل من ثانية واحدة"],
            ["🚀", "تقييم Lighthouse", "99+ نقطة"],
            ["📈", "أداء SEO", "ضمن أعلى 3 نتائج"],
            ["🔒", "الأمان", "A+ SSL / معايير حماية قوية"],
          ].map(([icon, title, value]) => (
            <div class="flex flex-col items-center rounded-3xl bg-white/10 p-6 backdrop-blur-md ring-1 ring-white/10 transition hover:bg-white/20">
              <div class="text-4xl">{icon}</div>
              <h4 class="mt-2 text-lg font-semibold">{title}</h4>
              <p class="mt-1 text-indigo-100 text-sm">{value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- OUR SOLUTIONS -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 text-right" data-animate dir="rtl">
      <h3 class="text-3xl font-bold text-slate-900 sm:text-4xl text-center">
        حلول ويب وتطبيقات متكاملة
      </h3>
      <p class="mx-auto mt-3 max-w-3xl text-center text-slate-600">
        من مواقع الشركات إلى الأنظمة المؤسسية — نقدم لك نظامًا رقميًا مستقبليًا شاملاً.
      </p>
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          ["مواقع الشركات", "مواقع أنيقة ومحسّنة لمحركات البحث مبنية باستخدام Astro وTailwind."],
          ["تطبيقات ويب تقدمية (PWA)", "تطبيقات ويب تعمل دون اتصال وتُثبت مثل تطبيقات الجوال."],
          ["منصات التجارة الإلكترونية", "متاجر رقمية سريعة متكاملة مع أنظمة الدفع وERP."],
          ["لوحات تحكم مخصصة", "أنظمة تحليل وإدارة بيانات مبنية على React وNode."],
          ["تطوير تطبيقات الجوال", "تطبيقات متعددة الأنظمة باستخدام React Native وFlutter."],
          ["أنظمة إدارة المحتوى (Headless CMS)", "أنظمة مرنة وقابلة للتوسع باستخدام Strapi أو Sanity."],
        ].map(([t, d]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 hover:-translate-y-1 hover:shadow-2xl transition">
            <h4 class="text-lg font-semibold text-indigo-700">{t}</h4>
            <p class="mt-2 text-sm text-slate-600">{d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- DEVELOPMENT PROCESS -->
    <section
      class="relative bg-gradient-to-br from-slate-900 via-indigo-900 to-sky-900 py-24 text-white text-center"
      data-animate
    >
      <div class="mx-auto max-w-6xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">مراحل تطويرنا</h3>
        <p class="mt-3 text-indigo-100 max-w-2xl mx-auto">
          عملية واضحة وفعالة وتعاونية — نضمن لك تجربة تطوير شفافة ومنظمة.
        </p>
        <div
          class="mt-12 flex flex-col md:flex-row justify-center items-start md:items-center gap-10 text-center"
        >
          {[
            ["🧭", "1. التخطيط والتحليل", "فهم الأهداف والجمهور ومؤشرات النجاح."],
            ["🎨", "2. التصميم والنمذجة", "تصميم النماذج والواجهات باستخدام Figma."],
            ["⚙️", "3. التطوير", "برمجة باستخدام Astro وTailwind وReact وNode."],
            ["🚀", "4. النشر", "استضافة مثالية على Vercel أو Netlify أو Hostinger."],
            ["📈", "5. التحسين والنمو", "تحسين الأداء وتحليل النتائج بعد الإطلاق."],
          ].map(([icon, title, desc]) => (
            <div class="flex-1 rounded-3xl bg-white/10 p-6 backdrop-blur-md ring-1 ring-white/10 hover:bg-white/20 transition">
              <div class="text-3xl mb-2">{icon}</div>
              <h4 class="text-lg font-semibold">{title}</h4>
              <p class="mt-1 text-indigo-100 text-sm">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center">
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">لنصنع مستقبل الويب معًا</h3>
        <p class="mt-3 text-indigo-100 max-w-2xl mx-auto">
          عملك يستحق أكثر من موقع — إنه يحتاج إلى <strong>منصة رقمية ذكية</strong> مصممة للسرعة والدقة والتأثير.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg hover:scale-105 transition"
        >
          ابدأ مشروعك الآن →
        </a>
      </div>
    </section>

    <FooterAr year={currentYear} />
  </body>
</html>