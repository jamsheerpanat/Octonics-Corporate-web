---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import TechComparisonAr from "../../../components/TechComparisonAr.astro";
import SystemFlow from "../../../components/SystemFlowAr.astro";
import FooterAr from "../../../components/FooterAr.astro";
import HeaderAr from "../../../components/HeaderAr.astro";

const currentYear = new Date().getFullYear();

const page = {
  title:
    "أنظمة المنازل والمباني الذكية في الكويت | KNX، Zigbee، Wi-Fi، RTI",
  description:
    "أوكتونيكس إنوفيشنز — خبراء الأتمتة الذكية المعتمدون من KNX في الكويت. نقدم أنظمة ذكية سلكية ولاسلكية تشمل KNX، Zigbee، Z-Wave، Wi-Fi، وRTI للمنازل والفيلات والمكاتب والمنشآت التجارية.",
  image: "/images/smart-home-kuwait.jpg",
  keywords: [
    "منزل ذكي الكويت",
    "أتمتة منزلية الكويت",
    "أتمتة KNX الكويت",
    "أتمتة لاسلكية الكويت",
    "Zigbee الكويت",
    "Z-Wave الكويت",
    "Wi-Fi Automation الكويت",
    "RTI Control الكويت",
    "أتمتة مباني الكويت",
    "فيلا ذكية الكويت",
    "إضاءة ذكية الكويت",
    "Octonics Smart Systems الكويت",
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="keywords" content={page.keywords.join(", ")} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={page.image} />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- ===== الهيدر ===== -->
    <HeaderAr />

    <!-- ===== البانر الرئيسي ===== -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={page.image}
          alt={page.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div
          class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"
        ></div>
      </div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          أنظمة الأتمتة الذكية في الكويت
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          اجعل منزلك أو عملك أكثر ذكاءً وراحة مع أنظمة
          <strong>الأتمتة الذكية المدعومة بالذكاء الاصطناعي</strong>. من
          <strong>أنظمة KNX السلكية</strong> إلى <strong>Zigbee وWi-Fi وZ-Wave اللاسلكية</strong> —
          تقدم أوكتونيكس إنوفيشنز حلولاً فاخرة تجمع بين الذكاء والاستقرار.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          احجز استشارة الأتمتة الخاصة بك →
        </a>
      </div>
    </section>

    <!-- ===== حول الأتمتة الذكية ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-right" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            حياة ذكية صُممت في الكويت
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            تقدم أوكتونيكس إنوفيشنز أنظمة أتمتة متقدمة تجمع بين الراحة والكفاءة والأمان. نحن
            <strong>شركاء معتمدون من KNX</strong> ونتبع أرقى المعايير العالمية، كما ندمج أيضًا تقنيات
            <strong>الأتمتة اللاسلكية</strong> لتناسب المشاريع الحديثة والمباني الجاهزة.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• تحكم بالإضاءة والتكييف عبر KNX/DALI</li>
            <li>• أنظمة أمان وكاميرات وتحكم بالأبواب</li>
            <li>• صوت متعدد الغرف وتوزيع فيديو ذكي</li>
            <li>• تحكم صوتي وتطبيقات (Alexa، Google، Siri)</li>
            <li>• واجهات RTI موحدة للتحكم الكامل</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/smart-luxury-villa.jpg"
            alt="منزل ذكي الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-2 text-xs text-slate-500 text-center">
            فيلا فاخرة في الكويت مزودة بأنظمة KNX وDALI للتحكم بالإضاءة والتكييف.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ===== الأتمتة السلكية KNX ===== -->
    <section
      class="relative bg-gradient-to-r from-indigo-700 to-sky-700 py-24 text-white"
      data-animate
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">الأتمتة السلكية KNX</h3>
        <p class="mt-3 max-w-3xl mx-auto text-indigo-100">
          KNX هو النظام الأكثر استقرارًا وموثوقية في العالم لأنظمة الأتمتة الذكية. تم تطويره في
          أوروبا ويستخدمه أكثر من 500 علامة تجارية عالمية، مما يضمن التوافق والاستدامة طويلة الأمد.
        </p>
        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
          {[
            ["الإضاءة والتعتيم", "إضاءة ذكية تعتمد على DALI2 تتحكم في المشاهد وضوء النهار والحركة."],
            ["التحكم بالمناخ والطاقة", "تحكم متطور في التكييف والتدفئة مع خوارزميات لتوفير الطاقة."],
            ["المستشعرات والمنطق", "أتمتة الحياة اليومية باستخدام حساسات الحركة والطقس والإشغال."],
          ].map(([title, desc]) => (
            <div
              class="rounded-3xl bg-white/10 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20"
            >
              <h4 class="text-xl font-semibold">{title}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== الأتمتة اللاسلكية ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-right" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <figure>
          <img
            src="/images/wireless-smart-home.jpg"
            alt="أتمتة لاسلكية الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            الأتمتة اللاسلكية: حرية بدون أسلاك
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            في الفلل والشقق القائمة في الكويت، قد يكون من الصعب إعادة تمديد الأسلاك. لذلك تقدم
            أوكتونيكس حلول <strong>الأتمتة اللاسلكية</strong> باستخدام تقنيات
            <strong>Wi-Fi</strong> و<strong>Zigbee</strong> و<strong>Z-Wave</strong> لتوفير تجربة
            تحكم ذكية بدون أعمال تمديد معقدة.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• مثالية للتجديدات والمباني الجاهزة</li>
            <li>• تحكم عبر التطبيقات أو الأوامر الصوتية</li>
            <li>• توسعة سهلة عبر المستشعرات والمفاتيح الذكية</li>
            <li>• متوافقة مع أنظمة KNX الهجينة</li>
            <li>• مصممة للاستقرار في مناخ الكويت</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== تحكم RTI ===== -->
    <section
      class="relative bg-gradient-to-r from-slate-900 to-indigo-900 py-24 text-white"
      data-animate
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6 grid md:grid-cols-2 items-center gap-12">
        <div>
          <h2 class="text-3xl font-bold sm:text-4xl">تحكم RTI وواجهات العرض</h2>
          <p class="mt-4 text-indigo-100 leading-relaxed">
            RTI (Remote Technologies Inc.) هو الخيار الأفضل لتجربة عرض وتحكم متكاملة. يقوم مهندسو
            أوكتونيكس بتصميم واجهات RTI مخصصة توحد جميع أنظمة المنزل الذكي في لوحة واحدة أنيقة —
            الإضاءة، التكييف، الصوت، الأمان والمزيد.
          </p>
          <ul class="mt-6 space-y-3 text-indigo-100">
            <li>• تحكم موحد في KNX، الصوت، الفيديو، والأمان</li>
            <li>• واجهات RTI مخصصة لأجهزة iPad أو الشاشات الجدارية</li>
            <li>• تكامل مع Sonos وCasaTunes وSpotify وApple Music</li>
            <li>• تبديل الفيديو لغرف السينما والمجالس</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/rti-interface.jpg"
            alt="تحكم RTI الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-700"
          />
        </figure>
      </div>
    </section>

    <!-- ===== مقارنة التقنية ===== -->
    <div class="bg-slate-50">
      <TechComparisonAr />
    </div>

    <!-- ===== مخطط النظام ===== -->
    <div class="bg-white">
      <SystemFlow />
    </div>

    <!-- ===== المميزات ===== -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 text-right" data-animate>
      <h3 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">
        لماذا تختار أوكتونيكس لأنظمة الأتمتة الذكية
      </h3>
      <p class="mx-auto mt-4 max-w-2xl text-center text-slate-600">
        النظام الجيد يبدأ بالخبرة الصحيحة. تجمع أوكتونيكس بين الهندسة المعتمدة والمنتجات العالمية
        والخبرة التقنية لتقديم نظام أتمتة متكامل وموثوق.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {[
          ["خبرة معتمدة", "مهندسون معتمدون من KNX متخصصون في تصميم الأنظمة السلكية واللاسلكية."],
          ["علامات تجارية عالمية", "شراكات مع Theben وJung وRTI وCasaTunes وغيرها من القادة العالميين."],
          ["دعم محلي", "مقرنا في الكويت مع فرق تنفيذ وصيانة محلية متخصصة."],
        ].map(([title, desc]) => (
          <div
            class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl"
          >
            <h4 class="text-xl font-semibold text-indigo-700">{title}</h4>
            <p class="mt-2 text-slate-600 text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== الدعوة للتواصل ===== -->
    <section
      class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center"
    >
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">
          لنبنِ معًا أذكى المنازل في الكويت
        </h3>
        <p class="mt-3 text-indigo-100">
          جرب الأتمتة الذكية التي تجمع بين الاستقرار والذكاء والراحة. سواء كنت تبحث عن نظام KNX
          سلكي للفيلات أو Zigbee لاسلكي للمكاتب — أوكتونيكس تقدم لك تجربة
          <strong>“ركّب وانسَ”</strong> الموثوقة.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          احجز استشارتك المجانية →
        </a>
      </div>
    </section>

    <!-- ===== الفوتر ===== -->
    <FooterAr year={currentYear} />
  </body>
</html>