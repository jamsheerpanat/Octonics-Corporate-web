---
import "../../../styles/global.css";
import Header from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "أنظمة ERP وبرامج إدارة الأعمال في الكويت",
  subtitle:
    "تقدّم أوكتونيكس إنوفيشنز أنظمة ERP ذكية ومرنة مصممة خصيصًا لمؤسسات الكويت الحديثة — تجمع بين الذكاء الاصطناعي والأتمتة والفهم العميق للأعمال.",
  image: "/images/erp-hero.jpg",
  keywords: [
    "ERP الكويت",
    "تخصيص Odoo ERP الكويت",
    "برامج إدارة الأعمال الكويت",
    "نظام ERP بالذكاء الاصطناعي",
    "تطوير ERP مخصص الكويت",
    "أوكتونيكس إنوفيشنز ERP",
    "مانتر ERP الكويت",
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | أوكتونيكس إنوفيشنز الكويت</title>
    <meta
      name="description"
      content="تقدم أوكتونيكس إنوفيشنز حلول ERP وأنظمة إدارة أعمال في الكويت — تشمل تخصيص Odoo، تطوير ERP مخصص، ونظامنا الذكي مانتر ERP المدعوم بالذكاء الاصطناعي."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta
      property="og:description"
      content="حوّل أعمالك مع حلول ERP من أوكتونيكس — مصممة خصيصًا لتناسب متطلبات السوق الكويتي."
    />
    <meta property="og:image" content={service.image} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "ERP & Business Software Arabic",
        description:
          "تخصيص Odoo ERP، تطوير ERP مخصص، ونظام مانتر ERP الذكي في الكويت.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- الهيدر -->
    <Header />

    <!-- البانر الرئيسي -->
    <section
      id="hero"
      class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          أنظمة ERP وبرامج إدارة الأعمال
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          <strong>حلول ERP مدعومة بالذكاء الاصطناعي</strong> مصممة لجيل جديد من الأعمال في الكويت — مرنة، قابلة للتخصيص، وقابلة للتوسع.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          تحدث مع خبير ERP ←
        </a>
      </div>
    </section>

    <!-- المميزات -->
    <section id="erp-features" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <h2 class="text-center text-4xl font-extrabold text-slate-900 sm:text-5xl">
        ذكي. قابل للتوسع. متكامل.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
        أنظمة ERP من أوكتونيكس تغيّر طريقة إدارة البيانات والأشخاص والأداء في مؤسستك.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["لوحات تحكم فورية", "احصل على رؤية فورية لمؤشرات الأداء والمبيعات والمالية — في أي وقت ومن أي مكان."],
          ["أتمتة مدمجة", "قم بأتمتة المهام المتكررة لتقليل الأخطاء وتحسين الكفاءة."],
          ["رؤى بالذكاء الاصطناعي", "تنبؤات دقيقة واكتشاف أوجه القصور وتحسين قرارات الأعمال."],
          ["تشغيل سحابي أو داخلي", "اختر بين استضافة محلية في الكويت أو عبر مزودي السحابة العالمية."],
          ["تصميم مرن", "ابدأ بما تحتاجه فقط، وأضف المزيد مع نمو أعمالك."],
          ["متعدد اللغات والعملات", "مصمم ليناسب تنوع السوق الكويتي والعالمي."],
        ].map(([title, desc]) => (
          <div class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300">
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- الخدمات الفرعية -->
    <section id="subservices" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <div class="grid gap-16 md:grid-cols-3">
        {[
          {
            href: "/ar/services/odoo-erp-customization",
            img: "/images/odoo-custom.png",
            title: "تخصيص Odoo ERP",
            desc:
              "نقوم بتخصيص وتنفيذ نظام Odoo ERP لإدارة المحاسبة والمخزون والموارد البشرية وCRM — مع تعريب كامل للسوق الكويتي.",
            color: "sky",
          },
          {
            href: "/ar/services/custom-erp-development",
            img: "/images/custom-erp.png",
            title: "تطوير ERP مخصص",
            desc:
              "نصمم أنظمة ERP مخصصة تتماشى تمامًا مع سير عملك وتكاملاتك التشغيلية.",
            color: "indigo",
          },
          {
            href: "/ar/services/manter-erp",
            img: "/images/manter-erp.png",
            title: "مانتر ERP (من أوكتونيكس)",
            desc:
              "نظامنا الخاص المدعوم بالذكاء الاصطناعي يجمع بين التحليلات التنبؤية والأتمتة والذكاء المؤسسي المتقدم.",
            color: "slate",
          },
        ].map((s) => (
          <a
            href={s.href}
            class={`group block rounded-3xl bg-gradient-to-br from-white to-${s.color}-50 p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-2 hover:shadow-2xl hover:ring-${s.color}-200`}
          >
            <img
              src={s.img}
              alt={s.title}
              loading="lazy"
              class="mx-auto h-20 w-auto group-hover:scale-105 transition"
            />
            <h3 class="mt-6 text-xl font-semibold text-slate-900 group-hover:text-${s.color}-600">
              {s.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
            <p class="mt-4 text-sm font-medium text-${s.color}-600">المزيد ←</p>
          </a>
        ))}
      </div>
    </section>

    <!-- مانتر ERP -->
    <section class="relative bg-slate-900 py-24 text-white text-center" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold sm:text-4xl">مانتر ERP — مستقبل الأعمال الذكية</h2>
        <p class="mx-auto mt-3 max-w-2xl text-slate-300">
          مانتر ERP ليس مجرد نظام — بل مساعد ذكي لإدارة أعمالك.  
          بُني باستخدام الذكاء الاصطناعي والتحليلات ليتعلم ويتنبأ ويؤتمت المهام.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
          {[
            ["🤖 مساعد محادثة ذكي", "تفاعل مع بيانات ERP باستخدام أسئلة بلغة طبيعية."],
            ["📈 تقارير تنبؤية", "توقعات دقيقة وتوصيات قائمة على البيانات."],
            ["⚙️ محرك أتمتة", "ينشئ ويحدث ويراقب سير العمل تلقائيًا في الوقت الفعلي."],
          ].map(([icon, desc]) => (
            <div class="group rounded-3xl bg-white/5 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/10">
              <div class="text-3xl mb-3">{icon}</div>
              <p class="text-sm text-slate-300">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- الدعوة للتواصل -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-4xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">لنحوّل أعمالك إلى بيئة رقمية ذكية</h3>
        <p class="mt-3 text-indigo-100">
          هل أنت مستعد لتبسيط عملياتك ورفع كفاءة مؤسستك؟  
          تواصل معنا للحصول على عرض توضيحي لنظام مانتر ERP.
        </p>
        <a
          href="/ar/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          احصل على عرض توضيحي لمانتر ERP ←
        </a>
      </div>
    </section>

    <!-- الفوتر -->
    <FooterAr year={currentYear} />
  </body>
</html>