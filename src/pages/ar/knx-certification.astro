---
import "../../styles/global.css";
import Header from "../../components/HeaderAr.astro";
import Footer from "../../components/FooterAr.astro";
import FooterAr from "../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>خبراء الأتمتة الذكية المعتمدون من KNX و RTI في الكويت | أوكتونيكس إنوفيشنز</title>
    <meta
      name="description"
      content="أوكتونيكس إنوفيشنز هي شركة كويتية معتمدة من KNX و RTI تقدم حلول أتمتة ذكية للمنازل والمباني وفق أعلى المعايير العالمية في الإضاءة، التكييف، الصوت والطاقة."
    />
    <meta
      name="keywords"
      content="أوكتونيكس الكويت, KNX الكويت, RTI الكويت, المنزل الذكي الكويت, الأتمتة الذكية الكويت, أنظمة DALI الكويت, أنظمة تحكم RTI, أتمتة المباني الكويت"
    />
    <meta property="og:title" content="خبراء الأتمتة الذكية المعتمدون من KNX و RTI في الكويت | أوكتونيكس إنوفيشنز" />
    <meta
      property="og:description"
      content="شركة أوكتونيكس إنوفيشنز – معتمدة من KNX و RTI في الكويت. نقدم أنظمة ذكية مستقرة وآمنة للمنازل والفلل والمباني التجارية."
    />
    <meta property="og:image" content="/images/knx/og-knx.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- الهيدر -->
    <Header />

    <!-- البانر الرئيسي -->
    <section id="hero" class="relative isolate flex min-h-[90vh] items-center justify-center text-center overflow-hidden">
      <img
        src="/images/knx/hero-knx.jpg"
        alt="أنظمة الأتمتة الذكية المعتمدة من KNX في الكويت"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/85 via-indigo-950/70 to-slate-900/90"></div>
      <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-sky-400/20 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-indigo-500/20 blur-3xl"></div>

      <div class="relative z-10 max-w-4xl px-4 text-white sm:px-6" data-animate>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs ring-1 ring-white/20">
          معتمد من KNX • معتمد من RTI • خبراء المنازل الذكية
        </p>
        <h1 class="mt-5 text-5xl font-extrabold leading-tight sm:text-6xl">
          أتمتة ذكية معتمدة من KNX و RTI في الكويت
        </h1>
        <p class="mt-4 text-slate-200 leading-relaxed">
          نحن نصمم وننفذ أنظمة أتمتة متقدمة للفلل والمباني والمشاريع التجارية باستخدام تقنيات
          <strong>KNX</strong> و <strong>RTI</strong> — المعايير العالمية الأكثر موثوقية للتحكم الذكي.
        </p>
      </div>
    </section>

    <!-- قسم KNX -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-right" data-animate>
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div class="order-2 md:order-1">
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">KNX – المعيار العالمي للمباني الذكية</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            أوكتونيكس إنوفيشنز هي <strong>شريك معتمد من KNX</strong> — نقدم أنظمة أتمتة سلكية مستقرة وقابلة للتوسع للتحكم في الإضاءة، التكييف، الستائر، وإدارة الطاقة في الكويت.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            KNX ليس علامة تجارية، بل <strong>بروتوكول عالمي مفتوح</strong> معتمد من أكثر من 500 شركة ومستخدم في أكثر من 190 دولة.  
            يتيح التشغيل البيني الكامل بين العلامات مثل <strong>Theben</strong>، <strong>ABB</strong>، <strong>Jung</strong> و <strong>Gira</strong>.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-slate-700">
            <li>• <strong>التكامل الكامل:</strong> يعمل مع أكثر من 500 مصنع حول العالم.</li>
            <li>• <strong>موثوق:</strong> نظام سلكي مقاوم لانقطاع الواي فاي أو الإشارة.</li>
            <li>• <strong>قابل للتطوير:</strong> متوافق مع أنظمة الإضاءة DALI2.</li>
            <li>• <strong>كفاءة طاقية عالية:</strong> تحكم ذكي يوفر الطاقة للمباني المستدامة.</li>
          </ul>
        </div>

        <figure class="relative order-1 md:order-2">
          <img
            src="/images/knx/knx-system.jpg"
            alt="شريك KNX في الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-2 text-xs text-slate-500 text-center">
            تكامل KNX معتمد من أوكتونيكس – “ركّب وارتاح” بثبات لا يُضاهى.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- قسم RTI -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-24 text-white text-right" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-14 md:grid-cols-2 items-center">
        <figure class="order-2 md:order-1">
          <img
            src="/images/knx/rti-controller.jpg"
            alt="أنظمة تحكم RTI الكويت"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-white/10"
          />
          <figcaption class="mt-2 text-xs text-indigo-200 text-center">
            أنظمة RTI للتحكم الشامل في المنازل الذكية والمباني التجارية.
          </figcaption>
        </figure>

        <div class="order-1 md:order-2">
          <h2 class="text-3xl font-bold sm:text-4xl">RTI – خبرة في التحكم والتصميم البصري</h2>
          <p class="mt-4 text-indigo-100 leading-relaxed">
            أوكتونيكس هي <strong>شركة تكامل معتمدة من RTI</strong> — متخصصة في تصميم أنظمة التحكم والواجهات البصرية المخصصة.  
            تقدم RTI (Remote Technologies Inc.) واجهات تحكم احترافية تجمع الإضاءة، الصوت، الفيديو، والأتمتة في منصة واحدة سهلة الاستخدام.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-indigo-100">
            <li>• <strong>تصميم واجهات مخصصة</strong> لأجهزة iPad و Android وشاشات الحائط.</li>
            <li>• <strong>تكامل كامل</strong> مع KNX، DALI، وأنظمة الماتريكس الصوتية.</li>
            <li>• <strong>تحكم آمن عن بُعد</strong> من خلال بوابات مشفرة.</li>
            <li>• <strong>تجربة فاخرة</strong> للفلل، المعارض، والضيافة.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- العلامات التجارية -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-center" data-animate>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">العلامات التقنية المعتمدة</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        أنظمتنا المعتمدة مبنية على أكثر العلامات التجارية موثوقية في مجال الأتمتة الذكية.
      </p>
      <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
        {[
          "/images/brands/knx.png",
          "/images/brands/theben.png",
          "/images/brands/abb.png",
          "/images/brands/rti.png",
          "/images/brands/gira.png",
          "/images/brands/jung.png",
        ].map((b) => (
          <div class="flex items-center justify-center rounded-2xl bg-white p-4 shadow-md ring-1 ring-slate-200 hover:scale-105 transition">
            <img src={b} alt="Brand" loading="lazy" class="h-10 w-auto opacity-80 hover:opacity-100" />
          </div>
        ))}
      </div>
    </section>

    <!-- تواصل معنا -->
    <section id="contact" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 text-center" data-animate>
      <div class="rounded-3xl bg-gradient-to-br from-indigo-600 to-sky-600 p-10 text-white shadow-2xl">
        <h2 class="text-2xl font-bold sm:text-3xl">ابنِ منزلك الذكي المعتمد مع أوكتونيكس</h2>
        <p class="mt-3 text-indigo-100">
          استمتع بالراحة والتحكم والاستقرار الحقيقي — بتصميم وتنفيذ من مهندسين معتمدين من KNX و RTI في الكويت.
        </p>
        <a
          href="/ar/contact"
          class="mt-6 inline-flex rounded-2xl bg-white px-6 py-3 font-semibold text-slate-900 transition hover:scale-105"
        >
          احصل على استشارة مجانية
        </a>
      </div>
    </section>

    <!-- الفوتر -->
    <FooterAr year={currentYear} />

    <!-- شريط الاعتماد -->
    <div
      id="certBadge"
      class="fixed left-6 top-1/3 z-50 hidden flex-col items-center gap-3 rounded-2xl bg-white/80 px-4 py-3 text-center shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl opacity-0 -translate-x-8 transition-all duration-700 md:flex"
    >
      <img src="/images/brands/knx.png" alt="معتمد من KNX" class="h-8 w-auto drop-shadow-md" loading="lazy" />
      <img src="/images/brands/rti.png" alt="معتمد من RTI" class="h-8 w-auto drop-shadow-md" loading="lazy" />
      <p class="text-[10px] font-semibold text-slate-600 tracking-wide uppercase">شريك معتمد</p>
    </div>

    <script is:inline>
      const badge = document.getElementById("certBadge");
      window.addEventListener("scroll", () => {
        const showAt = 200;
        if (window.scrollY > showAt) {
          badge.style.opacity = "1";
          badge.style.transform = "translateX(0)";
        } else {
          badge.style.opacity = "0";
          badge.style.transform = "translateX(-20px)";
        }
      });
    </script>
  </body>
</html>