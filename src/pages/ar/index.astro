    icon: "🧠",
    link: "/ar/services/data-analytics-ai",
    gradient: "from-pink-500 to-rose-600",
  },
  {
    title: "المراقبة والأمن",
    desc: "كاميرات ذكية وتحكم بالوصول البيومتري.",
    icon: "🛡️",
    link: "/ar/services/surveillance-access-control",
    gradient: "from-amber-500 to-orange-600",
  },
  {
    title: "تطوير المواقع والتطبيقات",
    desc: "مواقع وتطبيقات حديثة بأداء خارق.",
    icon: "⚡",
    link: "/ar/services/web-app-development",
    gradient: "from-emerald-500 to-green-600",
  },
  {
    title: "الأمن السيبراني",
    desc: "حماية رقمية وامتثال وخدمات أمنية.",
    icon: "🔒",
    link: "/ar/services/it-governance-cybersecurity",
    gradient: "from-red-500 to-rose-600",
  },
  {
