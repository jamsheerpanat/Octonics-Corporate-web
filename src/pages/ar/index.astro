  { src: "/images/brands/schneider.png", name: "Schneider" },
  { src: "/images/brands/cisco.png", name: "Cisco" },
  { src: "/images/brands/ubiquiti.png", name: "Ubiquiti" },
  { src: "/images/brands/rti.png", name: "RTI" },
