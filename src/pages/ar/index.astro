---

<LayoutAr
  title="أوكتونيكس للابتكارات | الأتمتة الذكية والذكاء الاصطناعي في الكويت"
  description="شريكك المعتمد من KNX في الكويت. أتمتة الفلل الفاخرة، إضاءة DALI، حلول الذكاء الاصطناعي، وأنظمة ERP."
>
  <HeaderAr />

  <!-- HERO SECTION -->
  <section
    id="hero"
    dir="rtl"
    class="relative min-h-[100dvh] flex flex-col items-center justify-center overflow-hidden bg-[#030712]"
  >
    <!-- Neural Cursor Aura -->
    <div class="cursor-aura js-cursor-aura"></div>

    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#0a0a1a] via-[#020617] to-[#0a0a0a]"
      >
      </div>

      <!-- Tech Grid Overlay -->
      <div class="tech-grid-overlay opacity-30"></div>
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="absolute inset-0 cyber-grid opacity-30"></div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[1000px] bg-gradient-radial from-cyan-500/15 via-indigo-500/10 to-transparent rounded-full blur-3xl animate-pulse-slow"
      >
      </div>
    </div>

    <div class="floating-icon" style="top: 15%; right: 10%;">
      <div class="icon-glow bg-cyan-500"></div><span class="text-4xl">🧠</span>
    </div>
    <div class="floating-icon" style="top: 25%; left: 15%;">
      <div class="icon-glow bg-pink-500"></div><span class="text-4xl">🏠</span>
    </div>
    <div class="floating-icon" style="bottom: 30%; right: 8%;">
      <div class="icon-glow bg-emerald-500"></div><span class="text-4xl"
        >📡</span
      >
    </div>
    <div class="floating-icon" style="bottom: 20%; left: 10%;">
      <div class="icon-glow bg-amber-500"></div><span class="text-4xl">☁️</span>
    </div>

    <div class="particles">
      <div class="particle"></div><div class="particle"></div><div
        class="particle"
      >
      </div><div class="particle"></div><div class="particle"></div><div
        class="particle"
      >
      </div>
    </div>

    <!-- Hero Content - HUD Architect Mode (Arabic) -->
    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-6 py-12 lg:py-0 min-h-screen flex flex-col justify-center text-right"
    >
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Text & HUD Control Panel -->
        <div class="order-2 lg:order-2 px-2 sm:px-0">
          <!-- Glass HUD Card -->
          <div
            class="glass-dark p-6 sm:p-12 rounded-[2rem] sm:rounded-[2.5rem] border border-white/10 shadow-2xl relative overflow-hidden group"
          >
            <!-- Decorative HUD Corner -->
            <div
              class="absolute top-0 right-0 w-16 h-16 border-t-2 border-r-2 border-cyan-500/50 rounded-tr-3xl"
            >
            </div>
            <div
              class="absolute bottom-0 left-0 w-16 h-16 border-b-2 border-l-2 border-indigo-500/50 rounded-bl-3xl"
            >
            </div>

            <!-- Animated Badge -->
            <div
              class="inline-flex items-center gap-3 mb-8 px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 backdrop-blur-md"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"
                ></span>
              </span>
              <span
                class="text-[10px] sm:text-xs font-bold text-cyan-400 uppercase tracking-widest"
                >ذكاء الأنظمة مفعل</span
              >
            </div>

            <h1
              class="text-white font-black leading-[1.1] mb-6 text-4xl sm:text-5xl md:text-6xl xl:text-7xl"
            >
              هندسة <br />
              <span class="hero-gradient-text">الذكاء</span>
            </h1>

            <p
              class="text-base sm:text-xl text-slate-400 leading-relaxed font-light mb-8 sm:mb-10 max-w-xl"
            >
              نصمم ونبني <span class="text-slate-200">المعمار الرقمي</span> للمستقبل.
              من البيئات الذكية إلى أنظمة الذكاء الاصطناعي المخصصة — صُنع في الكويت،
              للعالم.
            </p>

            <!-- CTA HUD -->
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <div class="magnetic-wrap w-full sm:w-auto">
                <a
                  href="#services"
                  class="w-full sm:w-auto group relative inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-cyan-500 text-[#030712] font-bold text-lg transition-all duration-500 hover:scale-105 hover:shadow-[0_0_30px_rgba(6,182,212,0.5)]"
                >
                  اكتشف الأنظمة
                  <svg
                    class="w-5 h-5 transition-transform group-hover:-translate-x-2 rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </a>
              </div>
              <div class="magnetic-wrap w-full sm:w-auto">
                <a
                  href="/ar/contact"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full border border-white/20 text-white font-bold text-lg backdrop-blur-xl transition-all duration-500 hover:bg-white/10 hover:border-cyan-500/50"
                >
                  تواصل معنا
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Central HUD Visualization -->
        <div
          class="order-1 lg:order-1 relative flex justify-center items-center py-12 lg:py-0"
        >
          <!-- Scanning Rings -->
          <div
            class="absolute w-[300px] h-[300px] sm:w-[500px] sm:h-[500px] border border-cyan-500/10 rounded-full animate-pulse"
          >
          </div>
          <div
            class="absolute w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] border border-indigo-500/10 rounded-full animate-reverse-spin"
          >
          </div>

          <!-- The Center Piece -->
          <div class="relative z-20 w-[240px] sm:w-[450px] perspective-1000">
            <img
              src="/images/hero_octo_architect.png"
              alt="نظام أوكتونيكس"
              class="w-full h-auto drop-shadow-[0_0_30px_rgba(14,165,233,0.3)] sm:drop-shadow-[0_0_50px_rgba(14,165,233,0.3)] animate-float-slow"
            />

            <!-- Floating HUD Labels -->
            <div
              class="absolute -top-10 -left-10 glass-dark px-4 py-2 border border-cyan-500/30 rounded-lg backdrop-blur-md hidden md:block"
              dir="ltr"
            >
              <span class="text-[10px] font-mono text-cyan-400"
                >CORE_STABLE // 99.9%</span
              >
            </div>
            <div
              class="absolute bottom-20 -right-10 glass-dark px-4 py-2 border border-indigo-500/30 rounded-lg backdrop-blur-md hidden md:block"
              dir="ltr"
            >
              <span class="text-[10px] font-mono text-indigo-400"
                >AI_NODES: ACTIVE</span
              >
            </div>
            <div
              class="absolute -bottom-5 left-20 glass-dark px-4 py-2 border border-emerald-500/30 rounded-lg backdrop-blur-md hidden md:block"
              dir="ltr"
            >
              <span class="text-[10px] font-mono text-emerald-400"
                >LOC: KUWAIT_CITY</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom System Status Bar -->
      <div
        class="mt-20 border-t border-white/5 pt-8 flex flex-wrap justify-between items-center gap-6 opacity-60"
      >
        <div
          class="flex items-center gap-8 font-mono text-[10px] tracking-widest text-slate-500"
        >
          <div class="flex items-center gap-2">
            أتمتة KNX <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
          </div>
          <div class="flex items-center gap-2">
            ذكاء اصطناعي <span class="w-2 h-2 rounded-full bg-indigo-500"
            ></span>
          </div>
          <div class="flex items-center gap-2">
            أنظمة سحابية <span class="w-2 h-2 rounded-full bg-emerald-500"
            ></span>
          </div>
        </div>
        <div
          class="hidden md:block font-mono text-[10px] text-slate-600 animate-pulse"
        >
          ...جاري تشغيل واجهة أوكتونيكس العصبية [اكتمل]
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
    >
      <span class="text-[10px] uppercase tracking-widest text-slate-600"
        >مرر للأسفل</span
      >
      <div
        class="scroll-indicator w-6 h-10 rounded-full border-2 border-cyan-500/30 flex items-start justify-center p-2"
      >
        <div class="w-1 h-3 rounded-full bg-cyan-400 animate-scroll-bounce">
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-slate-50 to-transparent"
    >
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" dir="rtl" class="relative py-24 bg-white overflow-hidden">
    <div
      class="absolute top-0 left-0 w-1/2 h-full bg-gradient-to-r from-sky-50 to-transparent"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-xs font-semibold uppercase tracking-wide text-sky-700 mb-4"
          >من نحن</span
        >
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">
          ثمانية أذرع من <span
            class="bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
            >التقنية الذكية</span
          >
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          مستوحاة من الأخطبوط — كائن الذكاء والتكيف — <strong>أوكتونيكس</strong> توحّد
          ثمانية قطاعات تقنية تحت منظومة واحدة.
        </p>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[180px]"
      >
        <div
          class="relative col-span-1 md:col-span-2 row-span-2 rounded-3xl p-8 bg-gradient-to-br from-sky-600 to-indigo-700 text-white overflow-hidden"
        >
          <div
            class="absolute inset-0 bg-gradient-to-t from-sky-900/80 to-transparent"
          >
          </div>
          <div class="relative z-10 h-full flex flex-col justify-end">
            <h3 class="text-2xl font-bold mb-2">أتمتة معتمدة من KNX</h3>
            <p class="text-sky-100 text-sm leading-relaxed">
              نصمم وننفذ أنظمة أتمتة KNX كاملة للفلل الفاخرة والمباني التجارية
              في الكويت.
            </p>
          </div>
        </div>
        <div
          class="rounded-3xl p-6 bg-gradient-to-br from-slate-900 to-slate-800 text-white flex flex-col justify-between"
        >
          <div class="text-4xl">🧠</div>
          <div>
            <div class="text-lg font-bold">الذكاء الاصطناعي</div><div
              class="text-slate-400 text-sm"
            >
              التحليلات التنبؤية
            </div>
          </div>
        </div>
        <div
          class="rounded-3xl p-6 bg-gradient-to-br from-pink-500 to-rose-600 text-white flex flex-col justify-between"
        >
          <div class="text-4xl">📡</div>
          <div>
            <div class="text-lg font-bold">إنترنت الأشياء</div><div
              class="text-pink-100 text-sm"
            >
              بنية متصلة
            </div>
          </div>
        </div>
        <div
          class="rounded-3xl p-6 bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex flex-col justify-between"
        >
          <div class="text-4xl">☁️</div>
          <div>
            <div class="text-lg font-bold">الحوسبة السحابية</div><div
              class="text-emerald-100 text-sm"
            >
              بنية قابلة للتوسع
            </div>
          </div>
        </div>
        <div
          class="rounded-3xl p-6 bg-gradient-to-br from-amber-500 to-orange-600 text-white flex flex-col justify-between"
        >
          <div class="text-4xl">🔐</div>
          <div>
            <div class="text-lg font-bold">الأمن السيبراني</div><div
              class="text-amber-100 text-sm"
            >
              حماية المؤسسات
            </div>
          </div>
        </div>
        <div
          class="col-span-1 md:col-span-2 rounded-3xl p-8 bg-gradient-to-r from-slate-100 to-white border border-slate-200"
        >
          <div class="flex items-start gap-4">
            <div
              class="flex-shrink-0 w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center text-white text-2xl"
            >
              🚀
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">
                الجيل القادم من الحوسبة
              </h3>
              <p class="text-slate-600 leading-relaxed">
                نهندس بيئات ذكية تجمع الأتمتة والذكاء الاصطناعي والسحابة — لبناء
                العمود الفقري الرقمي لمستقبل الكويت.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section
    id="services"
    dir="rtl"
    class="relative py-24 bg-gradient-to-b from-slate-50 via-white to-slate-50 overflow-hidden"
  >
    <div class="relative max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-indigo-100 to-purple-100 text-xs font-semibold uppercase tracking-wide text-indigo-700 mb-4"
          >خدماتنا</span
        >
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">
          حلول <span
            class="bg-gradient-to-r from-indigo-500 to-purple-600 bg-clip-text text-transparent"
            >تقنية متكاملة</span
          >
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          من الأتمتة إلى الذكاء الاصطناعي — نقدم حلولاً شاملة للشركات.
        </p>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mobile-stagger js-reveal"
      >
        {
          services.map((service: any, i: number) => (
            <a
              href={service.link}
              class="service-card group relative p-6 rounded-3xl bg-white border border-slate-200 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-2"
              style={`--delay: ${i * 0.1}s`}
