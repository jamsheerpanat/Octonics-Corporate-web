---
import "../../styles/global.css";
import HeaderAr from "../../components/HeaderAr.astro";
import FooterAr from "../../components/FooterAr.astro";

const currentYear = new Date().getFullYear();
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <title>تواصل مع أوكتونيكس إنوفيشنز | الأتمتة الذكية وحلول التقنية في الكويت</title>
    <meta
      name="description"
      content="تواصل مع شركة أوكتونيكس إنوفيشنز – الشركة الكويتية المتخصصة في الأتمتة الذكية وأنظمة KNX والبرمجيات ERP وحلول الذكاء الاصطناعي والبنية التحتية لتقنية المعلومات."
    />
    <meta
      name="keywords"
      content="تواصل أوكتونيكس الكويت, أتمتة KNX الكويت, المنزل الذكي الكويت, ERP الكويت, الذكاء الاصطناعي الكويت, شركة تقنية الكويت, بنية تحتية تقنية الكويت"
    />
    <meta property="og:title" content="تواصل مع أوكتونيكس إنوفيشنز | الأتمتة الذكية وحلول التقنية في الكويت" />
    <meta property="og:description" content="تواصل مع خبراء الأتمتة المعتمدين من KNX في الكويت – في مجالات الأتمتة، ERP، الذكاء الاصطناعي، والبنية التحتية." />
    <meta property="og:image" content="/images/contact/og-contact.jpg" />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- الهيدر -->
    <HeaderAr />

    <!-- البانر الرئيسي -->
    <section
      id="contact-hero"
      class="relative isolate flex flex-col items-center justify-center text-center overflow-hidden min-h-[90vh]"
    >
      <img
        src="/images/contact/hero-contact.jpg"
        alt="تواصل مع أوكتونيكس إنوفيشنز الكويت"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>

      <div class="absolute -top-32 -right-32 h-72 w-72 rounded-full bg-sky-400/20 blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>

      <div class="relative z-10 max-w-3xl px-4 text-white" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-6xl">
          خلّنا نبني <span class="text-sky-400">شيء ذكي</span> مع بعض
        </h1>
        <p class="mt-4 text-indigo-100 text-lg">
          تواصل مع فريقنا المتخصص في الأتمتة وتقنية المعلومات — للمنازل الذكية، أنظمة ERP، أدوات الذكاء الاصطناعي، أو الشبكات المؤسسية.
          أوكتونيكس تجمع بين الابتكار، الثبات، والدقة في كل مشروع.
        </p>
        <a
          href="#form"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-8 py-3 font-semibold text-white shadow-lg transition hover:scale-110"
        >
          تواصل معنا الآن
        </a>
      </div>
    </section>

    <!-- معلومات التواصل -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 text-right">
        {[
          {
            icon: "📍",
            title: "المكتب الرئيسي في الكويت",
            desc: "شركة أوكتونيكس إنوفيشنز<br />قطعة 4، حولي<br />مدينة الكويت، الكويت",
          },
          {
            icon: "🏢",
            title: "مركز التطوير في الهند",
            desc: "مختبر أوكتونيكس – كينفرا تكنو بارك<br />كاليكوت، كيرالا، الهند",
          },
          {
            icon: "💬",
            title: "تواصل سريع",
            desc: "📞 +965 9924 0074<br />✉️ info@octonics.com<br />💬 واتساب: +965 9924 0074",
          },
        ].map((card) => (
          <div class="rounded-3xl bg-white p-8 shadow-xl ring-1 ring-slate-200 hover:-translate-y-1 hover:shadow-2xl transition backdrop-blur-md">
            <div class="flex items-center justify-center h-12 w-12 rounded-2xl bg-gradient-to-br from-sky-500 to-indigo-600 text-white text-xl shadow-md mb-4">
              {card.icon}
            </div>
            <h3 class="text-lg font-semibold text-slate-900">{card.title}</h3>
            <p class="mt-2 text-slate-600 text-sm" set:html={card.desc}></p>
          </div>
        ))}
      </div>
    </section>

    <!-- نموذج التواصل -->
    <section
      id="form"
      class="relative bg-gradient-to-br from-indigo-700 via-sky-700 to-indigo-800 py-20 text-white"
      data-animate
    >
      <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
        <h2 class="text-3xl font-bold sm:text-4xl">أرسل لنا رسالة</h2>
        <p class="mt-3 text-indigo-100 text-base">
          مهندسونا سيردّون عليك خلال 24 ساعة — دعنا نناقش مشروعك القادم.
        </p>

        <form
          action="https://formspree.io/f/meorpdle"
          method="POST"
          class="mt-10 rounded-3xl bg-white/10 p-8 backdrop-blur-md shadow-2xl space-y-4 text-right"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <input
              name="name"
              required
              placeholder="الاسم الكامل"
              class="w-full rounded-2xl bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-sky-400"
            />
            <input
              type="email"
              name="_replyto"
              required
              placeholder="البريد الإلكتروني"
              class="w-full rounded-2xl bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-sky-400"
            />
          </div>
          <input
            name="phone"
            placeholder="رقم الهاتف (اختياري)"
            class="w-full rounded-2xl bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-sky-400"
          />
          <textarea
            name="message"
            rows="5"
            placeholder="اكتب رسالتك هنا"
            required
            class="w-full rounded-2xl bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-sky-400"
          ></textarea>

          <input type="text" name="_gotcha" style="display:none" />

          <button
            type="submit"
            class="mt-4 w-full rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 px-5 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
          >
            إرسال الرسالة →
          </button>
        </form>
      </div>
    </section>

    <!-- خريطة الموقع -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-center" data-animate>
      <h3 class="text-3xl font-bold text-slate-900 mb-6">موقعنا على الخريطة</h3>
      <div class="relative rounded-3xl overflow-hidden shadow-2xl ring-1 ring-slate-200">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d272.271469553401!2d48.01245662942487!3d29.345997093255775!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fcf9b42147c486d%3A0x240dc8253e30623c!2sOctonics%20Innovations!5e1!3m2!1sen!2skw!4v1760428506628!5m2!1sen!2skw"
          class="w-full h-[400px] border-0"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <p class="mt-4 text-sm text-slate-500">امسح رمز QR أدناه للوصول إلى موقعنا في خرائط Google.</p>
      <img
        src="/images/contact/map-qr.png"
        alt="رمز QR - خريطة Google"
        class="mx-auto mt-4 h-28 w-28"
        loading="lazy"
      />
    </section>

    <!-- الفوتر -->
    <FooterAr year={currentYear} />
  </body>
</html>