---
import LayoutAr from "../../../layouts/Layout-ar.astro";
import HeaderAr from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";

const blogPosts = [
  {
    title: "مستقبل المنازل الذكية في الكويت",
    excerpt:
      "كيف تُحدث تقنية KNX ثورة في أتمتة الفلل الفاخرة والمباني التجارية في الكويت.",
    image: "/images/blog/smart-home.jpg",
    date: "15 ديسمبر 2024",
    category: "الأتمتة الذكية",
    slug: "future-smart-homes-kuwait",
  },
  {
    title: "الذكاء الاصطناعي في إدارة الأعمال",
    excerpt:
      "اكتشف كيف يمكن للذكاء الاصطناعي تحسين عمليات شركتك وزيادة الإنتاجية.",
    image: "/images/blog/ai-business.jpg",
    date: "10 ديسمبر 2024",
    category: "الذكاء الاصطناعي",
    slug: "ai-business-management",
  },
  {
    title: "أمان البيانات في العصر الرقمي",
    excerpt: "أفضل الممارسات لحماية بيانات شركتك من التهديدات السيبرانية.",
    image: "/images/blog/cybersecurity.jpg",
    date: "5 ديسمبر 2024",
    category: "الأمن السيبراني",
    slug: "data-security-digital-age",
  },
  {
    title: "إضاءة DALI: التحكم الذكي بالإضاءة",
    excerpt: "كل ما تحتاج معرفته عن نظام DALI للتحكم الذكي بالإضاءة.",
    image: "/images/blog/dali-lighting.jpg",
    date: "1 ديسمبر 2024",
    category: "الإضاءة الذكية",
    slug: "dali-smart-lighting",
  },
  {
    title: "تحويل قطاع التجزئة بالتقنية",
    excerpt: "كيف يمكن للتقنية الحديثة تحسين تجربة العملاء وزيادة المبيعات.",
    image: "/images/blog/retail-tech.jpg",
    date: "25 نوفمبر 2024",
    category: "التجزئة",
    slug: "retail-digital-transformation",
  },
  {
    title: "إنترنت الأشياء في المباني الذكية",
    excerpt:
      "دليل شامل لفهم كيفية عمل أجهزة إنترنت الأشياء في المباني الحديثة.",
    image: "/images/blog/iot-buildings.jpg",
    date: "20 نوفمبر 2024",
    category: "إنترنت الأشياء",
    slug: "iot-smart-buildings",
  },
];
---

<LayoutAr
  title="المدونة | أوكتونيكس للابتكارات"
  description="أحدث المقالات والأخبار عن التقنية والأتمتة الذكية والذكاء الاصطناعي في الكويت."
>
  <HeaderAr />

  <section
    dir="rtl"
    class="relative py-32 bg-gradient-to-b from-slate-50 to-white overflow-hidden"
  >
    <div
      class="absolute top-20 right-10 w-72 h-72 rounded-full bg-sky-200/30 blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-20 left-10 w-72 h-72 rounded-full bg-indigo-200/30 blur-3xl"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-xs font-semibold uppercase tracking-wide text-sky-700 mb-4"
          >مدونتنا</span
        >
        <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6">
          أحدث <span
            class="bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
            >المقالات والأخبار</span>
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          اكتشف أحدث التوجهات في عالم التقنية والأتمتة الذكية.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          blogPosts.map((post) => (
            <article class="group relative bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
              <div class="aspect-video bg-gradient-to-br from-slate-100 to-slate-200 overflow-hidden">
                <div class="w-full h-full bg-gradient-to-br from-sky-500/20 to-indigo-500/20 flex items-center justify-center">
                  <span class="text-6xl opacity-50">📖</span>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-4">
                  <span class="px-3 py-1 rounded-full bg-sky-100 text-sky-700 text-xs font-semibold">
                    {post.category}
                  </span>
                  <span class="text-xs text-slate-500">{post.date}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-sky-600 transition-colors">
                  {post.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                  {post.excerpt}
                </p>
                <a
                  href={`/ar/blog/${post.slug}`}
                  class="inline-flex items-center text-sm font-semibold text-sky-600 hover:text-sky-700"
                >
                  اقرأ المزيد
                  <svg
                    class="w-4 h-4 mr-2 rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-16 text-center">
        <p class="text-slate-600 mb-6">
          هل تريد البقاء على اطلاع بأحدث الأخبار؟
        </p>
        <a
          href="/ar/contact"
          class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-bold shadow-xl shadow-indigo-500/25 transition-all duration-300 hover:shadow-2xl hover:scale-105"
        >
          اشترك في نشرتنا الإخبارية
        </a>
      </div>
    </div>
  </section>

  <FooterAr />
</LayoutAr>
