---
import LayoutAr from "../../../layouts/Layout-ar.astro";
import HeaderAr from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";
import LeadForm from "../../../components/LeadForm.astro";
import WhatsAppButton from "../../../components/WhatsAppButton.astro";
---

<LayoutAr title="أوكتو توين™ – التوأم الرقمي للأعمال والمباني" description="عرض ثلاثي الأبعاد مباشر لعملياتك.">
  <HeaderAr />

  <section dir="rtl" class="relative py-32 bg-gradient-to-b from-cyan-600 via-teal-700 to-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-30"><div class="absolute top-20 right-10 w-96 h-96 bg-cyan-500/30 rounded-full blur-[120px]"></div></div>
    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-xl mb-8"><span class="text-3xl">🏢</span><span class="text-sm font-semibold text-white/80">التوأم الرقمي</span></div>
      <h1 class="text-4xl md:text-6xl font-black text-white mb-6">أوكتو توين™</h1>
      <p class="text-xl md:text-2xl text-cyan-200 mb-4">التوأم الرقمي للأعمال والمباني</p>
      <p class="text-lg text-white/70 max-w-2xl mx-auto">عرض ثلاثي الأبعاد مباشر لعملياتك ومبانيك وأصولك.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#lead-form" class="px-8 py-4 rounded-full bg-white text-cyan-600 font-bold shadow-xl transition-all hover:scale-105">احصل على عرض توضيحي</a>
        <a href="https://wa.me/96599240074" class="px-8 py-4 rounded-full border-2 border-white/30 text-white font-semibold transition-all hover:bg-white/10">تواصل عبر واتساب</a>
      </div>
    </div>
  </section>

  <section dir="rtl" class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-8 text-center bg-gradient-to-r from-cyan-500 to-teal-600 bg-clip-text text-transparent">المشكلة والحل</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div><h3 class="text-xl font-semibold mb-4 text-cyan-600">نقاط الألم</h3><ul class="list-disc pr-5 space-y-2 text-slate-600"><li>لا رؤية شاملة للعمليات.</li><li>صعوبة فهم العلاقات بين الأنظمة.</li><li>التخطيط للتغييرات بدون محاكاة.</li><li>بيانات متفرقة في أماكن مختلفة.</li></ul></div>
        <div><h3 class="text-xl font-semibold mb-4 text-cyan-600">الحل</h3><p class="text-slate-600 leading-relaxed">أوكتو توين™ ينشئ توأماً رقمياً ثلاثي الأبعاد لأعمالك مع بيانات حية ومحاكاة سيناريوهات.</p></div>
      </div>
    </div>
  </section>

  <section dir="rtl" class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12 text-slate-900">المميزات الرئيسية</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm"><div class="text-3xl mb-4">🗺️</div><h3 class="text-lg font-bold text-slate-900 mb-2">النموذج ثلاثي الأبعاد</h3><p class="text-sm text-slate-600">عرض تفاعلي لمبانيك أو عملياتك.</p></div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm"><div class="text-3xl mb-4">📡</div><h3 class="text-lg font-bold text-slate-900 mb-2">البيانات المباشرة</h3><p class="text-sm text-slate-600">تكامل إنترنت الأشياء لعرض البيانات الحية.</p></div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm"><div class="text-3xl mb-4">🔮</div><h3 class="text-lg font-bold text-slate-900 mb-2">محاكاة السيناريوهات</h3><p class="text-sm text-slate-600">اختبر التغييرات قبل تطبيقها.</p></div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm"><div class="text-3xl mb-4">📊</div><h3 class="text-lg font-bold text-slate-900 mb-2">لوحات التحليلات</h3><p class="text-sm text-slate-600">رؤى مبنية على البيانات المكانية.</p></div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm"><div class="text-3xl mb-4">🏗️</div><h3 class="text-lg font-bold text-slate-900 mb-2">إدارة الأصول</h3><p class="text-sm text-slate-600">تتبع موقع وحالة كل أصل.</p></div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm"><div class="text-3xl mb-4">🔗</div><h3 class="text-lg font-bold text-slate-900 mb-2">التكاملات</h3><p class="text-sm text-slate-600">اتصال مع BIM وERP وإنترنت الأشياء.</p></div>
      </div>
    </div>
  </section>

  <section dir="rtl" class="py-20 bg-white" id="lead-form"><div class="max-w-4xl mx-auto px-6"><LeadForm product="أوكتو توين™" /></div></section>
  <WhatsAppButton phone="+96599240074" />
  <FooterAr />
</LayoutAr>
