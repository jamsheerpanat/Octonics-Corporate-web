---
import LayoutAr from "../../../layouts/Layout-ar.astro";
import HeaderAr from "../../../components/HeaderAr.astro";
import FooterAr from "../../../components/FooterAr.astro";
import ProductHero from "../../../components/products/ProductHero.astro";
import ProductFeatures from "../../../components/products/ProductFeatures.astro";
import ProductHowItWorks from "../../../components/products/ProductHowItWorks.astro";
import ProductUseCases from "../../../components/products/ProductUseCases.astro";
import ProductSecurity from "../../../components/products/ProductSecurity.astro";
import ProductPricing from "../../../components/products/ProductPricing.astro";
import ProductFAQ from "../../../components/products/ProductFAQ.astro";
import LeadForm from "../../../components/LeadForm.astro";
import WhatsAppButton from "../../../components/WhatsAppButton.astro";
---

<LayoutAr title="أوكتو براين™ – مركز ذكاء الأعمال بالذكاء الاصطناعي" description="شاشة قيادة واحدة لإدارة أعمالك باستخدام الذكاء الاصطناعي.">
  <HeaderAr />

  <section dir="rtl" class="relative py-32 bg-gradient-to-b from-sky-600 via-indigo-700 to-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-20 right-10 w-96 h-96 bg-sky-500/30 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-20 left-10 w-80 h-80 bg-indigo-500/30 rounded-full blur-[100px]"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-xl mb-8">
        <span class="text-3xl">🧠</span>
        <span class="text-sm font-semibold text-white/80">ذكاء الأعمال</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-black text-white mb-6">أوكتو براين™</h1>
      <p class="text-xl md:text-2xl text-sky-200 mb-4">مركز ذكاء الأعمال بالذكاء الاصطناعي</p>
      <p class="text-lg text-white/70 max-w-2xl mx-auto">شاشة قيادة واحدة لإدارة أعمالك باستخدام الذكاء الاصطناعي. اتخذ قرارات أسرع وأذكى.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#lead-form" class="px-8 py-4 rounded-full bg-white text-indigo-600 font-bold shadow-xl transition-all hover:scale-105">احصل على عرض توضيحي</a>
        <a href="https://wa.me/96599240074" class="px-8 py-4 rounded-full border-2 border-white/30 text-white font-semibold transition-all hover:bg-white/10">تواصل عبر واتساب</a>
      </div>
    </div>
  </section>

  <section dir="rtl" class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-8 text-center bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent">المشكلة والحل</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-semibold mb-4 text-sky-600">نقاط الألم</h3>
          <ul class="list-disc pr-5 space-y-2 text-slate-600">
            <li>بيانات متناثرة عبر أنظمة ERP والجداول المختلفة.</li>
            <li>تأخر القرارات بسبب التقارير اليدوية.</li>
            <li>عدم وجود توقعات لحظية.</li>
            <li>وقت طويل لإعداد العروض التقديمية.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-4 text-sky-600">الحل</h3>
          <p class="text-slate-600 leading-relaxed">أوكتو براين™ يجمع كل مصادر البيانات، ويطبق الذكاء الاصطناعي لتوليد رؤى فورية وتوقعات تنبؤية وتقارير جاهزة للإدارة — كل ذلك من لوحة تحكم واحدة.</p>
        </div>
      </div>
    </div>
  </section>

  <section dir="rtl" class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12 text-slate-900">المميزات الرئيسية</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-3xl mb-4">💡</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">اسأل أعمالك</h3>
          <p class="text-sm text-slate-600">دردشة AI باللغة الطبيعية تجيب على أي سؤال تجاري.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-3xl mb-4">📊</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">لوحة المؤشرات</h3>
          <p class="text-sm text-slate-600">مؤشرات أداء قابلة للتخصيص للمالية والمبيعات والمخزون.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-3xl mb-4">🔮</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">رؤى تنبؤية</h3>
          <p class="text-sm text-slate-600">AI يتوقع الطلب والتدفق النقدي واتجاهات الأرباح.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-3xl mb-4">⚠️</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">تنبيهات الشذوذ</h3>
          <p class="text-sm text-slate-600">كشف لحظي للمقاييس غير الطبيعية مع إشعارات فورية.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-3xl mb-4">🗂️</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">تقرير المدير التنفيذي</h3>
          <p class="text-sm text-slate-600">إنشاء PDF بنقرة واحدة لاجتماعات الإدارة.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-3xl mb-4">🔗</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">موصلات البيانات</h3>
          <p class="text-sm text-slate-600">تكامل سلس مع ERP والمحاسبة ونقاط البيع وإنترنت الأشياء.</p>
        </div>
      </div>
    </div>
  </section>

  <section dir="rtl" class="py-20 bg-white" id="lead-form">
    <div class="max-w-4xl mx-auto px-6">
      <LeadForm product="أوكتو براين™" />
    </div>
  </section>

  <WhatsAppButton phone="+96599240074" />
  <FooterAr />
</LayoutAr>
