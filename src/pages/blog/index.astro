---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const tags = [
  ...new Set(allPosts.flatMap((post) => post.data.tags || [])),
].filter(Boolean);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);
---

<Layout
  title="Blog | Octonics Innovations Kuwait - Web Development & Automation Insights"
>
  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white py-24 px-4 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-900/50"
      >
      </div>
      {
        featuredPost && featuredPost.data.heroImage && (
          <img
            src={featuredPost.data.heroImage}
            alt={featuredPost.data.title}
            class="w-full h-full object-cover opacity-30"
          />
        )
      }
    </div>

    <div class="relative z-10 mx-auto max-w-6xl">
      <span
        class="inline-block py-1 px-3 rounded-full bg-blue-600/20 text-blue-400 text-sm font-medium mb-4 backdrop-blur-sm border border-blue-500/30"
      >
        Featured Article
      </span>
      {
        featuredPost ? (
          <div class="max-w-3xl">
            <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
              <a
                href={`/blog/${featuredPost.slug}`}
                class="hover:text-blue-400 transition"
              >
                {featuredPost.data.title}
              </a>
            </h1>
            <p class="text-lg md:text-xl text-slate-300 mb-8 leading-relaxed max-w-2xl">
              {featuredPost.data.summary || featuredPost.data.description}
            </p>
            <div class="flex items-center gap-4 text-slate-400 text-sm">
              <div class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                    <line x1="16" x2="16" y1="2" y2="6" />
                    <line x1="8" x2="8" y1="2" y2="6" />
                    <line x1="3" x2="21" y1="10" y2="10" />
                  </>
                </svg>
                {new Date(featuredPost.data.pubDate).toLocaleDateString(
                  "en-GB",
                  { day: "numeric", month: "long", year: "numeric" },
                )}
              </div>
              <div class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </>
                </svg>
                {featuredPost.data.author}
              </div>
            </div>
            <div class="mt-8">
              <a
                href={`/blog/${featuredPost.slug}`}
                class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-all shadow-lg hover:shadow-blue-600/30"
              >
                Read Article
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
            </div>
          </div>
        ) : (
          <h1 class="text-5xl font-bold">Blog</h1>
        )
      }
    </div>
  </section>

  <!-- Content Section -->
  <section class="bg-slate-50 py-16" id="blog-content">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <!-- Filters & Search -->
      <div
        class="mb-12 flex flex-col md:flex-row md:items-center justify-between gap-6"
      >
        <div class="flex flex-wrap gap-2" id="tags-container">
          <button
            class="filter-btn active px-4 py-2 rounded-full text-sm font-medium bg-slate-200 text-slate-800 hover:bg-blue-100 hover:text-blue-700 transition data-[state=active]:bg-blue-600 data-[state=active]:text-white"
            data-tag="all"
          >
            All Posts
          </button>
          {
            tags.map((tag) => (
              <button
                class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-slate-200 text-slate-800 hover:bg-blue-100 hover:text-blue-700 transition data-[state=active]:bg-blue-600 data-[state=active]:text-white"
                data-tag={tag}
              >
                {tag}
              </button>
            ))
          }
        </div>

        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="search-input"
            placeholder="Search articles..."
            class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
            ></path></svg
          >
        </div>
      </div>

      <!-- Posts Grid -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" id="posts-grid">
        {
          remainingPosts.map((p) => (
            <article
              class="post-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 flex flex-col h-full"
              data-tags={p.data.tags?.join(",")}
              data-title={p.data.title.toLowerCase()}
            >
              <a
                href={`/blog/${p.slug}`}
                class="block overflow-hidden relative aspect-video"
              >
                {p.data.heroImage ? (
                  <img
                    src={p.data.heroImage}
                    alt={p.data.title}
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-slate-200 flex items-center justify-center">
                    <span class="text-slate-400">No Image</span>
                  </div>
                )}
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors" />
              </a>

              <div class="p-6 flex flex-col flex-1">
                <div class="flex flex-wrap gap-2 mb-4">
                  {(p.data.tags || []).slice(0, 2).map((tag) => (
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-blue-50 text-blue-600">
                      {tag}
                    </span>
                  ))}
                </div>

                <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
                  <a href={`/blog/${p.slug}`}>{p.data.title}</a>
                </h3>

                <p class="text-slate-600 text-sm mb-4 line-clamp-3 flex-1">
                  {p.data.summary || p.data.description}
                </p>

                <div class="pt-4 mt-auto border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                  <span class="flex items-center gap-1">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-3.5 h-3.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <>
                        <rect
                          width="18"
                          height="18"
                          x="3"
                          y="4"
                          rx="2"
                          ry="2"
                        />
                        <line x1="16" x2="16" y1="2" y2="6" />
                        <line x1="8" x2="8" y1="2" y2="6" />
                        <line x1="3" x2="21" y1="10" y2="10" />
                      </>
                    </svg>
                    {new Date(p.data.pubDate).toLocaleDateString()}
                  </span>
                  <a
                    href={`/blog/${p.slug}`}
                    class="text-blue-600 font-medium hover:underline flex items-center gap-1"
                  >
                    Read
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-3 h-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- No Results Message -->
      <div id="no-results" class="hidden text-center py-20">
        <div
          class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-8 h-8 text-slate-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
            ></path></svg
          >
        </div>
        <h3 class="text-lg font-semibold text-slate-900">No articles found</h3>
        <p class="text-slate-500">Try adjusting your search or filter.</p>
        <button id="clear-filters" class="mt-4 text-blue-600 hover:underline"
          >Clear all filters</button
        >
      </div>
    </div>
  </section>
</Layout>

<script>
  function initBlog() {
    const searchInput = document.getElementById("search-input");
    const filterBtns = document.querySelectorAll(".filter-btn");
    const postCards = document.querySelectorAll(".post-card");
    const noResults = document.getElementById("no-results");
    const clearFiltersBtn = document.getElementById("clear-filters");

    let activeTag = "all";
    let searchQuery = "";

    function filterPosts() {
      let visibleCount = 0;

      postCards.forEach((card) => {
        const tags = (card.getAttribute("data-tags") || "").split(",");
        const title = card.getAttribute("data-title") || "";

        const matchTag = activeTag === "all" || tags.includes(activeTag);
        const matchSearch = title.includes(searchQuery);

        if (matchTag && matchSearch) {
          (card as HTMLElement).style.display = "flex"; // Restore flex display
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    }

    // Filter Buttons
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Remove active class from all
        filterBtns.forEach((b) => {
          b.removeAttribute("data-state");
          b.classList.remove("bg-blue-600", "text-white");
          b.classList.add("bg-slate-200", "text-slate-800");
        });

        // Add active to clicked
        btn.setAttribute("data-state", "active");
        btn.classList.remove("bg-slate-200", "text-slate-800");
        btn.classList.add("bg-blue-600", "text-white");

        activeTag = btn.getAttribute("data-tag") || "all";
        filterPosts();
      });
    });

    // Search Input
    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filterPosts();
    });

    // Clear Filters
    clearFiltersBtn?.addEventListener("click", () => {
      activeTag = "all";
      searchQuery = "";
      if (searchInput) (searchInput as HTMLInputElement).value = "";

      // Reset buttons
      filterBtns.forEach((b) => {
        if (b.getAttribute("data-tag") === "all") {
          b.setAttribute("data-state", "active");
          b.classList.remove("bg-slate-200", "text-slate-800");
          b.classList.add("bg-blue-600", "text-white");
        } else {
          b.removeAttribute("data-state");
          b.classList.remove("bg-blue-600", "text-white");
          b.classList.add("bg-slate-200", "text-slate-800");
        }
      });

      filterPosts();
    });
  }

  // Run on load
  initBlog();

  // Run on view transition navigation (if enabled)
  document.addEventListener("astro:page-load", initBlog);
</script>
