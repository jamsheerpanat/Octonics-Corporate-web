---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<Layout title="Blog | Octonics Innovations Kuwait">
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h1 class="text-4xl font-extrabold text-slate-900 text-center mb-10">
      Octonics Blog — Smart Automation in Kuwait
    </h1>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="group block rounded-3xl overflow-hidden shadow-md ring-1 ring-slate-200 hover:shadow-2xl transition">
          {p.data.cover && (
            <img src={p.data.cover} alt={p.data.title} class="h-52 w-full object-cover group-hover:scale-105 transition-transform duration-500" />
          )}
          <div class="p-6">
            <h3 class="font-semibold text-lg text-slate-900 group-hover:text-sky-600">{p.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600 line-clamp-3">{p.data.description}</p>
            <p class="mt-3 text-xs text-slate-400">{new Date(p.data.pubDate).toLocaleDateString()}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>