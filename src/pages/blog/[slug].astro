---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
if (!post) throw new Error("Post not found");

const { Content } = await post.render();
const data = post.data;

// Get related posts
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug) // Exclude current
  .filter((p) => p.data.tags?.some((tag) => data.tags?.includes(tag))) // Match tags
  .slice(0, 3); // Take 3

const pageTitle = data.title;
const pageDescription =
  data.summary || data.description || "Octonics Innovations Blog";
const pageImage = data.heroImage || data.cover || "/images/blog-hero.jpg";
---

<Layout
  title={`${pageTitle} | Octonics Kuwait`}
  description={pageDescription}
  image={pageImage}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: pageTitle,
      image: `https://octonics.com${pageImage}`,
      author: {
        "@type": "Person",
        name: data.author || "Octonics Innovations",
      },
      publisher: {
        "@type": "Organization",
        name: "Octonics Innovations",
        logo: {
          "@type": "ImageObject",
          url: "https://octonics.com/images/octonics-logo.png",
        },
      },
      datePublished: new Date(data.pubDate).toISOString(),
      description: pageDescription,
    })}
  />
  <article class="mx-auto max-w-4xl py-12 px-4 sm:px-6">
    <!-- Breadcrumb -->
    <nav
      class="flex items-center text-sm text-slate-500 mb-8 overflow-x-auto whitespace-nowrap"
    >
      <a href="/" class="hover:text-blue-600 transition">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-blue-600 transition">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900 font-medium truncate">{data.title}</span>
    </nav>

    <!-- HEADER -->
    <header class="mb-12 text-center max-w-3xl mx-auto">
      <div class="flex items-center justify-center gap-2 mb-6">
        {
          data.tags?.map((tag) => (
            <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-xs font-semibold uppercase tracking-wider">
              {tag}
            </span>
          ))
        }
      </div>

      <h1
        class="text-3xl sm:text-5xl font-extrabold text-slate-900 leading-tight mb-6"
      >
        {data.title}
      </h1>

      <div
        class="flex items-center justify-center gap-4 text-slate-500 text-sm"
      >
        <span class="flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line
              x1="16"
              x2="16"
              y1="2"
              y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line
              x1="3"
              x2="21"
              y1="10"
              y2="10"></line></svg
          >
          {
            new Date(data.pubDate).toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
        </span>
        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
        <span class="flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle
              cx="12"
              cy="7"
              r="4"></circle></svg
          >
          {data.author}
        </span>
      </div>

      {
        pageImage && (
          <div class="relative mt-8 rounded-3xl overflow-hidden shadow-2xl aspect-video group">
            <img
              src={pageImage}
              alt={data.title}
              class="w-full h-full object-cover transform group-hover:scale-105 transition duration-700"
            />
          </div>
        )
      }
    </header>

    <!-- CONTENT BODY -->
    <div
      class="prose prose-lg prose-slate prose-headings:font-bold prose-a:text-blue-600 hover:prose-a:text-blue-700 mx-auto bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-slate-100"
    >
      <Content />
    </div>

    <!-- Share & Author Bio (Optional Placeholder) -->
    <div class="mt-12 pt-8 border-t border-slate-200 text-center">
      <p class="text-slate-600 font-medium italic">
        Did you find this article helpful? Share it with your network!
      </p>
    </div>
  </article>

  <!-- Related Posts -->
  {
    relatedPosts.length > 0 && (
      <section class="bg-slate-50 py-16 border-t border-slate-200">
        <div class="mx-auto max-w-6xl px-4 md:px-6">
          <h2 class="text-3xl font-bold text-slate-900 mb-8">
            Related Articles
          </h2>
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((p) => (
              <a
                href={`/blog/${p.slug}`}
                class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100"
              >
                <div class="aspect-video overflow-hidden bg-slate-200">
                  {p.data.heroImage || p.data.cover ? (
                    <img
                      src={p.data.heroImage || p.data.cover}
                      alt={p.data.title}
                      class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
                    />
                  ) : null}
                </div>
                <div class="p-6">
                  <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition mb-2">
                    {p.data.title}
                  </h3>
                  <p class="text-sm text-slate-500 line-clamp-2">
                    {p.data.summary || p.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
