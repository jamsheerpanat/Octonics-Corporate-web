---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

if (!post) {
  throw new Error("Post not found");
}

const rendered = await post.render();
const Content = rendered?.Content;
const data = rendered?.data ?? {};
---

<Layout
  title={data.title ?? "Octonics Blog"}
  description={data.summary ?? "Explore smart automation insights from Octonics Innovations in Kuwait."}
  image={data.heroImage ?? "/images/og-default.jpg"}
>

  <article class="article-shell prose prose-slate mx-auto max-w-4xl py-20 px-4 sm:px-6" data-animate>

    <!-- HEADER -->
    <header class="mb-12 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900">
        {data.title}
      </h1>

      {data.pubDate && (
        <p class="mt-2 text-sm text-slate-500">
          {new Date(data.pubDate).toLocaleDateString("en-KW", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </p>
      )}

      {data.author && (
        <p class="mt-1 text-sm text-slate-600">By {data.author}</p>
      )}

      {data.heroImage && (
        <img
          src={data.heroImage}
          alt={data.title}
          class="mt-8 w-full max-h-[480px] object-cover rounded-3xl shadow-lg ring-1 ring-slate-200"
        />
      )}
    </header>

    <!-- CONTENT BODY -->
    <Content />

  </article>

</Layout>