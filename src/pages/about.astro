---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const currentYear = new Date().getFullYear();

const values = [
  {
    title: "Innovation",
    desc: "At Octonics, we believe technology should think ahead of time. Every solution we deliver is built on intelligence, simplicity, and creativity — engineered to make life smarter and business smoother across Kuwait.",
  },
  {
    title: "Integrity",
    desc: "Trust is built through transparency and long-term partnerships. Every project we deliver aligns with our client’s vision while meeting international standards and Kuwaiti market needs.",
  },
  {
    title: "Excellence",
    desc: "From code to cables — precision defines us. Our engineers ensure accuracy and quality in every design, device, and line of code to deliver long-lasting smart systems.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>About Octonics Innovations | Smart Automation & IT Solutions Kuwait</title>
    <meta
      name="description"
      content="Octonics Innovations is Kuwait’s next-generation smart automation and IT solutions company. KNX-certified and powered by AI, we deliver advanced ERP systems, automation, and infrastructure designed for Kuwait’s modern businesses."
    />
    <meta
      name="keywords"
      content="Octonics Innovations Kuwait, Smart Automation Kuwait, KNX Certified Kuwait, ERP Software Kuwait, IT Infrastructure Kuwait, AI Solutions Kuwait, IT Company Kuwait, Business Software Kuwait, KNX DALI Kuwait"
    />
    <meta property="og:title" content="About Octonics Innovations | Smart Automation & IT Solutions Kuwait" />
    <meta property="og:description" content="Discover Octonics Innovations — a KNX-certified Kuwaiti technology company specializing in automation, ERP, IT infrastructure, and AI solutions. Built for Kuwait’s modern enterprises." />
    <meta property="og:image" content="/images/about/og-about.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative isolate flex min-h-[90vh] items-center justify-center overflow-hidden text-center"
    >
      <img
        src="/images/about/dark-octopus.jpg"
        alt="Octonics Innovations Kuwait Office"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/80 via-indigo-950/70 to-slate-900/90"></div>

      <div class="relative z-10 max-w-4xl px-4 text-white sm:px-6" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-6xl md:text-7xl">
          About <span class="text-sky-400">Octonics</span> Innovations
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-slate-200 text-lg">
          A KNX-certified, AI-powered technology company from Kuwait — redefining smart automation, ERP systems, and IT infrastructure for the region’s modern enterprises.
        </p>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section
      id="philosophy"
      class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8"
      data-animate
    >
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            The Story Behind the Name
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The name <strong>“Octonics”</strong> originates from <em>Octo</em> — inspired by the intelligence and adaptability of the octopus. With eight dynamic arms working in perfect harmony, it represents how we integrate multiple disciplines like <b>Automation, ERP, AI, IT Infrastructure, and Cybersecurity</b> into one smart ecosystem.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The suffix <em>-nics</em> comes from <strong>Electronics</strong> and <strong>Technics</strong>, symbolizing precision, innovation, and seamless dynamics.  
            Together, <span class="text-sky-600 font-semibold">Octonics Innovations</span> stands for adaptive technology that evolves with people, environments, and enterprises.
          </p>
        </div>
        <figure class="relative">
          <img
            src="/images/about/octopus-tech.jpg"
            alt="Octopus Inspiration for Octonics Innovations"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption
            class="mt-2 text-center text-xs text-slate-500"
          >
            The octopus — a symbol of intelligence, adaptability, and control.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- OPERATIONS -->
    <section
      class="relative bg-gradient-to-br from-sky-50 via-white to-indigo-50 py-24"
      data-animate
    >
      <div class="mx-auto max-w-7xl grid gap-14 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
        <figure>
          <img
            src="/images/about/india-lab.jpg"
            alt="Octonics India Development Lab"
            loading="lazy"
            class="rounded-3xl shadow-xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-3 text-center text-xs text-slate-500">
            Octonics Software Development Lab — KINFRA Techno Park, Calicut, India.
          </figcaption>
        </figure>

        <div class="flex flex-col justify-center">
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Global Presence, Local Strength
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Headquartered in <strong>Kuwait</strong> and powered by a full-scale <strong>R&D and development center in India</strong>, Octonics bridges regional insight with global engineering excellence.  
            Our Calicut lab at <strong>KINFRA Techno Park</strong> hosts certified engineers specialized in software, AI, KNX automation, and smart infrastructure.
          </p>
          <p class="mt-4 text-slate-600 leading-relaxed">
            This synergy allows us to deliver highly customized, scalable, and secure solutions — designed for Kuwait’s smart homes, enterprises, and government projects.
          </p>
        </div>
      </div>
    </section>

    

    <!-- VALUES -->
    <section
      id="values"
      class="relative bg-gradient-to-br from-indigo-700 via-sky-600 to-sky-500 py-24 text-white"
      data-animate
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 text-center lg:px-8">
        <h2 class="text-3xl font-bold sm:text-4xl">Our Core Values</h2>
        <p class="mx-auto mt-3 max-w-2xl text-indigo-100">
          Every Octonics innovation begins with people, precision, and purpose.
        </p>

        <div
          class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3"
        >
          {values.map((v) => (
            <article
              class="rounded-3xl bg-white/10 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-sm transition hover:-translate-y-1 hover:shadow-2xl"
            >
              <h3 class="text-xl font-semibold text-white">{v.title}</h3>
              <p class="mt-2 text-sm text-indigo-100">{v.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section
      id="cta"
      class="relative mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 lg:px-8"
      data-animate
    >
      <div
        class="rounded-3xl bg-gradient-to-br from-indigo-600 to-sky-600 p-10 text-white shadow-2xl"
      >
        <h2 class="text-2xl font-bold sm:text-3xl">
          Join Our Journey Towards Intelligent Innovation
        </h2>
        <p class="mt-3 text-indigo-100">
          Partner with us for a smarter future — from automation to analytics, we design and build tomorrow’s intelligent systems today.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex rounded-2xl bg-white px-6 py-3 font-semibold text-slate-900 shadow-md transition hover:scale-105"
        >
          Connect With Us
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />
  </body>
</html>