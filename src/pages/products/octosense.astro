---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductHero from "../../components/products/ProductHero.astro";
import ProductFeatures from "../../components/products/ProductFeatures.astro";
import ProductHowItWorks from "../../components/products/ProductHowItWorks.astro";
import ProductUseCases from "../../components/products/ProductUseCases.astro";
import ProductIntegrations from "../../components/products/ProductIntegrations.astro";
import ProductSecurity from "../../components/products/ProductSecurity.astro";
import ProductPricing from "../../components/products/ProductPricing.astro";
import ProductTimeline from "../../components/products/ProductTimeline.astro";
import ProductFAQ from "../../components/products/ProductFAQ.astro";
import LeadForm from "../../components/LeadForm.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
---

<Layout
  title="OctoSense™ – Smart Facility & Energy Intelligence Platform"
  description="Reduce energy waste with AI‑driven building intelligence."
>
  <Header />

  <Breadcrumb
    items={[
      { href: "/", label: "Home" },
      { href: "/products", label: "Products" },
      { href: "/products/octosense", label: "OctoSense™" },
    ]}
  />

  <ProductHero
    productName="OctoSense™"
    tagline="Smart Facility & Energy Intelligence Platform"
    description="Reduce energy waste with AI‑driven building intelligence."
    stats={[
      { value: "AI", label: "Optimization" },
      { value: "5", label: "Modules" },
      { value: "24/7", label: "Monitoring" },
      { value: "Kuwait", label: "Local" },
    ]}
    gradientFrom="emerald-500"
    gradientTo="teal-600"
    icon="💡"
  />

  <section class="py-16 bg-white" id="pain-solution">
    <div class="max-w-5xl mx-auto px-6">
      <h2
        class="text-3xl font-bold mb-8 text-center bg-gradient-to-r from-emerald-500 to-teal-600 bg-clip-text text-transparent"
      >
        The Problem & The Solution
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-semibold mb-4 text-emerald-600">
            Pain Points
          </h3>
          <ul class="list-disc pl-5 space-y-2 text-slate-600">
            <li>Energy bills are unpredictable and high.</li>
            <li>Manual meter reading is error‑prone.</li>
            <li>No real‑time visibility into consumption per zone.</li>
            <li>Equipment runs inefficiently, causing wear.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-4 text-emerald-600">Solution</h3>
          <p class="text-slate-600 leading-relaxed">
            OctoSense™ integrates with KNX, DALI, HVAC and IoT meters, applying
            AI to detect anomalies, suggest optimizations, and generate
            actionable energy‑saving reports.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ProductFeatures
    features={[
      {
        icon: "⚡",
        title: "Occupancy‑Based Control",
        description:
          "AI adjusts lighting, HVAC and equipment based on real‑time occupancy data.",
      },
      {
        icon: "📊",
        title: "Energy Analytics",
        description:
          "Dashboards show consumption trends, peak loads and cost breakdowns.",
      },
      {
        icon: "🔍",
        title: "Anomaly Detection",
        description:
          "AI flags spikes or leaks instantly for quick remediation.",
      },
      {
        icon: "🛠️",
        title: "Predictive Maintenance",
        description: "Detect equipment inefficiencies before failure occurs.",
      },
      {
        icon: "🗂️",
        title: "Integration Hub",
        description:
          "Connect KNX, DALI, HVAC, smart meters, and IoT sensors via unified API.",
      },
      {
        icon: "📈",
        title: "Savings Reports",
        description:
          "Automated PDF reports with ROI calculations for management.",
      },
    ]}
  />

  <ProductHowItWorks
    steps={[
      {
        number: 1,
        title: "Connect Devices",
        description:
          "Link KNX, DALI, HVAC controllers and smart meters to the platform.",
      },
      {
        number: 2,
        title: "Data Ingestion",
        description: "Stream real‑time telemetry to the AI engine.",
      },
      {
        number: 3,
        title: "AI Optimization",
        description:
          "Algorithms compute optimal set‑points and detect anomalies.",
      },
      {
        number: 4,
        title: "Action & Report",
        description:
          "Apply automated controls and generate savings reports for stakeholders.",
      },
    ]}
  />

  <ProductUseCases
    useCases={[
      {
        industry: "Office Buildings",
        icon: "🏢",
        description: "Cut HVAC energy by 20% with occupancy‑based scheduling.",
      },
      {
        industry: "Retail Stores",
        icon: "🛍️",
        description: "Optimize lighting and HVAC per foot‑traffic patterns.",
      },
      {
        industry: "Hospitals",
        icon: "🏥",
        description: "Maintain critical environment while reducing waste.",
      },
      {
        industry: "Industrial",
        icon: "🏭",
        description:
          "Monitor heavy‑equipment power usage and prevent overloads.",
      },
    ]}
  />

  <ProductIntegrations
    integrations={[
      { name: "KNX", src: "/images/integrations/knx.svg" },
      { name: "DALI", src: "/images/integrations/dali.svg" },
      { name: "HVAC", src: "/images/integrations/hvac.svg" },
      { name: "IoT Sensors", src: "/images/integrations/iot.svg" },
    ]}
  />

  <ProductSecurity
    items={[
      {
        title: "RBAC",
        description: "Granular role‑based access to building data.",
        icon: "🛡️",
      },
      {
        title: "Audit Logs",
        description: "Immutable logs of all control actions.",
        icon: "📜",
      },
      {
        title: "Encryption",
        description: "AES‑256 at rest, TLS‑1.3 in transit.",
        icon: "🔐",
      },
      {
        title: "Backups",
        description: "Daily data snapshots with retention policies.",
        icon: "💾",
      },
      {
        title: "On‑Prem Option",
        description: "Deploy AI engine on‑prem for ultra‑sensitive facilities.",
        icon: "🏢",
      },
    ]}
  />

  <ProductPricing />
  <ProductTimeline />

  <ProductFAQ
    faq={[
      {
        q: "Can OctoSense work with legacy meters?",
        a: "Yes, via Modbus or BACnet adapters.",
      },
      {
        q: "What is the typical ROI?",
        a: "Clients see 15‑30% reduction in energy costs within 6 months.",
      },
      {
        q: "Is there a free trial?",
        a: "A 30‑day sandbox with limited device count is available.",
      },
      {
        q: "How is data stored securely?",
        a: "All telemetry is encrypted and stored according to ISO‑27001 standards.",
      },
      {
        q: "Do you provide on‑site training?",
        a: "Our services team offers on‑site or remote workshops.",
      },
      {
        q: "Can I integrate with my existing BMS?",
        a: "Out‑of‑the‑box connectors for major BMS platforms are provided.",
      },
      {
        q: "Is there mobile app support?",
        a: "Yes, a responsive dashboard works on tablets and phones.",
      },
      {
        q: "How are AI models updated?",
        a: "Continuous learning pipeline updates models without downtime.",
      },
    ]}
  />

  <section class="py-20 bg-slate-100" id="lead-form">
    <div class="max-w-4xl mx-auto px-6">
      <LeadForm product="OctoSense™" />
    </div>
  </section>

  <WhatsAppButton phone="+96599240074" />

  <Footer />
</Layout>
