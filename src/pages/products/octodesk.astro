---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductHero from "../../components/products/ProductHero.astro";
import ProductFeatures from "../../components/products/ProductFeatures.astro";
import ProductHowItWorks from "../../components/products/ProductHowItWorks.astro";
import ProductUseCases from "../../components/products/ProductUseCases.astro";
import ProductSecurity from "../../components/products/ProductSecurity.astro";
import ProductPricing from "../../components/products/ProductPricing.astro";
import ProductTimeline from "../../components/products/ProductTimeline.astro";
import ProductFAQ from "../../components/products/ProductFAQ.astro";
import LeadForm from "../../components/LeadForm.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
---

<Layout
  title="OctoDesk™ – AI‑Powered IT & Support Command Center"
  description="Make your IT support faster, measurable, and proactive."
>
  <Header />

  <Breadcrumb items={[{ href: "/", label: "Home" }, { href: "/products", label: "Products" }, { href: "/products/octodesk", label: "OctoDesk™" }]} />

  <ProductHero
    productName="OctoDesk™"
    tagline="AI‑Powered IT & Support Command Center"
    description="Make your IT support faster, measurable, and proactive."
    stats={[{ value: "AI", label: "Triage" }, { value: "SLA", label: "Tracking" }, { value: "24/7", label: "Support" }, { value: "Kuwait", label: "Local" }]}
    gradientFrom="sky-500"
    gradientTo="blue-600"
    icon="🎧"
  />

  <section class="py-16 bg-white" id="pain-solution">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold mb-8 text-center bg-gradient-to-r from-sky-500 to-blue-600 bg-clip-text text-transparent">The Problem & The Solution</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-semibold mb-4 text-sky-600">Pain Points</h3>
          <ul class="list-disc pl-5 space-y-2 text-slate-600">
            <li>Tickets pile up without clear priority.</li>
            <li>Teams lack visibility into SLA compliance.</li>
            <li>No proactive alerting for recurring issues.</li>
            <li>Manual routing wastes valuable time.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-4 text-sky-600">Solution</h3>
          <p class="text-slate-600 leading-relaxed">OctoDesk™ applies AI to triage, route, and escalate tickets automatically, while giving managers real‑time dashboards on response times and team performance.</p>
        </div>
      </div>
    </div>
  </section>

  <ProductFeatures features={[
    { icon: "🤖", title: "AI Triage", description: "Automatically classify and prioritize incoming tickets." },
    { icon: "📊", title: "SLA Dashboards", description: "Track first‑response and resolution times in real time." },
    { icon: "🔔", title: "Proactive Alerts", description: "Get notified before SLAs breach." },
    { icon: "📧", title: "Multi‑Channel", description: "Receive tickets via email, portal, WhatsApp, or API." },
    { icon: "🔗", title: "Integrations", description: "Connect to Azure AD, Jira, Slack, and more." },
    { icon: "📈", title: "Analytics", description: "Identify recurring issues and measure team efficiency." },
  ]} />

  <ProductHowItWorks steps={[
    { number: 1, title: "Ingest Tickets", description: "Receive requests from any channel into a unified queue." },
    { number: 2, title: "AI Classification", description: "Machine learning tags priority, category, and assignee." },
    { number: 3, title: "Route & Escalate", description: "Automatically assign to the right team with SLA timers." },
    { number: 4, title: "Resolve & Report", description: "Close tickets, collect satisfaction scores, and generate reports." },
  ]} />

  <ProductUseCases useCases={[
    { industry: "Corporate IT", icon: "🖥️", description: "Streamline internal helpdesk for employees." },
    { industry: "MSPs", icon: "🏢", description: "Manage multi‑tenant support with SLA visibility." },
    { industry: "Customer Support", icon: "📞", description: "Handle external customer queries efficiently." },
    { industry: "Facilities", icon: "🔧", description: "Track maintenance requests with priority routing." },
  ]} />

  <ProductSecurity items={[
    { title: "RBAC", description: "Control access to tickets and settings by role.", icon: "🛡️" },
    { title: "Audit Logs", description: "Immutable record of all changes.", icon: "📜" },
    { title: "Encryption", description: "AES‑256 at rest, TLS in transit.", icon: "🔐" },
    { title: "Backups", description: "Daily snapshots with retention policies.", icon: "💾" },
  ]} />

  <ProductPricing />
  <ProductTimeline />

  <ProductFAQ faq={[
    { q: "Can I import tickets from another system?", a: "Yes, via CSV or API migration tools." },
    { q: "Does OctoDesk support WhatsApp?", a: "Absolutely – tickets can be created and updated via WhatsApp." },
    { q: "Is there a mobile app?", a: "Agents can work from any mobile browser; a native app is on the roadmap." },
    { q: "How is AI trained?", a: "Models learn from your historical ticket data after opt‑in." },
    { q: "What integrations are available?", a: "Azure AD, Google Workspace, Jira, Slack, Teams, and custom webhooks." },
  ]} />

  <section class="py-20 bg-slate-100" id="lead-form">
    <div class="max-w-4xl mx-auto px-6">
      <LeadForm product="OctoDesk™" />
    </div>
  </section>

  <WhatsAppButton phone="+96599240074" />

  <Footer />
</Layout>
