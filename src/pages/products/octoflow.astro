---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductHero from "../../components/products/ProductHero.astro";
import ProductFeatures from "../../components/products/ProductFeatures.astro";
import ProductHowItWorks from "../../components/products/ProductHowItWorks.astro";
import ProductUseCases from "../../components/products/ProductUseCases.astro";
import ProductIntegrations from "../../components/products/ProductIntegrations.astro";
import ProductSecurity from "../../components/products/ProductSecurity.astro";
import ProductPricing from "../../components/products/ProductPricing.astro";
import ProductTimeline from "../../components/products/ProductTimeline.astro";
import ProductFAQ from "../../components/products/ProductFAQ.astro";
import LeadForm from "../../components/LeadForm.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
---

<Layout
  title="OctoFlow™ – Smart Operations & Workflow Automation Engine"
  description="Automate approvals and processes without chaos."
>
  <Header />

  <Breadcrumb
    items={[
      { href: "/", label: "Home" },
      { href: "/products", label: "Products" },
      { href: "/products/octoflow", label: "OctoFlow™" },
    ]}
  />

  <ProductHero
    productName="OctoFlow™"
    tagline="Smart Operations & Workflow Automation Engine"
    description="Automate approvals and processes without chaos."
    stats={[
      { value: "Low‑Code", label: "Builder" },
      { value: "8", label: "Modules" },
      { value: "24/7", label: "Support" },
      { value: "Kuwait", label: "Local" },
    ]}
    gradientFrom="emerald-500"
    gradientTo="teal-600"
    icon="⚙️"
  />

  <section class="py-16 bg-white" id="pain-solution">
    <div class="max-w-5xl mx-auto px-6">
      <h2
        class="text-3xl font-bold mb-8 text-center bg-gradient-to-r from-emerald-500 to-teal-600 bg-clip-text text-transparent"
      >
        The Problem & The Solution
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-semibold mb-4 text-emerald-600">
            Pain Points
          </h3>
          <ul class="list-disc pl-5 space-y-2 text-slate-600">
            <li>Manual approvals cause bottlenecks.</li>
            <li>Process steps are undocumented and error‑prone.</li>
            <li>No visibility into SLA compliance.</li>
            <li>Hard to adapt workflows to new regulations.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-4 text-emerald-600">Solution</h3>
          <p class="text-slate-600 leading-relaxed">
            OctoFlow™ provides a low‑code visual builder, SLA tracking,
            escalation rules, and AI‑driven bottleneck detection – all in a
            single, auditable platform.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ProductFeatures
    features={[
      {
        icon: "🛠️",
        title: "Low‑Code Builder",
        description:
          "Drag‑and‑drop workflow designer with reusable components.",
      },
      {
        icon: "⏱️",
        title: "SLA Tracking",
        description:
          "Real‑time monitoring of approval times with auto‑escalation.",
      },
      {
        icon: "🤖",
        title: "AI Bottleneck Detection",
        description:
          "Machine‑learning identifies slow steps and suggests optimizations.",
      },
      {
        icon: "📧",
        title: "Email/WhatsApp Approvals",
        description: "Approve directly from inbox or WhatsApp messages.",
      },
      {
        icon: "🔗",
        title: "ERP Triggers",
        description: "Start workflows from ERP events or webhooks.",
      },
      {
        icon: "📜",
        title: "Audit Trail",
        description: "Full immutable log for compliance and reporting.",
      },
    ]}
  />

  <ProductHowItWorks
    steps={[
      {
        number: 1,
        title: "Design Workflow",
        description:
          "Use the visual canvas to map steps, approvals, and conditions.",
      },
      {
        number: 2,
        title: "Connect Systems",
        description: "Link ERP, HR, email, or custom APIs via connectors.",
      },
      {
        number: 3,
        title: "Enable AI",
        description:
          "Activate bottleneck detection and auto‑suggested improvements.",
      },
      {
        number: 4,
        title: "Deploy & Monitor",
        description:
          "Publish the workflow, monitor SLA dashboards, and iterate.",
      },
    ]}
  />

  <ProductUseCases
    useCases={[
      {
        industry: "Procurement",
        icon: "📦",
        description: "Automate purchase order approvals with budget checks.",
      },
      {
        industry: "HR",
        icon: "🧑‍💼",
        description:
          "Streamline leave requests, expense claims, and onboarding.",
      },
      {
        industry: "Facilities",
        icon: "🏢",
        description: "Manage maintenance requests with priority routing.",
      },
      {
        industry: "Finance",
        icon: "💰",
        description: "Enforce invoice approval policies and fast payments.",
      },
    ]}
  />

  <ProductIntegrations
    integrations={[
      { name: "SAP ERP", src: "/images/integrations/sap.svg" },
      { name: "Microsoft Dynamics", src: "/images/integrations/dynamics.svg" },
      {
        name: "Google Workspace",
        src: "/images/integrations/google-workspace.svg",
      },
      { name: "Slack", src: "/images/integrations/slack.svg" },
    ]}
  />

  <ProductSecurity
    items={[
      {
        title: "RBAC",
        description: "Granular role‑based permissions for each workflow.",
        icon: "🛡️",
      },
      {
        title: "Audit Logs",
        description: "Immutable logs for every action and decision.",
        icon: "📜",
      },
      {
        title: "Encryption",
        description: "AES‑256 data‑at‑rest and TLS‑1.3 in‑transit.",
        icon: "🔐",
      },
      {
        title: "Backups",
        description: "Daily snapshots with point‑in‑time restore.",
        icon: "💾",
      },
      {
        title: "On‑Prem Option",
        description: "Deploy within your own data centre if required.",
        icon: "🏢",
      },
    ]}
  />

  <ProductPricing />
  <ProductTimeline />

  <ProductFAQ
    faq={[
      {
        q: "Do I need to code any workflow?",
        a: "No. OctoFlow™ is a fully visual low‑code platform, though custom scripts are optional for advanced logic.",
      },
      {
        q: "Can I integrate with legacy systems?",
        a: "Yes, via REST/webhook connectors or CSV import.",
      },
      {
        q: "Is there a mobile app?",
        a: "Approvals can be performed from any mobile browser or via WhatsApp.",
      },
      {
        q: "How are AI suggestions generated?",
        a: "OctoFlow™ analyses historical task durations and automatically flags outliers.",
      },
      {
        q: "What SLA reporting is available?",
        a: "Real‑time dashboards, exportable CSV, and email alerts.",
      },
      {
        q: "Can I set multi‑level approvals?",
        a: "Absolutely – define sequential or parallel approvers per step.",
      },
      {
        q: "Is there a free trial?",
        a: "A 30‑day sandbox is available with limited workflow count.",
      },
      {
        q: "Do you provide training?",
        a: "Our professional services team offers on‑site or remote workshops.",
      },
    ]}
  />

  <section class="py-20 bg-slate-100" id="lead-form">
    <div class="max-w-4xl mx-auto px-6">
      <LeadForm product="OctoFlow™" />
    </div>
  </section>

  <WhatsAppButton phone="+96599240074" />

  <Footer />
</Layout>
