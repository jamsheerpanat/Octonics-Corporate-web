---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

/* ---------- DATA ---------- */
const hero = {
  title: "QRKuwait — Smart QR-Based Ordering Platform",
  subtitle: "Transform how your customers order and how your business operates. Fast. Modern. Professional.",
  tagline: "A Product by Octonics Innovations",
  image: "/images/products/qrkuwait-hero.jpg",
};

const stats = [
  { value: "100%", label: "No App Required" },
  { value: "2x", label: "Faster Orders" },
  { value: "0", label: "Order Mistakes" },
  { value: "24/7", label: "Always Available" },
];

const problemsSolved = [
  { icon: "❌", problem: "Manual WhatsApp messages", solution: "Automatic formatted order summaries" },
  { icon: "❌", problem: "Phone calls with order mistakes", solution: "Clear, mistake-free digital orders" },
  { icon: "❌", problem: "Paper tickets", solution: "Digital dashboard & kitchen display" },
  { icon: "❌", problem: "Disconnected POS workflows", solution: "POS-ready integrated system" },
];

const howItWorks = [
  { step: "01", title: "Scan QR Code", desc: "QR placed on tables, counters, shelves, or delivery posters.", icon: "📱" },
  { step: "02", title: "Menu Opens Instantly", desc: "Restaurant menu or grocery items load in the browser.", icon: "📋" },
  { step: "03", title: "Place Order", desc: "Items are selected, quantities chosen, and contact details entered.", icon: "🛒" },
  { step: "04", title: "Order Delivered", desc: "Appears on WhatsApp, cashier dashboard, POS queue, and kitchen display.", icon: "✅" },
];

const restaurantFeatures = [
  "QR menu ordering",
  "Table, pickup, and delivery orders",
  "Cashier confirmation before kitchen",
  "Kitchen Display System (KDS)",
  "WhatsApp order notifications",
  "POS-ready integration",
  "Multi-branch support",
];

const groceryFeatures = [
  "Digital product catalog",
  "Quantity & weight-based items",
  "Packing workflow (Picked → Packed → Ready)",
  "Delivery & pickup management",
  "Clear order summaries to WhatsApp",
  "Packing screen for staff",
  "POS-ready exports",
];

const customerFeatures = [
  { title: "No App Required", desc: "Works on all phones instantly", icon: "📱" },
  { title: "Fast & Simple", desc: "Order in under 30 seconds", icon: "⚡" },
  { title: "Bilingual", desc: "Arabic & English support", icon: "🌍" },
  { title: "Clean Interface", desc: "Modern and intuitive design", icon: "✨" },
];

const businessFeatures = [
  { title: "Real-time Dashboards", desc: "Live order tracking", icon: "📊" },
  { title: "Cashier Workflow", desc: "Confirm before kitchen", icon: "💳" },
  { title: "Kitchen Display", desc: "Clear order screens", icon: "👨‍🍳" },
  { title: "Reports", desc: "Daily & monthly analytics", icon: "📈" },
];

const whatsappFeatures = [
  { title: "Auto Formatted", desc: "Clean order summaries", icon: "📝" },
  { title: "No API Cost", desc: "Zero WhatsApp fees", icon: "💰" },
  { title: "Your Number", desc: "Use existing business line", icon: "📞" },
  { title: "Error-Free", desc: "No message mistakes", icon: "✅" },
];

const posFeatures = [
  { title: "Print-Friendly", desc: "Thermal printer ready", icon: "🖨️" },
  { title: "CSV & PDF", desc: "Easy exports", icon: "📄" },
  { title: "Future API", desc: "Ready for upgrades", icon: "🔌" },
  { title: "Scalable", desc: "Grow without limits", icon: "📈" },
];

const whyChoose = [
  { title: "Faster Orders", desc: "Streamlined digital ordering process" },
  { title: "Fewer Mistakes", desc: "Eliminate miscommunication errors" },
  { title: "Less Staff Load", desc: "Automated order management" },
  { title: "Professional Image", desc: "Modern digital presence" },
  { title: "Happy Customers", desc: "Better ordering experience" },
  { title: "Future Ready", desc: "Scalable for growth" },
];

const faqs = [
  { q: "Do my customers need to download an app?", a: "No! QRKuwait works entirely in the browser. Customers simply scan the QR code and the menu opens instantly — no app installation required." },
  { q: "Does it work with my existing WhatsApp number?", a: "Yes! Orders are sent directly to your existing WhatsApp business number. There are no API fees or complex integrations." },
  { q: "Can I use it for multiple branches?", a: "Absolutely. QRKuwait supports multi-branch setups with separate menus, staff, and dashboards for each location." },
  { q: "Is it suitable for grocery stores?", a: "Yes! QRKuwait has specific features for groceries including weight-based items, packing workflows, and delivery management." },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>QRKuwait — Smart QR Ordering System for Restaurants & Groceries in Kuwait | Octonics</title>

  <!-- ENGLISH SEO -->
  <meta name="description" content="QRKuwait is a next-generation QR-based ordering platform for restaurants and grocery stores in Kuwait. No app required. WhatsApp integration. Kitchen display. POS-ready.">
  <meta name="keywords" content="
    QR ordering Kuwait,
    Restaurant ordering system Kuwait,
    QR menu Kuwait,
    Digital menu Kuwait,
    WhatsApp ordering Kuwait,
    Smart restaurant Kuwait,
    Grocery ordering system Kuwait,
    Food ordering app Kuwait,
    Table ordering Kuwait,
    Kitchen display system Kuwait,
    POS Kuwait,
    Restaurant technology Kuwait,
    QRKuwait,
    Octonics products
  ">

  <!-- ARABIC SEO -->
  <meta name="description" lang="ar" content="كيو آر الكويت — نظام طلب ذكي للمطاعم والبقالات. بدون تطبيق. واتساب. شاشة مطبخ. جاهز للكاشير.">

  <meta name="robots" content="index, follow" />
  <meta name="author" content="Octonics Innovations" />
  <meta name="theme-color" content="#059669" />

  <!-- GEO TAGS -->
  <meta name="geo.region" content="KW" />
  <meta name="geo.position" content="29.346069262076877;48.01252801196281" />
  <meta name="ICBM" content="29.346069262076877, 48.01252801196281" />

  <!-- OPEN GRAPH -->
  <meta property="og:title" content="QRKuwait — Smart QR Ordering for Restaurants & Groceries" />
  <meta property="og:description" content="No app required. WhatsApp integrated. Kitchen display. POS-ready. Built for Kuwait businesses." />
  <meta property="og:image" content="/images/products/qrkuwait-og.jpg" />
  <meta property="og:locale" content="en_KW" />
  <meta property="og:locale:alternate" content="ar_KW" />

  <!-- TWITTER -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="QRKuwait — Smart QR Ordering Platform" />
  <meta name="twitter:description" content="Transform restaurant & grocery ordering in Kuwait. No app. WhatsApp. Kitchen display." />
  <meta name="twitter:image" content="/images/products/qrkuwait-og.jpg" />

  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- JSON-LD SCHEMA -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "QRKuwait",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Smart QR-based ordering and operations platform for restaurants and grocery stores in Kuwait.",
      "url": "https://www.qrkuwait.com",
      "author": {
        "@type": "Organization",
        "name": "Octonics Innovations",
        "url": "https://octonics.com"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "KWD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "ratingCount": "28"
      }
    }
  </script>

  <style>
    @keyframes float { 0%,100% { transform: translateY(0) } 50% { transform: translateY(8px) } }
    .animate-float { animation: float 6s ease-in-out infinite; }
    @keyframes pulse-glow { 0%,100% { opacity: 0.5 } 50% { opacity: 1 } }
    .pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
    @keyframes marquee { 0% {transform: translateX(0)} 100% {transform: translateX(-50%)} }
    .marquee { animation: marquee 35s linear infinite; }
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
    html, body { overflow-x: hidden; }
  </style>
</head>

<body class="bg-slate-50 text-slate-900 antialiased relative">
  <!-- HEADER -->
  <Header />

  <!-- ============================================ -->
  <!-- HERO SECTION -->
  <!-- ============================================ -->
  <section
    id="hero"
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-br from-emerald-950 via-teal-900 to-slate-950 text-white"
  >
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/60 via-teal-900/40 to-slate-950/90"></div>

    <!-- Decorative Glow Blobs -->
    <div aria-hidden="true" class="pointer-events-none absolute -top-32 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-emerald-400/30 blur-[120px] pulse-glow"></div>
    <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-teal-500/30 blur-[100px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute bottom-10 right-1/4 h-60 w-60 rounded-full bg-emerald-600/25 blur-[100px]"></div>

    <!-- QR Pattern Background -->
    <div aria-hidden="true" class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,')]"></div>

    <!-- Hero Content -->
    <div class="relative z-10 mx-auto max-w-5xl px-6 text-center">
      <!-- Badge -->
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-[11px] uppercase tracking-wider text-emerald-100 ring-1 ring-white/20 backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {hero.tagline}
      </p>

      <!-- Title -->
      <h1
        class="mt-6 text-balance font-extrabold leading-tight text-white drop-shadow-sm"
        style="font-size: clamp(2rem, 5vw + 0.5rem, 4.5rem);"
      >
        {hero.title}
      </h1>

      <!-- Subtitle -->
      <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-emerald-100 md:text-xl">
        {hero.subtitle}
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
        <a
          href="https://app.qrkuwait.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 px-8 py-3.5 font-semibold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-emerald-500/30"
        >
          Try Live Demo →
        </a>
        <a
          href="/contact"
          class="rounded-full border border-white/30 bg-white/10 px-8 py-3.5 font-semibold text-white backdrop-blur-md transition-all duration-300 hover:bg-white/20"
        >
          Request Demo
        </a>
      </div>

      <!-- Quick Stats -->
      <div class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-4 md:gap-8">
        {stats.map((stat) => (
          <div class="rounded-2xl bg-white/5 p-4 ring-1 ring-white/10 backdrop-blur-sm">
            <p class="text-3xl font-bold text-emerald-300">{stat.value}</p>
            <p class="mt-1 text-sm text-emerald-100">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom fade -->
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-50 to-transparent"></div>
  </section>

  <!-- ============================================ -->
  <!-- ABOUT QRKUWAIT -->
  <!-- ============================================ -->
  <section class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">What is QRKuwait?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-600 leading-relaxed">
        QRKuwait is a next-generation QR-based ordering and operations platform designed specifically for 
        <strong>restaurants and grocery stores in Kuwait</strong>. It transforms how customers place orders 
        and how businesses manage them — making the entire ordering process faster, clearer, and more professional.
      </p>
    </div>

    <div class="mt-12 rounded-3xl bg-gradient-to-br from-emerald-50 to-teal-50 p-8 ring-1 ring-emerald-100">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-3xl shadow-lg">📱</div>
          <h3 class="mt-4 font-semibold text-slate-900">Scan QR</h3>
          <p class="mt-2 text-sm text-slate-600">Customers scan a code</p>
        </div>
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-3xl shadow-lg">🍽️</div>
          <h3 class="mt-4 font-semibold text-slate-900">Browse Menu</h3>
          <p class="mt-2 text-sm text-slate-600">See items instantly</p>
        </div>
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-3xl shadow-lg">🛒</div>
          <h3 class="mt-4 font-semibold text-slate-900">Place Order</h3>
          <p class="mt-2 text-sm text-slate-600">Add items & submit</p>
        </div>
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-3xl shadow-lg">✅</div>
          <h3 class="mt-4 font-semibold text-slate-900">Order Arrives</h3>
          <p class="mt-2 text-sm text-slate-600">WhatsApp, POS & Kitchen</p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-center text-lg text-slate-700">
      <strong class="text-emerald-600">No mobile apps. No complicated systems.</strong> Just smart, simple, modern ordering.
    </p>
  </section>

  <!-- ============================================ -->
  <!-- WHY QRKUWAIT WAS BUILT -->
  <!-- ============================================ -->
  <section class="relative bg-gradient-to-b from-white to-slate-100 py-20 overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute top-[-100px] left-[10%] h-[250px] w-[250px] rounded-full bg-red-300/10 blur-[120px]"></div>
      <div class="absolute bottom-[-100px] right-[15%] h-[250px] w-[250px] rounded-full bg-emerald-400/15 blur-[120px]"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">Why QRKuwait Was Built</h2>
        <p class="mx-auto mt-4 max-w-2xl text-slate-600">
          In Kuwait, most restaurants and groceries still rely on outdated systems. QRKuwait solves these problems.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {problemsSolved.map((item) => (
          <div class="group rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-50 text-xl">
                  {item.icon}
                </div>
              </div>
              <div class="flex-1">
                <p class="text-slate-500 line-through">{item.problem}</p>
                <div class="mt-2 flex items-center gap-2">
                  <span class="text-emerald-500 text-lg">✓</span>
                  <p class="font-semibold text-emerald-700">{item.solution}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- HOW IT WORKS -->
  <!-- ============================================ -->
  <section class="relative bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 py-24 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold">How QRKuwait Works</h2>
        <p class="mx-auto mt-4 max-w-2xl text-emerald-200">
          Simple for customers. Powerful for your business.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-4">
        {howItWorks.map((item) => (
          <div class="group relative text-center">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-600 text-4xl shadow-lg transition group-hover:scale-110">
              {item.icon}
            </div>
            <div class="mt-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-sm font-bold text-emerald-300">
              {item.step}
            </div>
            <h3 class="mt-3 text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm text-emerald-100">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- TWO INDUSTRIES -->
  <!-- ============================================ -->
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">One Platform. Two Industries.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Built specifically for restaurants and grocery stores with tailored features for each.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Restaurants -->
      <div class="group relative rounded-3xl bg-gradient-to-br from-orange-500 to-red-600 p-[2px] shadow-xl transition hover:-translate-y-1 hover:shadow-2xl">
        <div class="h-full rounded-3xl bg-white p-8">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 to-red-100 text-3xl">
              🍽️
            </div>
            <h3 class="text-2xl font-bold text-slate-900">For Restaurants & Cafés</h3>
          </div>
          <ul class="mt-6 space-y-3">
            {restaurantFeatures.map((feature) => (
              <li class="flex items-start gap-3">
                <span class="text-orange-500">✓</span>
                <span class="text-slate-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Grocery -->
      <div class="group relative rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-600 p-[2px] shadow-xl transition hover:-translate-y-1 hover:shadow-2xl">
        <div class="h-full rounded-3xl bg-white p-8">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-100 to-teal-100 text-3xl">
              🛒
            </div>
            <h3 class="text-2xl font-bold text-slate-900">For Grocery & Bakkala Stores</h3>
          </div>
          <ul class="mt-6 space-y-3">
            {groceryFeatures.map((feature) => (
              <li class="flex items-start gap-3">
                <span class="text-emerald-500">✓</span>
                <span class="text-slate-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- KEY FEATURES -->
  <!-- ============================================ -->
  <section class="relative bg-gradient-to-b from-slate-100 to-white py-24 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">Key Features</h2>
        <p class="mx-auto mt-4 max-w-2xl text-slate-600">
          Everything you need to modernize your ordering operations.
        </p>
      </div>

      <!-- Feature Grids -->
      <div class="mt-16 space-y-12">
        <!-- Customer Experience -->
        <div>
          <h3 class="text-xl font-semibold text-emerald-600 mb-6">Customer Experience</h3>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {customerFeatures.map((f) => (
              <div class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-100 transition hover:shadow-lg">
                <div class="text-2xl mb-2">{f.icon}</div>
                <h4 class="font-semibold text-slate-900">{f.title}</h4>
                <p class="mt-1 text-sm text-slate-600">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Business Operations -->
        <div>
          <h3 class="text-xl font-semibold text-teal-600 mb-6">Business Operations</h3>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {businessFeatures.map((f) => (
              <div class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-100 transition hover:shadow-lg">
                <div class="text-2xl mb-2">{f.icon}</div>
                <h4 class="font-semibold text-slate-900">{f.title}</h4>
                <p class="mt-1 text-sm text-slate-600">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- WhatsApp-First -->
        <div>
          <h3 class="text-xl font-semibold text-green-600 mb-6">WhatsApp-First System</h3>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {whatsappFeatures.map((f) => (
              <div class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-100 transition hover:shadow-lg">
                <div class="text-2xl mb-2">{f.icon}</div>
                <h4 class="font-semibold text-slate-900">{f.title}</h4>
                <p class="mt-1 text-sm text-slate-600">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- POS-Ready -->
        <div>
          <h3 class="text-xl font-semibold text-indigo-600 mb-6">POS-Ready Architecture</h3>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {posFeatures.map((f) => (
              <div class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-100 transition hover:shadow-lg">
                <div class="text-2xl mb-2">{f.icon}</div>
                <h4 class="font-semibold text-slate-900">{f.title}</h4>
                <p class="mt-1 text-sm text-slate-600">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- DESIGNED FOR KUWAIT -->
  <!-- ============================================ -->
  <section class="relative bg-gradient-to-br from-emerald-700 via-teal-700 to-slate-900 py-24 text-white overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 left-1/3 h-96 w-96 rounded-full bg-emerald-400/30 blur-[140px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold">Designed for Kuwait Businesses</h2>
        <p class="mx-auto mt-4 max-w-2xl text-emerald-100">
          QRKuwait is built specifically for Kuwait, considering local workflows, language needs, and business patterns.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
