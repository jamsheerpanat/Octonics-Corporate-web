---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const currentYear = new Date().getFullYear();
const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);
---

<html lang="en">
  <head>
    <title>Blog | Octonics Innovations – AI, Automation & IT Insights from Kuwait</title>
     <meta charset="UTF-8" />
    <meta
      name="description"
      content="Discover insights, news, and articles about AI, automation, smart systems, and IT infrastructure in Kuwait from the experts at Octonics Innovations."
    />
    <meta
      name="keywords"
      content="Octonics Blog Kuwait, AI Automation Blog Kuwait, KNX Kuwait, Smart Home Blog Kuwait, IT Infrastructure Kuwait, Astro Tailwind Blog, Web Development Kuwait"
    />
    <meta property="og:title" content="Octonics Innovations Blog" />
    <meta
      property="og:description"
      content="Expert articles on automation, IT, and AI from Kuwait’s next-generation tech company, Octonics Innovations."
    />
    <meta property="og:image" content="/images/blog-hero.jpg" />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- GLOBAL HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="blog-hero"
      class="relative flex flex-col items-center justify-center text-center text-white py-28 overflow-hidden"
    >
      <div class="absolute inset-0">
        <img
          src="/images/blog-hero.jpg"
          alt="Octonics Innovations Blog Kuwait"
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="relative z-10 px-6 max-w-3xl">
        <h1 class="text-5xl font-extrabold leading-tight sm:text-6xl">
          Insights, Ideas & Innovation
        </h1>
        <p class="mt-4 text-indigo-100">
          Explore thoughts on <strong>AI</strong>, <strong>Automation</strong>,
          <strong>Smart Systems</strong>, and the future of technology in Kuwait.
        </p>
      </div>
    </section>

    <!-- SEARCH & FILTER -->
    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div
        class="mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 rounded-3xl bg-white/80 p-4 shadow-md backdrop-blur-md ring-1 ring-slate-200"
      >
        <input
          id="searchInput"
          type="search"
          placeholder="Search articles..."
          class="w-full sm:w-auto flex-1 rounded-full border border-slate-200 px-5 py-2 text-sm text-slate-700 outline-none focus:ring-2 focus:ring-sky-400"
        />
        <div class="flex items-center gap-2 text-xs text-slate-600">
          <span
            class="px-3 py-1 rounded-full bg-sky-100 text-sky-700 font-medium"
            >#AI</span
          >
          <span
            class="px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 font-medium"
            >#Automation</span
          >
          <span
            class="px-3 py-1 rounded-full bg-purple-100 text-purple-700 font-medium"
            >#Infrastructure</span
          >
        </div>
      </div>
    </section>

    <!-- BLOG GRID -->
    <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
      {posts.length > 0 ? (
        <div
          id="blogGrid"
          class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
        >
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group block rounded-3xl bg-white/90 p-6 shadow-lg ring-1 ring-slate-200 backdrop-blur-md transition hover:-translate-y-1 hover:shadow-2xl"
              data-animate
            >
              {post.data.image && (
                <div class="overflow-hidden rounded-2xl mb-4">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-110"
                    loading="lazy"
                  />
                </div>
              )}
              <h2
                class="text-lg font-semibold text-slate-900 group-hover:text-indigo-600"
              >
                {post.data.title}
              </h2>
              <p class="mt-2 line-clamp-3 text-sm text-slate-600">
                {post.data.description}
              </p>
              <div
                class="mt-3 flex items-center justify-between text-xs text-slate-500"
              >
                <span>
                  {new Date(post.data.pubDate).toLocaleDateString("en-KW", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
                {post.data.category && (
                  <span
                    class="px-2 py-1 rounded-full bg-sky-100 text-sky-700 font-medium"
                  >
                    {post.data.category}
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-500 py-20">
          No blog posts found — stay tuned for upcoming insights.
        </p>
      )}
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />

    <!-- CLIENT-SIDE FILTER SCRIPT -->
    <script is:inline>
      const input = document.getElementById("searchInput");
      const grid = document.getElementById("blogGrid");
      input?.addEventListener("input", (e) => {
        const term = e.target.value.toLowerCase();
        grid?.querySelectorAll("a").forEach((card) => {
          const text = card.textContent.toLowerCase();
          card.style.display = text.includes(term) ? "" : "none";
        });
      });
    </script>
  </body>
</html>