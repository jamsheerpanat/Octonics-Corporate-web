---

<Layout 
  title="Octonics Innovations | KNX Smart Home Automation, DALI Lighting & Software Solutions in Kuwait" 
  description="Kuwait's KNX Certified Smart Home & Smart Lighting Experts. Luxury villa automation, DALI lighting, AI solutions, ERP systems, and modern website development designed for Kuwait. Contact us at +965 9924 0074."
>
  <Header />

  <!-- ============================================================ -->
  <!-- NEXT-GEN HERO SECTION -->
  <!-- ============================================================ -->
  <section
    id="hero"
    class="relative min-h-[100dvh] flex flex-col items-center justify-center overflow-hidden bg-[#030712] pt-20 sm:pt-24 lg:pt-0"
  >
    <!-- Neural Cursor Aura -->
    <div class="cursor-aura js-cursor-aura"></div>

    <!-- Animated Mesh Gradient Background -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Base gradient -->
      <div class="absolute inset-0 bg-gradient-to-br from-[#0F172A] via-[#020617] to-[#0C0A09]"></div>
      
      <!-- Tech Grid Overlay -->
      <div class="tech-grid-overlay opacity-30"></div>
      
      <!-- Animated orbs - Hidden on mobile for performance -->
      <div class="orb orb-1 hidden sm:block"></div>
      <div class="orb orb-2 hidden sm:block"></div>
      <div class="orb orb-3 hidden md:block"></div>
      <div class="orb orb-4 hidden md:block"></div>
      
      <!-- Grid overlay -->
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-60"></div>
      
      <!-- Radial glow center - Smaller on mobile -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[500px] lg:w-[800px] h-[300px] sm:h-[500px] lg:h-[800px] bg-gradient-radial from-sky-500/10 via-indigo-500/5 to-transparent rounded-full blur-3xl"></div>
      
      <!-- Noise texture -->
      <div class="absolute inset-0 opacity-[0.015] bg-[url('data:image/svg+xml;base64,')]"></div>
    </div>

    <!-- Floating Tech Icons - Hidden on mobile -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden hidden lg:block">
      <div class="floating-icon" style="top: 15%; left: 10%; animation-delay: 0s;">
        <div class="icon-glow bg-cyan-500"></div>
        <span class="text-4xl">🧠</span>
      </div>
      <div class="floating-icon" style="top: 25%; right: 15%; animation-delay: -2s;">
        <div class="icon-glow bg-pink-500"></div>
        <span class="text-4xl">🏠</span>
      </div>
      <div class="floating-icon" style="bottom: 30%; left: 8%; animation-delay: -4s;">
        <div class="icon-glow bg-emerald-500"></div>
        <span class="text-4xl">📡</span>
      </div>
      <div class="floating-icon" style="bottom: 20%; right: 10%; animation-delay: -1s;">
        <div class="icon-glow bg-amber-500"></div>
        <span class="text-4xl">☁️</span>
      </div>
      <div class="floating-icon" style="top: 50%; left: 5%; animation-delay: -3s;">
        <div class="icon-glow bg-violet-500"></div>
        <span class="text-4xl">🔐</span>
      </div>
      <div class="floating-icon" style="top: 60%; right: 5%; animation-delay: -5s;">
        <div class="icon-glow bg-rose-500"></div>
        <span class="text-4xl">💡</span>
      </div>
    </div>

    <!-- Particles - Hidden on mobile for performance -->
    <div class="particles hidden sm:block">
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
    </div>

    <!-- Hero Content - HUD Architect Mode -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-0 min-h-screen flex flex-col justify-center">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Text & HUD Control Panel -->
        <div class="order-2 lg:order-1 text-left px-2 sm:px-0">
           <!-- Glass HUD Card -->
           <div class="glass-dark p-6 sm:p-12 rounded-[2rem] sm:rounded-[2.5rem] border border-white/10 shadow-2xl relative overflow-hidden group">

              <!-- Decorative HUD Corner -->
              <div class="absolute top-0 left-0 w-16 h-16 border-t-2 border-l-2 border-cyan-500/50 rounded-tl-3xl"></div>
              <div class="absolute bottom-0 right-0 w-16 h-16 border-b-2 border-r-2 border-indigo-500/50 rounded-br-3xl"></div>
              
              <!-- Animated Badge -->
              <div class="inline-flex items-center gap-3 mb-8 px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 backdrop-blur-md">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                </span>
                <span class="text-[10px] sm:text-xs font-bold text-cyan-400 uppercase tracking-widest">System Intelligence Active</span>
              </div>

              <h1 class="text-white font-black leading-[1.1] mb-6 text-4xl sm:text-5xl md:text-6xl xl:text-7xl">
                Engineering <br/>
                <span class="hero-gradient-text">Intelligence</span>
              </h1>

              <p class="text-base sm:text-xl text-slate-400 leading-relaxed font-light mb-8 sm:mb-10 max-w-xl">
                We design and build the <span class="text-slate-200">digital architecture</span> of the future. From smart environments to custom AI ecosystems—engineered in Kuwait, for the world.
              </p>

              <!-- CTA HUD -->
              <div class="flex flex-col sm:flex-row items-center gap-4">
                <div class="magnetic-wrap w-full sm:w-auto">
                  <a href="#services" class="w-full sm:w-auto group relative inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-cyan-500 text-[#030712] font-bold text-lg transition-all duration-500 hover:scale-105 hover:shadow-[0_0_30px_rgba(6,182,212,0.5)]">
                    Explore Systems
                    <svg class="w-5 h-5 transition-transform group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </div>
                <div class="magnetic-wrap w-full sm:w-auto">
                  <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full border border-white/20 text-white font-bold text-lg backdrop-blur-xl transition-all duration-500 hover:bg-white/10 hover:border-cyan-500/50">
                    Connect
                  </a>
                </div>
              </div>
           </div>
        </div>

        <!-- Central HUD Visualization (The Glass Octo) -->
        <div class="order-1 lg:order-2 relative flex justify-center items-center py-12 lg:py-0">
           <!-- Scanning Rings -->
           <div class="absolute w-[300px] h-[300px] sm:w-[500px] sm:h-[500px] border border-cyan-500/10 rounded-full animate-pulse"></div>
           <div class="absolute w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] border border-indigo-500/10 rounded-full animate-reverse-spin"></div>
           
           <!-- The Center Piece -->
           <div class="relative z-20 w-[240px] sm:w-[450px] perspective-1000">
             <img 
               src="/images/hero_octo_architect.png" 
               alt="Octonics Core" 
               class="w-full h-auto drop-shadow-[0_0_30px_rgba(14,165,233,0.3)] sm:drop-shadow-[0_0_50px_rgba(14,165,233,0.3)] animate-float-slow"
             />
             
             <!-- Floating HUD Labels -->
             <div class="absolute -top-10 -right-10 glass-dark px-4 py-2 border border-cyan-500/30 rounded-lg backdrop-blur-md hidden md:block">
                <span class="text-[10px] font-mono text-cyan-400">CORE_STABLE // 99.9%</span>
             </div>
             <div class="absolute bottom-20 -left-10 glass-dark px-4 py-2 border border-indigo-500/30 rounded-lg backdrop-blur-md hidden md:block">
                <span class="text-[10px] font-mono text-indigo-400">AI_NODES: ACTIVE</span>
             </div>
             <div class="absolute -bottom-5 right-20 glass-dark px-4 py-2 border border-emerald-500/30 rounded-lg backdrop-blur-md hidden md:block">
                <span class="text-[10px] font-mono text-emerald-400">LOC: KUWAIT_CITY</span>
             </div>
           </div>

           <!-- HUD Line Decorations -->
           <div class="absolute top-1/2 -left-20 w-40 hud-line rotate-45 opacity-20 hidden lg:block"></div>
           <div class="absolute bottom-1/4 -right-20 w-40 hud-line -rotate-12 opacity-20 hidden lg:block"></div>
        </div>
      </div>

      <!-- Bottom System Status Bar -->
      <div class="mt-20 border-t border-white/5 pt-8 flex flex-wrap justify-between items-center gap-6 opacity-60">
        <div class="flex items-center gap-8 font-mono text-[10px] tracking-widest text-slate-500">
          <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-cyan-500"></span> KNX CERTIFIED</div>
          <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> AI POWERED</div>
          <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> CLOUD NATIVE</div>
        </div>
        <div class="hidden md:block font-mono text-[10px] text-slate-600 animate-pulse">
          Initializing Octonics Neural Interface... [DONE]
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500 z-20">
      <div class="w-[1px] h-12 bg-gradient-to-b from-cyan-500 to-transparent"></div>
      <span class="text-[10px] uppercase tracking-[0.3em]">Scroll</span>
    </div>

    <!-- Bottom Gradient Fade -->
    <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-slate-50 to-transparent"></div>
  </section>



  <!-- ============================================================ -->
  <!-- TRUSTED PARTNERS - INFINITE SCROLL -->
  <!-- ============================================================ -->


  <!-- ============================================================ -->
  <!-- WHO WE ARE - BENTO GRID -->
  <!-- ============================================================ -->
  <section id="about" class="relative py-24 bg-white overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-sky-50 to-transparent"></div>
    <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-sky-100/50 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-indigo-100/50 blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-6">
      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-xs font-semibold uppercase tracking-[0.15em] text-sky-700 mb-4">
          Who We Are
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">
          The <span class="bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent">8 Intelligent Arms</span> of Technology
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Inspired by the octopus — a creature of intelligence and adaptability — 
          <strong>Octonics Innovations</strong> unites eight verticals of technology under one ecosystem.
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[180px]">
        <!-- Large feature card -->
        <div class="relative col-span-1 md:col-span-2 row-span-2 rounded-3xl p-8 bg-gradient-to-br from-sky-600 to-indigo-700 text-white overflow-hidden group">
          <div class="absolute inset-0 bg-[url('/images/hero-house.jpg')] bg-cover bg-center opacity-20"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-sky-900/80 to-transparent"></div>
          <div class="relative z-10 h-full flex flex-col justify-end">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-xl flex items-center justify-center">
                <img src="/images/brands/knx.png" alt="KNX" class="h-6 w-auto" />
              </div>
              <span class="text-sky-200 text-sm font-medium">Official KNX Partner</span>
            </div>
            <h3 class="text-2xl font-bold mb-2">KNX-Certified Automation</h3>
            <p class="text-sky-100 text-sm leading-relaxed">
              We design, program, and commission complete KNX automation systems for luxury villas and commercial buildings across Kuwait.
            </p>
            <a href="/knx-certification" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-white group-hover:underline">
              View Certifications
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Tech expertise cards -->
        <div class="rounded-3xl p-6 bg-gradient-to-br from-slate-900 to-slate-800 text-white flex flex-col justify-between">
          <div class="text-4xl">🧠</div>
          <div>
            <div class="text-lg font-bold">AI & Machine Learning</div>
            <div class="text-slate-400 text-sm">Predictive Analytics</div>
          </div>
        </div>

        <div class="rounded-3xl p-6 bg-gradient-to-br from-pink-500 to-rose-600 text-white flex flex-col justify-between">
          <div class="text-4xl">📡</div>
          <div>
            <div class="text-lg font-bold">IoT Systems</div>
            <div class="text-pink-100 text-sm">Connected Infrastructure</div>
          </div>
        </div>

        <div class="rounded-3xl p-6 bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex flex-col justify-between">
          <div class="text-4xl">☁️</div>
          <div>
            <div class="text-lg font-bold">Cloud Native</div>
            <div class="text-emerald-100 text-sm">Scalable Architecture</div>
          </div>
        </div>

        <div class="rounded-3xl p-6 bg-gradient-to-br from-amber-500 to-orange-600 text-white flex flex-col justify-between">
          <div class="text-4xl">🔐</div>
          <div>
            <div class="text-lg font-bold">Cybersecurity</div>
            <div class="text-amber-100 text-sm">Enterprise Protection</div>
          </div>
        </div>

        <!-- Mission card -->
        <div class="col-span-1 md:col-span-2 rounded-3xl p-8 bg-gradient-to-r from-slate-100 to-white border border-slate-200">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center text-white text-2xl">
              🚀
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Next-Generation Computing</h3>
              <p class="text-slate-600 leading-relaxed">
                We engineer intelligent environments where automation, AI, and cloud converge — building the digital backbone for Kuwait's future.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-slate-900 text-white font-semibold shadow-xl transition-all duration-300 hover:bg-slate-800 hover:scale-105"
        >
          Learn More About Us
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SERVICES - INTERACTIVE GRID -->
  <!-- ============================================================ -->
  <section id="services" class="relative py-24 bg-gradient-to-b from-slate-50 via-white to-slate-50 overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-sky-200/30 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-72 h-72 rounded-full bg-indigo-200/30 blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-6">
      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="inline-block px-4 py-1.5 rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-xs font-semibold uppercase tracking-[0.15em] text-sky-700 mb-4">
          Our Expertise
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">
          Our <span class="bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent">8 Intelligent Arms</span>
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          From automation to analytics, we engineer fully integrated ecosystems that connect, learn, and evolve.
        </p>
      </div>

