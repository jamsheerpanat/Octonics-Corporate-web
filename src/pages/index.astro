// TECH EXPERTISE
const techExpertise = [
  { name: "KNX Certified", icon: "🏠", desc: "Smart Home & Building Automation" },
  { name: "AI & ML", icon: "🧠", desc: "Machine Learning & Predictive Analytics" },
  { name: "IoT Systems", icon: "📡", desc: "Connected Devices & Sensors" },
  { name: "Cloud Native", icon: "☁️", desc: "Scalable Cloud Architecture" },
  { name: "DALI Lighting", icon: "💡", desc: "Precision Lighting Control" },
