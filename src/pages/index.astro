<script is:inline>
  // Morphing words effect
  const morphWord = document.getElementById('morph-word');
  const words = ['Automation', 'Intelligence', 'Innovation', 'Excellence', 'Engineering', 'Security', 'Connectivity'];
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let isWaiting = false;

  function typeWord() {
    const currentWord = words[wordIndex];
    
    if (isWaiting) {
      setTimeout(typeWord, 1500);
      isWaiting = false;
      isDeleting = true;
      return;
    }

    if (isDeleting) {
      morphWord.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
      
      if (charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
      }
    } else {
      morphWord.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
      
      if (charIndex === currentWord.length) {
        isWaiting = true;
      }
    }
    
    const speed = isDeleting ? 50 : 100;
    setTimeout(typeWord, speed);
  }

  // Start typing effect
  setTimeout(typeWord, 1000);

  // Future-Tech Pack: Neural Cursor & Magnetic HUD
  const cursorAura = document.querySelector('.js-cursor-aura');
  const magneticWraps = document.querySelectorAll('.magnetic-wrap');

  document.addEventListener('mousemove', (e) => {
    if (window.innerWidth < 1024) return;
    
    // Neural Cursor Follow
    if (cursorAura) {
      cursorAura.style.left = `${e.clientX}px`;
      cursorAura.style.top = `${e.clientY}px`;
    }

    // Parallax Tech Icons
    const floatingElements = document.querySelectorAll('.floating-icon');
    const x = (e.clientX / window.innerWidth - 0.5) * 40;
    const y = (e.clientY / window.innerHeight - 0.5) * 40;
    
    floatingElements.forEach((el, i) => {
      const factor = (i + 1) * 0.8;
      el.style.transform = `translate(${x * factor}px, ${y * factor}px) rotate(${x * 0.1}deg)`;
    });

    // Magnetic HUD Interaction
    magneticWraps.forEach(wrap => {
      const rect = wrap.getBoundingClientRect();
      const wrapX = rect.left + rect.width / 2;
      const wrapY = rect.top + rect.height / 2;
      
      const dist = Math.hypot(e.clientX - wrapX, e.clientY - wrapY);
      const activeDist = 100;

      if (dist < activeDist) {
        const moveX = (e.clientX - wrapX) * 0.4;
        const moveY = (e.clientY - wrapY) * 0.4;
        wrap.style.transform = `translate(${moveX}px, ${moveY}px)`;
      } else {
        wrap.style.transform = `translate(0px, 0px)`;
      }
    });
  });

  // Intersection Observer for animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.service-card, .js-reveal').forEach(el => {
    observer.observe(el);
  });
</script>