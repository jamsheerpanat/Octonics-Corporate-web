---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "ERP & Business Software in Kuwait",
  subtitle:
    "Octonics Innovations delivers powerful, modular ERP systems for Kuwait’s modern enterprises — blending AI, automation, and human insight.",
  image: "/images/erp-hero.jpg",
  keywords: [
    "ERP Kuwait",
    "Odoo ERP Customization Kuwait",
    "Business Software Kuwait",
    "AI ERP System",
    "Custom ERP Development Kuwait",
    "Octonics Innovations ERP",
    "Manter ERP Kuwait",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | Octonics Innovations Kuwait</title>
    <meta
      name="description"
      content="Octonics Innovations provides ERP & Business Software solutions in Kuwait — including Odoo ERP customization, custom ERP development, and our own AI-powered Manter ERP system."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta
      property="og:description"
      content="Streamline your operations with Octonics ERP solutions — tailored for Kuwait's evolving business landscape."
    />
    <meta property="og:image" content={service.image} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "ERP & Business Software",
        description:
          "Octonics Innovations offers Odoo ERP customization, custom ERP development, and AI-powered Manter ERP in Kuwait.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>
      <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"></div>
      <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          ERP & Business Software
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          <strong>AI-powered ERP solutions</strong> designed for the next generation
          of business in Kuwait — customizable, modular, and scalable.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          Talk to an ERP Expert →
        </a>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="erp-features" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <h2 class="text-center text-4xl font-extrabold text-slate-900 sm:text-5xl">
        Smart. Scalable. Seamless.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
        Octonics ERP transforms how your teams manage data, people, and performance.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["Real-Time Dashboards", "Get instant visibility into KPIs, sales, and finances — anytime, anywhere."],
          ["Automation Built-In", "Automate repetitive workflows and reduce human error."],
          ["AI Insights", "Predict trends, detect inefficiencies, and optimize business intelligence."],
          ["Cloud & On-Premise", "Flexible hosting — choose Kuwait servers or global cloud providers."],
          ["Modular Design", "Start with what you need and expand as your business grows."],
          ["Multi-Language & Multi-Currency", "Perfect for Kuwait’s diverse business landscape."],
        ].map(([title, desc]) => (
          <div class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300">
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- SUB SERVICES -->
    <section id="subservices" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <div class="grid gap-16 md:grid-cols-3">
        {[
          {
            href: "/services/odoo-erp-customization",
            img: "/images/odoo-custom.png",
            title: "Odoo ERP Customization",
            desc:
              "We customize and deploy Odoo ERP for accounting, inventory, HR, and CRM — fully localized for Kuwait’s business environment.",
            color: "sky",
          },
          {
            href: "/services/custom-erp-development",
            img: "/images/custom-erp.png",
            title: "Custom ERP Development",
            desc:
              "We design bespoke ERP systems that align perfectly with your workflows, automations, and integrations.",
            color: "indigo",
          },
          {
            href: "/services/manter-erp",
            img: "/images/manter-erp.png",
            title: "Manter ERP (by Octonics)",
            desc:
              "Our proprietary AI-powered ERP integrates predictive analytics, automation, and decision intelligence for Kuwait’s enterprises.",
            color: "slate",
          },
        ].map((s) => (
          <a
            href={s.href}
            class={`group block rounded-3xl bg-gradient-to-br from-white to-${s.color}-50 p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-2 hover:shadow-2xl hover:ring-${s.color}-200`}
          >
            <img
              src={s.img}
              alt={s.title}
              loading="lazy"
              class="mx-auto h-20 w-auto group-hover:scale-105 transition"
            />
            <h3 class="mt-6 text-xl font-semibold text-slate-900 group-hover:text-${s.color}-600">
              {s.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
            <p class="mt-4 text-sm font-medium text-${s.color}-600">Learn More →</p>
          </a>
        ))}
      </div>
    </section>

    <!-- MANTER AI -->
    <section class="relative bg-slate-900 py-24 text-white" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 text-center">
        <h2 class="text-3xl font-bold sm:text-4xl">Manter ERP — The Future of Smart Business</h2>
        <p class="mx-auto mt-3 max-w-2xl text-slate-300">
          Manter ERP isn’t just software — it’s your intelligent business assistant.  
          Built with AI and data analytics, it automates, learns, and predicts.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
          {[
            ["🤖 AI Chat Assistant", "Interact with ERP data using natural language queries."],
            ["📈 Predictive Reports", "AI forecasts and data-driven recommendations."],
            ["⚙️ Automation Engine", "Automatically create, update, and monitor workflows in real time."],
          ].map(([icon, desc]) => (
            <div class="group rounded-3xl bg-white/5 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/10">
              <div class="text-3xl mb-3">{icon}</div>
              <p class="text-sm text-slate-300">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-4xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">Let’s Digitize Your Business</h3>
        <p class="mt-3 text-indigo-100">
          Ready to simplify your operations and unlock intelligence across departments?
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          Get a Demo of Manter ERP →
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />

    <!-- FLOATING ERP RIBBON -->


    <script is:inline>
      const badge = document.getElementById("erpBadge");
      window.addEventListener("scroll", () => {
        const showAt = 200;
        if (window.scrollY > showAt) {
          badge.style.opacity = "1";
          badge.style.transform = "translateX(0)";
        } else {
          badge.style.opacity = "0";
          badge.style.transform = "translateX(20px)";
        }
      });
    </script>
  </body>
</html>