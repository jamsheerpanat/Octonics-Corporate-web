---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

const page = {
  title: "Surveillance & Access Control Systems in Kuwait | Octonics Innovations",
  description:
    "Octonics Innovations provides advanced CCTV surveillance, biometric access control, and ANPR-based security systems in Kuwait — designed for villas, offices, and industrial facilities.",
  image: "/images/surveillance/hero-security.jpg",
  keywords: [
    "CCTV Kuwait",
    "Surveillance Kuwait",
    "Access Control Kuwait",
    "Biometric Door Lock Kuwait",
    "Security Systems Kuwait",
    "ANPR Camera Kuwait",
    "Smart Security Kuwait",
    "Time Attendance Kuwait",
    "Face Recognition Kuwait",
    "Octonics CCTV Systems Kuwait",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="keywords" content={page.keywords.join(", ")} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={page.image} />
    <meta property="og:type" content="website" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Surveillance & Access Control Systems",
        description:
          "Octonics Innovations provides AI-powered CCTV, biometric access control, and ANPR-based security systems across Kuwait — for villas, offices, and commercial spaces.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        serviceType: "CCTV, Access Control, Security Systems",
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={page.image}
          alt={page.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          Surveillance & Access Control Systems in Kuwait
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          Protect your villa, office, or industrial facility with
          <strong>AI-powered CCTV and biometric access systems</strong> —
          engineered by Octonics Innovations for reliability and real-time awareness.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          Request Site Survey →
        </a>
      </div>
    </section>

    <!-- SOLUTIONS OVERVIEW -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
          Integrated Security & Access Solutions
        </h2>
        <p class="mt-3 max-w-2xl mx-auto text-slate-600">
          Our systems unify surveillance, access, and analytics — giving you total visibility and control from a single platform.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["🎥 IP CCTV Surveillance", "4K IP cameras with night vision, motion detection, and AI object recognition for precise monitoring."],
          ["🔐 Biometric Access Control", "Face, fingerprint, or RFID entry with time attendance and visitor management integration."],
          ["🚗 ANPR & Gate Automation", "Automatic Number Plate Recognition for vehicle entry and smart parking management."],
          ["🧠 AI Video Analytics", "Detect intrusion, crowd density, and anomalies in real time with cloud-based alerting."],
          ["🏢 Unified Security Platform", "Integrate CCTV, access, fire, and alarm systems into a single monitoring dashboard."],
          ["📡 Remote Cloud Monitoring", "Access live feeds, logs, and playback from anywhere using mobile or web dashboards."],
        ].map(([title, desc]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ADVANCED SECURITY INTEGRATION -->
    <section
      class="relative bg-gradient-to-r from-indigo-700 to-sky-700 py-24 text-white"
      data-animate
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">
          Integrated Intelligence for Safer Spaces
        </h3>
        <p class="mt-3 max-w-3xl mx-auto text-indigo-100">
          Our AI-driven systems go beyond surveillance — integrating sensors, automation, and analytics for proactive protection.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
          {[
            ["🌡️ Climate-Resistant Hardware", "IP66-rated cameras and readers built for Kuwait’s heat and dust conditions."],
            ["⚙️ Smart Automation Sync", "Trigger lighting, alarms, or access gates automatically using KNX or RTI integration."],
            ["📲 Real-Time Notifications", "Get instant mobile alerts and cloud backup for every security event or access breach."],
          ].map(([title, desc]) => (
            <div class="rounded-3xl bg-white/10 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold">{title}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VISUALIZATION & CONTROL -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <figure>
          <img
            src="/images/surveillance/control-center.jpg"
            alt="Security Control Kuwait"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Centralized Security Control
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Manage every camera, door, and alarm from a single RTI or web interface — real-time status,
            analytics, and reports at your fingertips.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• Unified dashboards for CCTV, access, and fire systems</li>
            <li>• AI-powered incident detection and automated responses</li>
            <li>• Cloud or on-premise deployment options</li>
            <li>• Integration with smart lighting and HVAC control</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE OCTONICS -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-animate>
      <h3 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">
        Why Choose Octonics Security Systems
      </h3>
      <p class="mx-auto mt-4 max-w-2xl text-center text-slate-600">
        From consultation to installation and lifetime support, we ensure every security system is built with precision and reliability.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {[
          ["Certified Engineers", "Specialized in AI-enabled security, CCTV, and access systems with industry certifications."],
          ["Premium Brands", "Partnerships with Hikvision, Dahua, Suprema, ZKTeco, and RTI for high-performance reliability."],
          ["Local Expertise", "Based in Kuwait — offering on-site support, maintenance, and long-term system care."],
        ].map(([title, desc]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <h4 class="text-xl font-semibold text-indigo-700">{title}</h4>
            <p class="mt-2 text-slate-600 text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center">
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">
          Secure. Smart. Seamless.
        </h3>
        <p class="mt-3 text-indigo-100">
          Protect what matters most with Octonics Innovations — Kuwait’s trusted partner for
          <strong>AI-powered CCTV, Access Control, and Security Systems.</strong>
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          Book a Security Consultation →
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />
  </body>
</html>