---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "Odoo ERP Customization in Kuwait",
  subtitle:
    "Tailor-made Odoo ERP solutions for businesses in Kuwait — fully localized, automated, and scalable.",
  image: "/images/odoo-erp-kuwait.jpg",
  keywords: [
    "Odoo ERP Kuwait",
    "Odoo Customization Kuwait",
    "ERP Implementation Kuwait",
    "Odoo Partner Kuwait",
    "Octonics Innovations Odoo",
    "Business Software Kuwait",
    "Odoo ERP Modules",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | Octonics Innovations Kuwait</title>
    <meta
      name="description"
      content="Octonics Innovations delivers advanced Odoo ERP Customization in Kuwait — local modules, Arabic support, automation, and AI integration for seamless business operations."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta property="og:image" content={service.image} />
    <meta
      property="og:description"
      content="We customize Odoo ERP for accounting, sales, HR, CRM, and manufacturing — localized for Kuwait's business needs."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Odoo ERP Customization",
        description:
          "Custom Odoo ERP development and implementation in Kuwait — with localization, automation, and AI integration.",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        areaServed: "Kuwait",
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>
      <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"></div>
      <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          Odoo ERP Customization
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          Simplify your operations with <strong>localized Odoo ERP</strong> — accounting, HR, CRM, and
          manufacturing tailored for Kuwait.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
          >Talk to an Odoo Expert →</a
        >
      </div>
    </section>

    <!-- WHY ODOO -->
    <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6" data-animate>
      <div class="text-center">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
          Why Choose Odoo ERP?
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-slate-600">
          Odoo is the world’s most flexible open-source ERP platform — empowering enterprises with 30+
          integrated business apps.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["Accounting & Finance", "Automate invoicing, reconciliation, and tax compliance."],
          ["Human Resources", "Manage attendance, payroll, and recruitment effortlessly."],
          ["Sales & CRM", "Track leads, quotations, and clients from anywhere."],
          ["Inventory & Manufacturing", "Control warehouses, production, and supply chain flow."],
          ["Project Management", "Plan, collaborate, and track deliverables with clarity."],
          ["E-Commerce & POS", "Unify your online and retail experience with one platform."],
        ].map(([title, desc]) => (
          <div
            class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300"
          >
            <div
              class="absolute inset-0 -z-10 rounded-3xl bg-gradient-to-r from-sky-200/20 to-indigo-200/20 opacity-0 transition group-hover:opacity-100"
            ></div>
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- LOCALIZATION & AUTOMATION -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-24 text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">Localized for Kuwait</h3>
        <p class="mx-auto mt-4 max-w-2xl text-indigo-100">
          We customize Odoo ERP modules for <strong>Kuwait VAT</strong>, <strong>Arabic language</strong>,
          and <strong>local labor law compliance</strong> — ensuring a flawless experience for your
          operations and teams.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {[
            ["🇰🇼 Arabic Interface", "Full Arabic UI translation and RTL support."],
            ["💰 VAT & Invoicing", "Kuwait-compliant taxation and accounting modules."],
            ["⚙️ Workflow Automation", "AI workflows that automate daily processes."],
          ].map(([icon, desc]) => (
            <div class="rounded-3xl bg-white/10 p-6 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <div class="text-2xl mb-2">{icon}</div>
              <p class="text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- AI & INTEGRATIONS -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Extend Odoo with AI & Smart Integrations
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Octonics integrates Odoo ERP with AI-powered dashboards, KNX home automation data, and IoT
            sensors — bridging operational and environmental intelligence.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>🤖 AI-driven analytics and dashboards</li>
            <li>🌐 Integration with KNX, DALI, and IoT systems</li>
            <li>📊 Business performance prediction and alerts</li>
            <li>🔗 RESTful API & Odoo cloud sync</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/odoo-ai.jpg"
            alt="Odoo AI Integration"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-16 text-white text-center">
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">Let’s Build Your Odoo Ecosystem</h3>
        <p class="mt-3 text-indigo-100">
          From small teams to enterprises — Octonics customizes Odoo ERP for Kuwait’s unique business
          landscape.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
          >Get a Free Consultation →</a
        >
      </div>
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />



    <script is:inline>
      const badge = document.getElementById("odooBadge");
      window.addEventListener("scroll", () => {
        badge.style.opacity = window.scrollY > 200 ? "1" : "0";
        badge.style.transform = window.scrollY > 200 ? "translateX(0)" : "translateX(20px)";
      });
    </script>
  </body>
</html>