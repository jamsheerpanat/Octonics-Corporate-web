---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TechComparison from "../../components/TechComparison.astro";
import SystemFlow from "../../components/SystemFlow.astro";

const currentYear = new Date().getFullYear();

const page = {
  title:
    "Smart Home & Building Automation Systems in Kuwait | KNX, Zigbee, Wi-Fi, RTI",
  description:
    "Octonics Innovations — Kuwait’s trusted KNX-Certified integrators delivering premium wired and wireless smart automation systems. KNX, Zigbee, Z-Wave, Wi-Fi, and RTI visualization for villas, offices, and commercial spaces.",
  image: "/images/smart-home-kuwait.jpg",
  keywords: [
    "Smart Home Kuwait",
    "Home Automation Kuwait",
    "KNX Automation Kuwait",
    "Wireless Automation Kuwait",
    "Zigbee Kuwait",
    "Z-Wave Kuwait",
    "Wi-Fi Automation Kuwait",
    "RTI Control Kuwait",
    "Building Automation Kuwait",
    "Smart Villa Kuwait",
    "Smart Lighting Kuwait",
    "Octonics Smart Systems Kuwait",
  ],
};
---

<html lang="en">
  <head>
  <meta charset="UTF-8" />

  <!-- ======================== -->
  <!-- 🔥 PRIMARY TITLE + DESC -->
  <!-- ======================== -->
  <title>Smart Home Automation Kuwait | KNX, Zigbee, Z-Wave, Wi-Fi, RTI | Octonics Innovations</title>

  <meta name="description" content="Kuwait's KNX-Certified Smart Home & Building Automation experts. Wired KNX, DALI lighting, and wireless Zigbee, Z-Wave, Wi-Fi automation for villas & commercial buildings. Designed by certified automation engineers at Octonics Innovations.">

  <!-- ======================== -->
  <!-- 🔥 MAXIMUM KEYWORDS -->
  <!-- ======================== -->
  <meta name="keywords" content="
    Smart Home Kuwait,
    KNX Kuwait,
    KNX Automation Kuwait,
    DALI Kuwait,
    Smart Lighting Kuwait,
    Smart Villa Kuwait,
    Building Automation Kuwait,
    Zigbee Kuwait,
    Z-Wave Kuwait,
    Wi-Fi Automation Kuwait,
    RTI Kuwait,
    Smart Home Integrators Kuwait,
    Home Automation Designers Kuwait,
    Certified KNX Engineers Kuwait,
    Luxury Villa Automation Kuwait,
    Smart Sensors Kuwait,
    Smart Switches Kuwait,
    Wireless Smart Home Kuwait,
    Hybrid KNX Systems Kuwait,
    Best Smart Home Company Kuwait,
    Octonics Smart Home Kuwait
  ">

  <!-- ======================== -->
  <!-- 🔥 ARABIC SEO -->
  <!-- ======================== -->
  <meta name="description" lang="ar" content="أوكتونيكس — أفضل شركة سمارت هوم في الكويت. حلول KNX السلكية وZigbee وZ-Wave وWi-Fi للفلل والمباني الذكية. برمجة KNX احترافية، إضاءة DALI، وتحكم مركزي RTI.">

  <!-- ======================== -->
  <!-- GEO & CONTACT META -->
  <!-- ======================== -->
  <meta name="geo.region" content="KW" />
  <meta name="geo.position" content="29.346069262076877;48.01252801196281" />
  <meta name="ICBM" content="29.346069262076877, 48.01252801196281" />
  <meta name="contact.phone" content="+96599240074" />
  <meta name="contact.email" content="info@octonics.com" />

  <!-- ======================== -->
  <!-- OPEN GRAPH -->
  <!-- ======================== -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Smart Home Automation Kuwait | KNX + Zigbee + Wi-Fi | Octonics" />
  <meta property="og:description" content="Certified KNX, DALI2, Zigbee, Wi-Fi and RTI automation for villas & commercial buildings in Kuwait. Designed by certified automation engineers." />
  <meta property="og:image" content={page.image} />
  <meta property="og:locale" content="en_KW" />
  <meta property="og:locale:alternate" content="ar_KW" />

  <!-- ======================== -->
  <!-- TWITTER -->
  <!-- ======================== -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Smart Home Automation Kuwait | Octonics Innovations" />
  <meta name="twitter:description" content="Wired KNX + wireless Zigbee/Z-Wave/Wi-Fi automation systems for Kuwait homes & offices." />
  <meta name="twitter:image" content={page.image} />

  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- ======================== -->
  <!-- 🔥 STACKED JSON-LD (BEST PRACTICE) -->
  <!-- ======================== -->

  <!-- ORGANIZATION -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Octonics Innovations",
      "url": "https://octonics.com",
      "logo": "https://octonics.com/images/octonics-logo.png",
      "telephone": "+96599240074",
      "email": "info@octonics.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Hawally",
        "addressCountry": "KW"
      },
      "sameAs": [
        "https://www.instagram.com/octonics.global",
        "https://www.linkedin.com/company/octonicskw",
        "https://www.facebook.com/octonics"
      ]
    }
  </script>

  <!-- SMART HOME SERVICE -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Smart Home Automation",
      "name": "Smart Home Automation Systems in Kuwait",
      "provider": {
        "@type": "Organization",
        "name": "Octonics Innovations"
      },
      "areaServed": "Kuwait",
      "description": "Wired KNX automation, DALI lighting, Zigbee & Z-Wave wireless automation, Wi-Fi smart systems, and RTI control for villas and commercial buildings in Kuwait.",
      "image": "https://octonics.com/images/smart-home-kuwait.jpg"
    }
  </script>

  <!-- LOCAL BUSINESS -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Octonics Innovations",
      "telephone": "+96599240074",
      "image": "https://octonics.com/images/smart-home-kuwait.jpg",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 29.346069262076877,
        "longitude": 48.01252801196281
      },
      "url": "https://octonics.com"
    }
  </script>

  <!-- Existing styles untouched -->
</head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={page.image}
          alt={page.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          Smart Automation Systems in Kuwait
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          Elevate your home or business with <strong>AI-ready automation</strong> that blends luxury,
          intelligence, and reliability. From <strong>Wired KNX</strong> to <strong>Wireless Zigbee,
          Wi-Fi, and Z-Wave</strong>, Octonics Innovations builds systems that think with you.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          Schedule Your Consultation →
        </a>
      </div>
    </section>

    <!-- ABOUT SMART AUTOMATION -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Intelligent Living, Designed in Kuwait
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Octonics Innovations delivers next-generation automation that enhances comfort,
            efficiency, and security. As a <strong>KNX Certified Partner</strong>, we follow the
            world’s most stable and scalable automation standard while also implementing
            <strong>wireless technologies</strong> for flexible retrofits and modern architecture.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• KNX/DALI Lighting, Dimming & Climate Control</li>
            <li>• Smart Security Cameras, Door Access & Sensors</li>
            <li>• Multi-Room Audio & Video Matrix Integration</li>
            <li>• Voice & App-based Controls (Alexa, Google, Siri)</li>
            <li>• RTI Visualization for centralized user control</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/smart-luxury-villa.jpg"
            alt="Smart Home Kuwait"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-2 text-xs text-slate-500">
            Luxury villa in Kuwait equipped with KNX, DALI lighting, and RTI control interface.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- WIRED KNX AUTOMATION -->
    <section class="relative bg-gradient-to-r from-indigo-700 to-sky-700 py-24 text-white" data-animate>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">Wired KNX Automation</h3>
        <p class="mt-3 max-w-3xl mx-auto text-indigo-100">
          KNX represents the most reliable foundation for smart homes and buildings.
          Engineered in Europe, trusted worldwide, and backed by more than 500 global brands,
          KNX ensures interoperability and long-term stability.
        </p>
        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
          {[
            ["Lighting & Dimming", "DALI2-based intelligent lighting that adapts to scenes, daylight, and motion."],
            ["Climate & Energy", "Optimized air conditioning and heating with energy-saver algorithms."],
            ["Sensors & Logic", "Automate your lifestyle with weather, motion, and occupancy triggers."],
          ].map(([title, desc]) => (
            <div class="rounded-3xl bg-white/10 p-8 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold">{title}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WIRELESS AUTOMATION -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <figure>
          <img
            src="/images/wireless-smart-home.jpg"
            alt="Wireless Automation Kuwait"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Wireless Automation: Freedom Without Rewiring
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            In Kuwait’s existing villas and apartments, rewiring is often impractical.
            Octonics provides advanced <strong>wireless automation</strong> solutions
            built on <strong>Wi-Fi</strong>, <strong>Zigbee</strong>, and <strong>Z-Wave</strong>
            standards — enabling modern control with minimal installation effort.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>• Retrofit-friendly for existing homes and offices</li>
            <li>• App, remote, and voice control integration</li>
            <li>• Expandable with smart sensors, switches, and relays</li>
            <li>• Fully compatible with KNX hybrid systems</li>
            <li>• Designed for long-term stability in Kuwait’s climate</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- RTI CONTROL -->
    <section class="relative bg-gradient-to-r from-slate-900 to-indigo-900 py-24 text-white" data-animate>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 grid md:grid-cols-2 items-center gap-12">
        <div>
          <h2 class="text-3xl font-bold sm:text-4xl">RTI Control & Visualization</h2>
          <p class="mt-4 text-indigo-100 leading-relaxed">
            RTI (Remote Technologies Inc.) is the premium choice for seamless smart home visualization.
            Octonics engineers design and program custom RTI interfaces that unite all your systems
            — lighting, AV, HVAC, security, and more — into one elegant dashboard.
          </p>
          <ul class="mt-6 space-y-3 text-indigo-100">
            <li>• Unified control for KNX, Audio/Video, HVAC, and Security</li>
            <li>• Tailor-made RTI GUI for iPad, wall panel, or mobile</li>
            <li>• Integration with Sonos, CasaTunes, Spotify, and Apple Music</li>
            <li>• Video matrix switching for cinemas and lounges</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/rti-interface.jpg"
            alt="RTI Control Kuwait"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-700"
          />
        </figure>
      </div>
    </section>

    <!-- TECH COMPARISON -->
    <div class="bg-slate-50">
      <TechComparison />
    </div>

    <!-- SYSTEM FLOW -->
    <div class="bg-white">
      <SystemFlow />
    </div>

    <!-- BENEFITS -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6" data-animate>
      <h3 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">
        Why Choose Octonics Smart Automation
      </h3>
      <p class="mx-auto mt-4 max-w-2xl text-center text-slate-600">
        A system is only as good as the expertise behind it. Octonics Innovations combines
        certified engineering, premium products, and decades of IT experience to deliver
        a truly future-proof automation ecosystem.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {[
          ["Certified Expertise", "Official KNX-Certified engineers trained in wired and wireless automation design."],
          ["Global Brands", "Partnerships with Theben, Jung, RTI, CasaTunes, and other international automation leaders."],
          ["Local Support", "Based in Kuwait with dedicated on-site installation and maintenance support."],
        ].map(([title, desc]) => (
          <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <h4 class="text-xl font-semibold text-indigo-700">{title}</h4>
            <p class="mt-2 text-slate-600 text-sm">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center">
      <div class="mx-auto max-w-4xl px-4" data-animate>
        <h3 class="text-3xl font-bold sm:text-4xl">
          Let’s Build Kuwait’s Smartest Homes Together
        </h3>
        <p class="mt-3 text-indigo-100">
          Experience automation that’s stable, intelligent, and effortless.
          Whether you need wired KNX for a villa or wireless Zigbee for an office,
          Octonics Innovations delivers <strong>“install and forget”</strong> reliability.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          Book a Free Automation Consultation →
        </a>
      </div>
    </section>

<!-- ============================================================ -->
<!-- 🔥 SEO CONTENT BLOCK (ENGLISH) -->
<!-- ============================================================ -->
<section class="max-w-5xl mx-auto px-6 py-20 text-slate-700 leading-relaxed">
  <h2 class="text-3xl font-bold mb-6">Smart Home & Building Automation in Kuwait</h2>

  <p class="mb-4 text-lg">
    Octonics Innovations is Kuwait’s leading provider of <strong>KNX Certified Smart Home Automation</strong>,
    delivering advanced wired and wireless solutions including <strong>Zigbee, Z-Wave, Wi-Fi, and RTI</strong>.
    Our automation engineers build intelligent systems for villas, penthouses, apartments, offices,
    retail spaces, and commercial buildings.
  </p>

  <p class="mb-4 text-lg">
    With KNX as the backbone, and Zigbee/Wi-Fi as flexible retrofit options, Octonics designs hybrid systems
    that combine stability, luxury, and intelligent control tailored for Kuwait’s climate and electrical standards.
  </p>

  <h3 class="text-2xl font-semibold mt-8 mb-4">Our Smart Automation Expertise</h3>
  <ul class="list-disc pl-6 space-y-2 text-lg">
    <li>Wired KNX automation for lighting, HVAC & shading</li>
    <li>DALI2 smart lighting design with scene control</li>
    <li>Wireless Zigbee, Z-Wave & Wi-Fi retrofit systems</li>
    <li>RTI control interfaces for unified dashboards</li>
    <li>Smart AV, multiroom audio, video matrixing</li>
    <li>Hybrid KNX + Wireless automation architecture</li>
    <li>Full home design, BOM, panel and commissioning</li>
  </ul>
</section>

<!-- ============================================================ -->
<!-- 🔥 SEO CONTENT BLOCK (ARABIC) -->
<!-- ============================================================ -->
<section class="max-w-5xl mx-auto px-6 py-16 bg-slate-100 rounded-xl" dir="rtl">
  <h2 class="text-3xl font-bold mb-6 text-right">أفضل أنظمة سمارت هوم في الكويت</h2>

  <p class="text-lg mb-4 text-right">
    أوكتونيكس تقدّم حلولاً متقدمة للمنزل الذكي باستخدام <strong>KNX</strong> السلكي،
    وتقنيات Zigbee وZ-Wave وWi-Fi للمباني والفلل القائمة بدون تكسير أو تمديد جديد.
  </p>

  <p class="text-lg mb-4 text-right">
    لدينا مهندسين معتمدين في KNX يقدمون برمجة احترافية، مخططات هندسية،  
    وتصميم أنظمة إضاءة DALI2 ومركزية RTI—مصممة لتناسب المنازل الكويتية.
  </p>
</section>

    <!-- FOOTER -->
    <Footer year={currentYear} />
  </body>
</html>