---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

const frameworks = [
  "ISO 27001:2022 Information Security",
  "NIST Cybersecurity Framework",
  "SOC 2 Type II & ITGC Controls",
  "GDPR & Kuwait Data Protection",
  "Zero-Trust Architecture",
  "Business Continuity & DR Planning",
];

const offerings = [
  {
    icon: "🛡️",
    title: "Cybersecurity Assessment & Hardening",
    desc: "Comprehensive audits across infrastructure, endpoints, and applications. We evaluate vulnerabilities, misconfigurations, and compliance readiness — aligned with NIST and ISO 27001 frameworks.",
  },
  {
    icon: "🔒",
    title: "Zero-Trust & Identity Security",
    desc: "We design secure access models using SSO, MFA, network segmentation, and least-privilege policies that protect cloud and on-premise assets.",
  },
  {
    icon: "📊",
    title: "Governance, Risk & Compliance (GRC)",
    desc: "Automated GRC dashboards for policy tracking, control mapping, and audit management. Generate instant reports for ISO, NCA, and corporate board reviews.",
  },
  {
    icon: "🤖",
    title: "AI-Driven Threat Analytics",
    desc: "Behavioral detection, UEBA, SIEM correlation, and ML-based anomaly detection using modern SOC toolchains.",
  },
  {
    icon: "🧠",
    title: "Security Awareness & Training",
    desc: "Phishing simulations, digital-hygiene campaigns, and IT policy workshops crafted for Kuwait’s enterprise landscape.",
  },
  {
    icon: "🌐",
    title: "Incident Response & Forensics",
    desc: "24×7 incident response and digital forensics with post-event governance documentation.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>IT Governance & Cybersecurity Kuwait | Octonics Innovations</title>
    <meta
      name="description"
      content="Octonics Innovations offers cybersecurity, governance, compliance and risk management services in Kuwait — ISO 27001 audits, Zero-Trust, SOC, and AI threat analytics for enterprises."
    />
    <meta
      name="keywords"
      content="Cybersecurity Kuwait, IT Governance Kuwait, ISO 27001 Kuwait, SOC 2 Kuwait, NIST Kuwait, Zero Trust Kuwait, GRC Kuwait, Vulnerability Assessment Kuwait, Incident Response Kuwait"
    />
    <meta property="og:title" content="IT Governance & Cybersecurity Kuwait | Octonics Innovations" />
    <meta
      property="og:description"
      content="Protect your enterprise with AI-driven cybersecurity, compliance frameworks, and IT governance programs from Octonics Innovations in Kuwait."
    />
    <meta property="og:image" content="/images/cyber/og-cyber.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "IT Governance & Cybersecurity",
        description:
          "Octonics Innovations provides cybersecurity, IT governance, and GRC services in Kuwait, aligned with ISO 27001, NIST, and Zero-Trust frameworks.",
        areaServed: "Kuwait",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- ===== HEADER ===== -->
    <Header />

    <!-- ===== HERO ===== -->
    <section
      id="hero"
      class="relative isolate min-h-[90vh] flex items-center justify-center text-center overflow-hidden text-white"
    >
      <img
        src="/images/cyber/hero-cyber.jpg"
        alt="Cybersecurity Kuwait"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/80 via-indigo-950/70 to-slate-900/90"></div>
      <div class="absolute -top-24 -left-24 h-64 w-64 rounded-full bg-sky-400/20 blur-3xl"></div>
      <div class="absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-indigo-500/20 blur-3xl"></div>

      <div class="relative z-10 max-w-4xl px-4 sm:px-6" data-animate>
        <p
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs ring-1 ring-white/20"
        >
          Cybersecurity • Governance • Risk • Compliance
        </p>
        <h1 class="mt-5 text-5xl font-extrabold leading-tight sm:text-6xl">
          IT Governance & Cybersecurity in Kuwait
        </h1>
        <p class="mt-4 text-indigo-100">
          Building resilient, compliant, and intelligent IT ecosystems through governance, Zero-Trust, and AI-driven defense models.
        </p>

        <a
          href="/#contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
        >
          Request Audit →
        </a>
      </div>
    </section>

    <!-- ===== FRAMEWORKS ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 text-center" data-animate>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Compliance & Framework Expertise</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Octonics ensures that every governance implementation aligns with global and local security frameworks.
      </p>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
        {frameworks.map((fw) => (
          <div class="rounded-2xl bg-white p-4 text-sm font-semibold text-slate-700 shadow ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg">
            {fw}
          </div>
        ))}
      </div>
    </section>

    <!-- ===== OFFERINGS ===== -->
    <section id="offerings" class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <h2 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">
        Our Cybersecurity & GRC Services
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
        From compliance frameworks to real-time SOC visibility — Octonics delivers full lifecycle protection.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {offerings.map((o) => (
          <article class="group rounded-3xl bg-white p-6 shadow-lg ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-2xl">
            <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-sky-50 to-indigo-50 text-indigo-600 ring-1 ring-slate-100">{o.icon}</div>
            <h3 class="text-lg font-semibold text-slate-900">{o.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{o.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== DIFFERENTIATORS ===== -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" data-animate>
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Governance That Builds Confidence</h2>
          <p class="mt-4 text-slate-600">
            Our governance programs bridge the gap between compliance checklists and real-world resilience —
            empowering your IT leadership with actionable visibility.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li>• Automated risk register with continuous compliance scoring</li>
            <li>• Board-ready reports aligned with Kuwait regulators and auditors</li>
            <li>• Integration with ERP and ITSM for control evidence tracking</li>
            <li>• Cloud posture monitoring (Azure, AWS, GCP) with policy drift alerts</li>
          </ul>
        </div>
        <figure class="relative">
          <img
            src="/images/cyber/governance-dashboard.jpg"
            alt="GRC Dashboard Kuwait"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
          <figcaption class="mt-2 text-xs text-slate-500 text-center">
            Example: automated GRC dashboard with real-time compliance mapping.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-20 text-white" data-animate>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
        <h2 class="text-3xl font-bold sm:text-4xl">
          Let’s Build Your Cyber Resilience Roadmap
        </h2>
        <p class="mt-3 max-w-2xl mx-auto text-indigo-100">
          Schedule an IT governance assessment to identify gaps, risks, and regulatory compliance status.
        </p>
        <a
          href="/#contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
        >
          Request Consultation →
        </a>
      </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <Footer year={currentYear} />



    <script is:inline>
      const badge = document.getElementById("cyberBadge");
      window.addEventListener("scroll", () => {
        const showAt = 200;
        if (window.scrollY > showAt) {
          badge.style.opacity = "1";
          badge.style.transform = "translateX(0)";
        } else {
          badge.style.opacity = "0";
          badge.style.transform = "translateX(20px)";
        }
      });
    </script>
  </body>
</html>