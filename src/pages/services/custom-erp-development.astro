---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "Custom ERP Development in Kuwait",
  subtitle:
    "We build tailor-made ERP systems designed around your business — not the other way around.",
  image: "/images/custom-erp-kuwait.jpg",
  keywords: [
    "Custom ERP Development Kuwait",
    "ERP Software Kuwait",
    "Business Management Software Kuwait",
    "AI ERP Kuwait",
    "Octonics Custom ERP",
    "Enterprise Software Kuwait",
    "Tailored ERP System Kuwait",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | Octonics Innovations Kuwait</title>
    <meta
      name="description"
      content="Octonics Innovations develops fully customized ERP systems in Kuwait — built for finance, HR, manufacturing, and logistics with AI and automation features."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta property="og:image" content={service.image} />
    <meta
      property="og:description"
      content="Custom ERP development in Kuwait — design, automation, and integration crafted for your exact business workflows."
    />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Custom ERP Development",
        description:
          "Bespoke ERP design and implementation for businesses in Kuwait, powered by AI and automation.",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        areaServed: "Kuwait",
      })}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>
      <div
        class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"
      ></div>
      <div
        class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"
      ></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          Custom ERP Development
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          When off-the-shelf ERP doesn’t fit — we build <strong>exactly</strong> what your business needs.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
          >Request a Free Demo →</a
        >
      </div>
    </section>

    <!-- WHY CUSTOM ERP -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <div class="text-center">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
          Why Build a Custom ERP?
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-slate-600">
          A customized ERP gives your company <strong>control, scalability, and precision</strong> — crafted around your workflows, not generic templates.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["Tailored Modules", "Every feature, report, and dashboard is built for your department’s exact needs."],
          ["Seamless Integrations", "Connect finance, HR, CRM, and production under one smart ecosystem."],
          ["AI-Powered Insights", "Predictive analytics and performance alerts to guide smarter decisions."],
          ["Cloud or On-Premise", "Host on your infrastructure or Octonics-managed secure cloud in Kuwait."],
          ["Scalable Architecture", "Built to grow with your workforce and evolving business strategy."],
          ["Bilingual Interface", "Arabic & English interface with full RTL support for Kuwait’s market."],
        ].map(([title, desc]) => (
          <div
            class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300"
          >
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- DEVELOPMENT PROCESS -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-24 text-white" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">Our ERP Development Process</h3>
        <p class="mt-3 max-w-2xl mx-auto text-indigo-100">
          Transparent, agile, and collaborative — ensuring a perfect fit for your organization.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-4">
          {[
            ["Discovery", "We analyze workflows, goals, and bottlenecks."],
            ["Design", "We create UI/UX and database architecture tailored to your needs."],
            ["Development", "Agile build with testing and iterative validation."],
            ["Deployment", "Seamless rollout, user training, and continuous support."],
          ].map(([step, desc]) => (
            <div class="rounded-3xl bg-white/10 p-6 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold text-white">{step}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- AI FEATURES -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Smarter ERP with Built-in AI
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Our ERP platforms integrate <strong>AI-driven automation</strong> for smarter approvals, real-time alerts, and predictive insights.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>🤖 Automated data entry & reconciliation</li>
            <li>📊 Predictive sales and purchase analytics</li>
            <li>🧠 AI chatbot for instant ERP commands</li>
            <li>🔔 Anomaly detection & alert automation</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/ai-dashboard.jpg"
            alt="AI-powered ERP Dashboard"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-4xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">Build Your Intelligent ERP System</h3>
        <p class="mt-3 text-indigo-100">
          Let’s design a system that thinks like your business — faster, smarter, and tailored.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
          >Schedule a Consultation →</a
        >
      </div>
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />

    <!-- FLOATING RIBBON -->


    <script is:inline>
      const badge = document.getElementById("erpBadge");
      window.addEventListener("scroll", () => {
        const showAt = 200;
        if (window.scrollY > showAt) {
          badge.style.opacity = "1";
          badge.style.transform = "translateX(0)";
        } else {
          badge.style.opacity = "0";
          badge.style.transform = "translateX(20px)";
        }
      });
    </script>
  </body>
</html>