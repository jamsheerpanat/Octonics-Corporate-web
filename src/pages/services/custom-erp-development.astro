---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const currentYear = new Date().getFullYear();

const service = {
  title: "Custom ERP Development in Kuwait",
  subtitle:
    "We build tailor-made ERP systems designed around your business — not the other way around.",
  image: "/images/custom-erp-kuwait.jpg",
  keywords: [
    "Custom ERP Development Kuwait",
    "ERP Software Kuwait",
    "Business Management Software Kuwait",
    "AI ERP Kuwait",
    "Octonics Custom ERP",
    "Enterprise Software Kuwait",
    "Tailored ERP System Kuwait",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{service.title} | Octonics Innovations Kuwait</title>
    <meta
      name="description"
      content="Octonics Innovations develops fully customized ERP systems in Kuwait — built for finance, HR, manufacturing, and logistics with AI and automation features."
    />
    <meta name="keywords" content={service.keywords.join(", ")} />
    <meta property="og:title" content={service.title} />
    <meta property="og:image" content={service.image} />
    <meta
      property="og:description"
      content="Custom ERP development in Kuwait — design, automation, and integration crafted for your exact business workflows."
    />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Custom ERP Development",
        description:
          "Bespoke ERP design and implementation for businesses in Kuwait, powered by AI and automation.",
        provider: {
          "@type": "Organization",
          name: "Octonics Innovations",
          url: "https://octonics.com",
        },
        areaServed: "Kuwait",
      })}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden relative">
    <!-- HEADER -->
    <Header />

    <!-- HERO -->
    <section
      id="hero"
      class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden text-center text-white"
    >
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.title}
          loading="lazy"
          class="h-full w-full object-cover opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-indigo-900/80 to-sky-900/70"></div>
      </div>
      <div
        class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-sky-400/30 blur-3xl"
      ></div>
      <div
        class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"
      ></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4" data-animate>
        <h1 class="text-5xl font-extrabold leading-tight sm:text-7xl">
          Custom ERP Development
        </h1>
        <p class="mt-4 text-lg text-indigo-100">
          When off-the-shelf ERP doesn’t fit — we build <strong>exactly</strong> what your business needs.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
          >Request a Free Demo →</a
        >
      </div>
    </section>

    <!-- WHY CUSTOM ERP -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <div class="text-center">
        <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
          Why Build a Custom ERP?
        </h2>
        <p class="mt-4 max-w-2xl mx-auto text-slate-600">
          A customized ERP gives your company <strong>control, scalability, and precision</strong> — crafted around your workflows, not generic templates.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["Tailored Modules", "Every feature, report, and dashboard is built for your department’s exact needs."],
          ["Seamless Integrations", "Connect finance, HR, CRM, and production under one smart ecosystem."],
          ["AI-Powered Insights", "Predictive analytics and performance alerts to guide smarter decisions."],
          ["Cloud or On-Premise", "Host on your infrastructure or Octonics-managed secure cloud in Kuwait."],
          ["Scalable Architecture", "Built to grow with your workforce and evolving business strategy."],
          ["Bilingual Interface", "Arabic & English interface with full RTL support for Kuwait’s market."],
        ].map(([title, desc]) => (
          <div
            class="group rounded-3xl bg-white/80 p-8 shadow-lg ring-1 ring-slate-200 backdrop-blur-lg transition hover:-translate-y-2 hover:shadow-2xl hover:ring-sky-300"
          >
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CORE MODULES DETAIL -->
    <section class="bg-white py-24 border-y border-slate-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Comprehensive ERP Modules for Kuwaiti Enterprises</h2>
          <p class="mt-4 text-slate-600">Our custom solutions cover every aspect of modern business operations in Kuwait.</p>
        </div>
        
        <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-blue-100 rounded-2xl flex items-center justify-center text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h4 class="text-xl font-bold">Financial Management</h4>
            <p class="text-slate-600 text-sm">Advanced accounting, multi-currency support, automated invoicing, and real-time financial reporting compliant with Kuwaiti audit standards.</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center text-green-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </div>
            <h4 class="text-xl font-bold">Human Resources (HRMS)</h4>
            <p class="text-slate-600 text-sm">Kuwait Labor Law compliant payroll, residency (Iqama) tracking, leave management, and employee performance portals.</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
            </div>
            <h4 class="text-xl font-bold">Supply Chain & Inventory</h4>
            <p class="text-slate-600 text-sm">Warehouse management across multiple locations in Kuwait, real-time stock tracking, and automated procurement logic.</p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 bg-orange-100 rounded-2xl flex items-center justify-center text-orange-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            </div>
            <h4 class="text-xl font-bold">CRM & Sales Automation</h4>
            <p class="text-slate-600 text-sm">Lead tracking, customer profiles, sales pipeline management, and integration with local payment gateways like K-NET.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- INDUSTRIES WE SERVE -->
    <section class="py-24 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-slate-900 mb-12">Who We Build For: Specialized Industries in Kuwait</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {["Retail & E-commerce", "Construction & Engineering", "Oil & Gas Services", "Logistics & Transport", "Healthcare Facilities", "Trading & Distribution", "Real Estate Management", "Education & Schools"].map(industry => (
            <span class="px-6 py-2 bg-white rounded-full border border-slate-200 text-slate-700 shadow-sm hover:border-blue-500 hover:text-blue-600 transition-colors cursor-default">
              {industry}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- COMPLIANCE SECTION -->
    <section class="py-24 bg-white overflow-hidden relative">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1">
             <div class="p-8 bg-blue-600 rounded-[2.5rem] text-white shadow-2xl transform -rotate-2">
                <h3 class="text-2xl font-bold mb-6">Fully Localized for Kuwait</h3>
                <ul class="space-y-4 text-blue-100">
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-blue-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Kuwait Labor Law Integration:</strong> Automated calculation of indemnity, annual leave, and social security.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-blue-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Bilingual Support:</strong> Seamlessly switch between Modern Standard Arabic and English interfaces.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-blue-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Local Bank Integration:</strong> Direct connection with Kuwaiti banks for automated reconciliation.</span>
                  </li>
                </ul>
             </div>
          </div>
          <div class="order-1 lg:order-2">
            <h2 class="text-4xl font-bold text-slate-900 mb-6 leading-tight">Built with Global Standards, Local Expertise.</h2>
            <p class="text-slate-600 text-lg mb-8">Implementing an ERP in Kuwait requires more than just code. It requires an understanding of the local business culture, legal requirements, and operational nuances.</p>
            <div class="flex gap-4">
                <div class="px-4 py-2 bg-slate-100 rounded-lg text-slate-700 font-semibold text-sm">VAT Ready</div>
                <div class="px-4 py-2 bg-slate-100 rounded-lg text-slate-700 font-semibold text-sm">ISO Compliant</div>
                <div class="px-4 py-2 bg-slate-100 rounded-lg text-slate-700 font-semibold text-sm">GDPR Aligned</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DEVELOPMENT PROCESS -->
    <section class="relative bg-gradient-to-r from-indigo-600 to-sky-600 py-24 text-white" data-animate>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 text-center">
        <h3 class="text-3xl font-bold sm:text-4xl">Our ERP Development Process</h3>
        <p class="mt-3 max-w-2xl mx-auto text-indigo-100">
          Transparent, agile, and collaborative — ensuring a perfect fit for your organization.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-4">
          {[
            ["Discovery", "We analyze workflows, goals, and bottlenecks."],
            ["Design", "We create UI/UX and database architecture tailored to your needs."],
            ["Development", "Agile build with testing and iterative validation."],
            ["Deployment", "Seamless rollout, user training, and continuous support."],
          ].map(([step, desc]) => (
            <div class="rounded-3xl bg-white/10 p-6 shadow-lg ring-1 ring-white/10 backdrop-blur-md transition hover:-translate-y-2 hover:bg-white/20">
              <h4 class="text-xl font-semibold text-white">{step}</h4>
              <p class="mt-2 text-sm text-indigo-100">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- AI FEATURES -->
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" data-animate>
      <div class="grid items-center gap-14 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
            Smarter ERP with Built-in AI
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Our ERP platforms integrate <strong>AI-driven automation</strong> for smarter approvals, real-time alerts, and predictive insights.
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li>🤖 Automated data entry & reconciliation</li>
            <li>📊 Predictive sales and purchase analytics</li>
            <li>🧠 AI chatbot for instant ERP commands</li>
            <li>🔔 Anomaly detection & alert automation</li>
          </ul>
        </div>
        <figure>
          <img
            src="/images/ai-dashboard.jpg"
            alt="AI-powered ERP Dashboard"
            loading="lazy"
            class="rounded-3xl shadow-2xl ring-1 ring-slate-200"
          />
        </figure>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-24 bg-slate-50">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-slate-900 text-center mb-12">Custom ERP Development: Frequently Asked Questions</h2>
        <div class="space-y-6">
          <details class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none uppercase tracking-tight">
              <span>Why choose custom ERP over Odoo or SAP in Kuwait?</span>
              <span class="transition group-open:rotate-180"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed text-left">While popular platforms offer broad features, businesses in Kuwait often have unique workflows, local labor law needs, and specific K-NET/banking integrations that off-the-shelf systems can't handle without expensive and "bloated" customizations. Our custom ERPs are built lean, fast, and exactly for your needs.</p>
          </details>
          <details class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none uppercase tracking-tight">
              <span>How long does it take to build a custom ERP system?</span>
              <span class="transition group-open:rotate-180"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed text-left">A basic ERP system with core modules (Finance, HR) usually takes 3-4 months. More complex systems with inventory and production modules take 6-12 months. We use an agile approach, meaning you see and use features as we build them.</p>
          </details>
          <details class="group p-6 bg-white rounded-2xl shadow-sm border border-slate-200">
            <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none uppercase tracking-tight">
              <span>Is our data secure and hosted in Kuwait?</span>
              <span class="transition group-open:rotate-180"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed text-left">Yes. We offer both on-premise solutions (hosting on your servers in Kuwait) and hybrid cloud solutions with encrypted data backup. We prioritize data residency and privacy according to Kuwaiti business standards.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative bg-gradient-to-r from-sky-500 to-indigo-600 py-20 text-white text-center" data-animate>
      <div class="mx-auto max-w-4xl px-4">
        <h3 class="text-3xl font-bold sm:text-4xl">Build Your Intelligent ERP System</h3>
        <p class="mt-3 text-indigo-100">
          Let’s design a system that thinks like your business — faster, smarter, and tailored.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:scale-105"
          >Schedule a Consultation →</a
        >
      </div>
    </section>

    <!-- FOOTER -->
    <Footer year={currentYear} />

    <!-- FLOATING RIBBON -->


    <script is:inline>
      const badge = document.getElementById("erpBadge");
      window.addEventListener("scroll", () => {
        const showAt = 200;
        if (window.scrollY > showAt) {
          badge.style.opacity = "1";
          badge.style.transform = "translateX(0)";
        } else {
          badge.style.opacity = "0";
          badge.style.transform = "translateX(20px)";
        }
      });
    </script>
  </body>
</html>