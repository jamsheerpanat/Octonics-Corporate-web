<!-- ============================================================ -->
<!-- CONTACT CTA – “Let’s Build the Future Together” -->
<!-- ============================================================ -->
<section
  id="contact"
  class="relative mx-auto mt-28 max-w-7xl overflow-hidden px-4 py-24 sm:px-6 lg:px-8"
  data-animate
>
  <!-- Background Gradient + Orbs -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-br from-sky-50 via-white to-indigo-50"></div>
  <div aria-hidden="true" class="absolute top-10 left-10 h-72 w-72 rounded-full bg-sky-200/40 blur-3xl"></div>
  <div aria-hidden="true" class="absolute bottom-10 right-10 h-80 w-80 rounded-full bg-indigo-200/40 blur-3xl"></div>

  <!-- Wrapper -->
  <div
    class="relative rounded-3xl bg-white/70 p-10 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl md:p-16"
  >
    <div class="grid gap-12 md:grid-cols-2">
      <!-- Left Content -->
      <div class="flex flex-col justify-center">
        <span
          class="inline-block w-fit rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700 ring-1 ring-sky-200"
        >
          Let’s Collaborate
        </span>
        <h3 class="mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          Let’s Build the
          <span
            class="bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
            >Future</span
          >
          — Together.
        </h3>
        <p class="mt-4 text-base leading-relaxed text-slate-600">
          Whether you’re designing a <b>smart villa</b>, upgrading IT
          infrastructure, or deploying enterprise-grade software — Octonics
          brings <strong>KNX-certified engineering</strong>, <strong>AI
          integration</strong>, and <strong>future-ready IT systems</strong> to
          every project in Kuwait.
        </p>

        <ul class="mt-8 space-y-3 text-sm text-slate-700">
          <li class="flex items-center gap-2">
            ✅ Site survey & system design
          </li>
          <li class="flex items-center gap-2">
            📄 Transparent BoQ & phased timeline
          </li>
          <li class="flex items-center gap-2">
            🛠️ Warranty & long-term technical support
          </li>
        </ul>

        <div class="mt-8">
          <p class="text-sm text-slate-500">
            Prefer a direct chat? Email us at
            <a
              href="mailto:info@octonics.com"
              class="font-medium text-sky-600 underline decoration-sky-300 hover:text-indigo-600"
              >info@octonics.com</a
            >
          </p>
        </div>
      </div>

      <!-- Right Form -->
      <form
        action="https://formspree.io/f/meorpdle"
        method="POST"
        class="grid gap-4"
      >
        <input
          name="name"
          required
          placeholder="Your Name"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        />
        <input
          type="email"
          name="_replyto"
          required
          placeholder="Email Address"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        />
        <input
          name="phone"
          placeholder="Phone Number"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        />
        <textarea
          name="message"
          rows="4"
          placeholder="Tell us about your project…"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        ></textarea>
        <button
          class="mt-2 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-sky-300/40"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>

  <!-- Decorative Glow -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 left-1/2 h-48 w-[90%] -translate-x-1/2 rounded-full bg-gradient-to-r from-sky-200/40 via-indigo-200/30 to-sky-200/40 blur-3xl"
  ></div>
</section>