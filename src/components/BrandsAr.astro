<!-- قسم العلامات التجارية / شركاء التكنولوجيا – النسخة الكويتية -->
<!-- ============================================================ -->
<section
  id="brands"
  dir="rtl"
  class="relative mx-auto mt-28 max-w-7xl overflow-hidden px-4 py-24 sm:px-6 lg:px-8 text-right"
  data-animate
>
  <!-- خلفيات متدرجة -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-br from-white via-slate-50 to-sky-50"></div>
  <div aria-hidden="true" class="absolute -top-16 right-1/2 h-80 w-80 translate-x-1/2 rounded-full bg-sky-200/40 blur-3xl"></div>
  <div aria-hidden="true" class="absolute bottom-0 left-10 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"></div>

  <!-- العنوان الرئيسي -->
  <div class="text-center">
    <span
      class="inline-block rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold tracking-widest text-sky-700 ring-1 ring-sky-200"
    >
      شركاؤنا في التقنية
    </span>

    <h2 class="mt-4 text-4xl font-extrabold text-slate-900 sm:text-5xl leading-snug">
      <span class="text-sky-600">علامات عالمية</span> نعتمد عليها في كل مشروع
    </h2>

    <p class="mx-auto mt-4 max-w-2xl text-slate-600 leading-relaxed">
      في <b>أوكتونيكس</b> نعمل مع أقوى <b>العلامات العالمية</b> في عالم <b>الأتمتة والذكاء الاصطناعي</b> 
      لتقديم أعلى مستويات <b>الاستقرار، الأداء، والجودة</b>.  
      ندمج هذه التقنيات لصناعة أنظمة ذكية تواكب السوق الكويتي وتحوّل منزلك أو عملك إلى تجربة رقمية متكاملة.
    </p>
  </div>

  <!-- شريط العلامات التجارية المتحرك -->
  <div
    class="relative mx-auto mt-16 overflow-hidden rounded-3xl bg-white/80 shadow-2xl ring-1 ring-slate-200 backdrop-blur-lg"
  >
    <div
      class="flex min-w-full animate-[marquee_45s_linear_infinite] gap-12 whitespace-nowrap py-8 hover:[animation-play-state:paused]"
    >
      {[
        "/images/brands/knx.png",
        "/images/brands/theben.png",
        "/images/brands/gira.png",
        "/images/brands/abb.png",
        "/images/brands/schneider.png",
        "/images/brands/rti.png",
        "/images/brands/dali.png",
        "/images/brands/philips.png",
        "/images/brands/somfy.png",
        "/images/brands/sonos.png",
      ].map((src) => (
        <div
          class="relative mx-8 inline-flex h-20 items-center justify-center rounded-2xl bg-gradient-to-br from-white/95 to-slate-100/80 px-8 shadow-md ring-1 ring-slate-200 backdrop-blur-md transition hover:-translate-y-1 hover:shadow-2xl hover:ring-sky-300 hover:bg-white"
        >
          <img
            src={src}
            alt="شعار العلامة التجارية"
            loading="lazy"
            class="h-12 w-auto max-w-[160px] mix-blend-multiply brightness-110 contrast-110 opacity-95 transition-all hover:opacity-100 hover:scale-105"
            onerror="this.src='/images/placeholder-logo.png'; this.style.opacity='0.3';"
          />
          <div
            class="absolute inset-0 rounded-2xl bg-gradient-to-r from-sky-100/0 via-sky-100/20 to-transparent opacity-0 transition hover:opacity-100"
          ></div>
        </div>
      ))}

      <!-- نسخة مكررة للتمرير اللانهائي -->
      {[
        "/images/brands/knx.png",
        "/images/brands/theben.png",
        "/images/brands/gira.png",
        "/images/brands/abb.png",
        "/images/brands/schneider.png",
        "/images/brands/rti.png",
        "/images/brands/dali.png",
        "/images/brands/philips.png",
        "/images/brands/somfy.png",
        "/images/brands/sonos.png",
      ].map((src) => (
        <div
          class="relative mx-8 inline-flex h-20 items-center justify-center rounded-2xl bg-gradient-to-br from-white/95 to-slate-100/80 px-8 shadow-md ring-1 ring-slate-200 backdrop-blur-md transition hover:-translate-y-1 hover:shadow-2xl hover:ring-sky-300 hover:bg-white"
        >
          <img
            src={src}
            alt="شعار العلامة التجارية"
            loading="lazy"
            class="h-12 w-auto max-w-[160px] mix-blend-multiply brightness-110 contrast-110 opacity-95 transition-all hover:opacity-100 hover:scale-105"
            onerror="this.src='/images/placeholder-logo.png'; this.style.opacity='0.3';"
          />
          <div
            class="absolute inset-0 rounded-2xl bg-gradient-to-r from-sky-100/0 via-sky-100/20 to-transparent opacity-0 transition hover:opacity-100"
          ></div>
        </div>
      ))}
    </div>
  </div>

  <!-- النص السفلي -->
  <p class="mx-auto mt-10 max-w-xl text-center text-sm text-slate-500">
    نتعامل مع أفضل الأسماء في <b>KNX</b> و<b>DALI</b> و<b>الذكاء الاصطناعي</b> و<b>التحكم المنزلي الذكي</b> —
    لضمان جودة أوروبية بتصميم يناسب السوق الكويتي.
  </p>

  <!-- تأثير التوهج السفلي -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 right-1/2 h-48 w-[90%] translate-x-1/2 rounded-full bg-gradient-to-r from-sky-200/30 via-indigo-200/20 to-sky-200/30 blur-3xl"
  ></div>
</section>

