---
/**
 * LeadForm – simple lead capture form posting to /api/lead
 */
---
<form method="POST" action="/api/lead" class="grid grid-cols-1 gap-6 bg-white p-8 rounded-xl shadow-md" id="lead-form">
  <input type="hidden" name="product" value="{Astro.props.product}" />
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Name</label>
    <input type="text" name="name" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500" />
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Company</label>
    <input type="text" name="company" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500" />
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Phone</label>
    <input type="tel" name="phone" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500" />
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
    <input type="email" name="email" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500" />
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Message</label>
    <textarea name="message" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500"></textarea>
  </div>
  <button type="submit" class="w-full bg-gradient-to-r from-sky-500 to-indigo-600 text-white py-2 rounded-md font-semibold hover:scale-105 transition-transform">
    Submit Request
  </button>
</form>
