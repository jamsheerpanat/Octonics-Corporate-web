---
const mainLinks = [
  { label: "Home", href: "/" },
  {
    label: "About",
    submenu: [
      { label: "About Octonics", href: "/about" },
      { label: "KNX & RTI Certification", href: "/knx-certification" },
    ],
  },
  {
    label: "Services",
    submenu: [
      {
        label: "ERP Business Software",
        href: "/services/erp-business-software",
      },
      {
        label: "Custom ERP Development",
        href: "/services/custom-erp-development",
      },
      {
        label: "Odoo ERP Customization",
        href: "/services/odoo-erp-customization",
      },
      { label: "Manter ERP", href: "/services/manter-erp" },
      { label: "Data Analytics & AI", href: "/services/data-analytics-ai" },
      { label: "IT Infrastructure", href: "/services/it-infrastructure" },
      {
        label: "IT Governance & Cybersecurity",
        href: "/services/it-governance-cybersecurity",
      },
      { label: "IT Support", href: "/services/it-support" },
      { label: "Smart Automation", href: "/services/smart-automation" },
      {
        label: "Smart Home & Building (KNX/DALI)",
        href: "/services/smart-home-building",
      },
      {
        label: "Surveillance & Access Control",
        href: "/services/surveillance-access-control",
      },
      { label: "Web App Development", href: "/services/web-app-development" },
    ],
  },
  {
    label: "Products",
    submenu: [
      { label: "All Products", href: "/products" },
      { label: "QRKuwait — Smart Ordering", href: "/products/qrkuwait" },
      {
        label: "OctoBrain™ — Business Intelligence",
        href: "/products/octobrain",
      },
      { label: "OctoFlow™ — Workflow Automation", href: "/products/octoflow" },
      { label: "OctoGuard™ — AI Surveillance", href: "/products/octoguard" },
      {
        label: "OctoSense™ — Energy Intelligence",
        href: "/products/octosense",
      },
      { label: "OctoDesk™ — IT Support", href: "/products/octodesk" },
      {
        label: "OctoRetail™ — Retail Intelligence",
        href: "/products/octoretail",
      },
      { label: "OctoHR™ — Workforce Intelligence", href: "/products/octohr" },
      {
        label: "OctoVault™ — Document Management",
        href: "/products/octovault",
      },
      { label: "OctoSales™ — Sales Intelligence", href: "/products/octosales" },
      { label: "OctoTwin™ — Digital Twin", href: "/products/octotwin" },
    ],
  },
  {
    label: "Experience",
    submenu: [
      { label: "Gallery", href: "/gallery" },
      { label: "Blog", href: "/blog" },
    ],
  },
  { label: "Contact", href: "/contact" },
];

const isArabic = Astro.url.pathname.startsWith("/ar");
const switchHref = isArabic
  ? Astro.url.pathname.replace("/ar", "") || "/"
  : `/ar${Astro.url.pathname}`;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-in-out"
>
  <nav
    id="navbar"
    class="mx-auto mt-2 sm:mt-4 mx-2 sm:mx-auto max-w-7xl flex items-center justify-between rounded-2xl sm:rounded-full border border-slate-200 bg-white/95 backdrop-blur-lg px-4 sm:px-6 py-2 sm:py-3 shadow-lg transition-all duration-500 hover:bg-white"
  >
    <!-- LOGO -->
    <a href={isArabic ? "/ar/" : "/"} class="flex items-center gap-2">
      <img
        src="/images/octonics-logo.png"
        alt="Octonics Innovations Logo"
        loading="lazy"
        class="h-8 sm:h-9 w-auto drop-shadow-md transition-transform hover:scale-105"
      />
    </a>

    <!-- MOBILE TOGGLE -->
    <button
      id="nav-toggle"
      class="lg:hidden flex items-center justify-center rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 w-10 h-10 sm:w-11 sm:h-11 text-white shadow-md transition-transform active:scale-95"
      aria-label="Toggle navigation menu"
    >
      <svg
        class="w-5 h-5 sm:w-6 sm:h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- DESKTOP MENU -->
    <ul
      class="hidden lg:flex items-center gap-4 xl:gap-7 text-[14px] xl:text-[15px] font-semibold text-slate-700"
    >
      {
        mainLinks.map((link) => (
          <li class="relative group">
            <a
              href={isArabic ? `/ar${link.href}` : link.href}
              class="flex items-center gap-1 py-2 transition relative hover:text-sky-700 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:bg-gradient-to-r after:from-sky-400 after:to-indigo-500 after:transition-all after:duration-300 group-hover:after:w-full"
            >
              {link.label}
              {link.submenu && (
                <span class="ml-1 text-xs text-slate-500">▾</span>
              )}
            </a>

            {link.submenu && (
              <ul class="absolute left-0 top-full mt-3 min-w-[260px] opacity-0 translate-y-3 scale-95 invisible group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-300 ease-out rounded-2xl border border-white/30 bg-white/80 p-3 shadow-2xl backdrop-blur-xl">
                {link.submenu.map((sublink) => (
                  <li>
                    <a
                      href={isArabic ? `/ar${sublink.href}` : sublink.href}
                      class="block rounded-xl px-3 py-2 text-sm text-slate-800 hover:bg-gradient-to-r hover:from-sky-50 hover:to-indigo-50 hover:text-sky-700 transition-all"
                    >
                      {sublink.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }

      <!-- LANGUAGE SWITCH -->
      <li>
        <a
          href={switchHref}
          class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-gradient-to-r hover:from-sky-500 hover:to-indigo-600 hover:text-white transition shadow-sm"
        >
          {isArabic ? "English" : "العربية"}
        </a>
      </li>

      <li>
        <a
          href={isArabic ? "/ar/contact" : "/contact"}
          class="rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-5 py-2 text-white shadow-md transition hover:scale-105 hover:shadow-sky-300/40"
        >
          {isArabic ? "احصل على عرض" : "Get Quote"}
        </a>
      </li>
    </ul>
  </nav>

  <!-- MOBILE PANEL -->
  <div
    id="mobile-panel"
    class="lg:hidden fixed left-0 right-0 top-[72px] sm:left-4 sm:right-4 sm:top-[80px] max-h-[calc(100vh-90px)] overflow-y-auto origin-top scale-y-0 opacity-0 rounded-none sm:rounded-2xl border-0 sm:border border-slate-200 bg-white p-4 sm:p-5 shadow-2xl transition-all duration-300 safe-area-padding z-[100]"
  >
    <ul
      class="flex flex-col gap-2 sm:gap-4 text-base sm:text-sm font-semibold text-slate-800"
    >
      {
        mainLinks.map((link) => (
          <li>
            {link.submenu ? (
              <details class="rounded-xl bg-white/70 overflow-hidden">
                <summary class="cursor-pointer px-4 py-3 sm:px-3 sm:py-2 font-medium text-slate-800 flex justify-between items-center min-h-[48px]">
                  {link.label}
                  <span class="text-xs text-slate-500">▾</span>
                </summary>
                <ul class="mt-2 space-y-1 sm:space-y-2 px-2 sm:px-4 pb-3 max-h-[300px] overflow-y-auto">
                  {link.submenu.map((sublink) => (
                    <li>
                      <a
                        href={isArabic ? `/ar${sublink.href}` : sublink.href}
                        class="block rounded-lg px-4 py-3 sm:px-3 sm:py-2 text-sm hover:bg-slate-100 transition min-h-[44px] flex items-center"
                      >
                        {sublink.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={isArabic ? `/ar${link.href}` : link.href}
                class="block rounded-lg px-4 py-3 sm:px-3 sm:py-2 hover:bg-slate-100 min-h-[48px] flex items-center"
              >
                {link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <!-- Mobile Language Switch -->
    <div
      class="flex flex-col sm:flex-row justify-between items-stretch gap-3 mt-5 pt-4 border-t border-slate-200"
    >
      <a
        href={switchHref}
        class="flex-1 text-center rounded-full border border-slate-300 px-5 py-3 sm:py-2 font-semibold text-slate-700 hover:bg-gradient-to-r hover:from-sky-500 hover:to-indigo-600 hover:text-white transition min-h-[48px] flex items-center justify-center"
      >
        {isArabic ? "English" : "العربية"}
      </a>

      <a
        href={isArabic ? "/ar/contact" : "/contact"}
        class="flex-1 text-center rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-5 py-3 sm:py-2 text-white shadow-md transition hover:scale-105 min-h-[48px] flex items-center justify-center"
      >
        {isArabic ? "اتصل بنا" : "Contact Us"}
      </a>
    </div>
  </div>

  <!-- SCROLL PROGRESS BAR -->
  <div
    id="progress"
    class="fixed left-0 top-0 h-[3px] w-0 bg-gradient-to-r from-sky-400 via-indigo-500 to-pink-500 shadow-[0_0_14px_rgba(99,102,241,.45)] transition-all duration-150"
  >
  </div>

  <script is:inline>
    const btn = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-panel");
    const progress = document.getElementById("progress");
    const header = document.getElementById("site-header");
    const navbar = document.getElementById("navbar");

    btn?.addEventListener("click", () => {
      panel?.classList.toggle("scale-y-0");
      panel?.classList.toggle("opacity-0");
    });

    window.addEventListener("scroll", () => {
      const doc = document.documentElement;
      const scrolled = doc.scrollTop;
      const height = doc.scrollHeight - doc.clientHeight;
      const pct = Math.min(100, (scrolled / height) * 100);
      progress.style.width = pct + "%";
      header.style.filter = `hue-rotate(${pct * 3.6}deg)`;

      if (window.scrollY > 80) {
        navbar.classList.add(
          "bg-white",
          "border-slate-200",
          "shadow-[0_8px_40px_rgba(0,0,0,0.1)]",
        );
        navbar.classList.remove("bg-white/60", "border-white/30");
      } else {
        navbar.classList.add("bg-white/60", "border-white/30");
        navbar.classList.remove("bg-white", "border-slate-200");
      }
    });
  </script>
</header>
