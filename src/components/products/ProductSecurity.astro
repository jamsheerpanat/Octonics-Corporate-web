---
/**
 * ProductSecurity – security & compliance section
 */
interface SecurityItem {
  title: string;
  description: string;
  icon: string;
}

const { items, isRTL = false } = Astro.props;
---

<section class="py-16 bg-white" dir={isRTL ? "rtl" : "ltr"}>
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-3xl font-bold text-center mb-12 bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
    >
      Security & Compliance
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        items.map((item) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-xl font-semibold mb-2">{item.title}</h3>
            <p class="text-slate-600 text-sm">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
