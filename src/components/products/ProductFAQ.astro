---
/**
 * ProductFAQ – accordion style FAQ list
 */
interface FAQItem { q: string; a: string; }
const { faq = [] } = Astro.props;
---
<section class="py-20 bg-white" id="faq">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-12 bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {faq.map((item, i) => (
        <details class="border border-slate-200 rounded-md p-4" open={i===0}>
          <summary class="font-medium cursor-pointer text-slate-800">{item.q}</summary>
          <p class="mt-2 text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
