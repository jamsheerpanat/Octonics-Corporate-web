---
/**
 * ProductHowItWorks - 4 step process component
 */
interface Step {
  number: number;
  title: string;
  description: string;
  icon?: string;
}

const { steps, isRTL = false } = Astro.props;
---

<section class="py-20 bg-white" dir={isRTL ? "rtl" : "ltr"}>
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-3xl font-bold text-center mb-12 bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
    >
      How It Works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        steps.map((s) => (
          <div class="flex items-start gap-4 p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-gradient-to-br from-sky-500 to-indigo-600 text-white text-xl font-bold">
              {s.number}
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-1">{s.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {s.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
