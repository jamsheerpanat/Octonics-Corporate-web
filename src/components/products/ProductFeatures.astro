---
/**
 * ProductFeatures - Grid of feature cards for a product page
 */
interface Feature {
  icon: string;
  title: string;
  description: string;
}

const { features, isRTL = false } = Astro.props;
---

<section class="py-16 bg-slate-50" dir={isRTL ? "rtl" : "ltr"}>
  <div class="max-w-6xl mx-auto px-6">
    <h2
      class="text-3xl font-bold text-center mb-12 bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
    >
      Features
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        features.map((f) => (
          <div class="p-6 rounded-2xl bg-white shadow-sm border border-slate-100 hover:shadow-lg transition-shadow">
            <div class="text-3xl mb-4">{f.icon}</div>
            <h3 class="text-xl font-semibold mb-2">{f.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              {f.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
