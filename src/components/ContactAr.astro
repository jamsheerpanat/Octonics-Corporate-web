<!-- ============================================================ -->
<!-- تواصل معنا – "خلنا نبني المستقبل سوا" (النسخة الكويتية التسويقية) -->
<!-- ============================================================ -->
<section
  id="contact"
  dir="rtl"
  class="relative mx-auto mt-28 max-w-7xl overflow-hidden px-4 py-24 sm:px-6 lg:px-8 text-right"
  data-animate
>
  <!-- الخلفيات المتدرجة -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-br from-sky-50 via-white to-indigo-50"></div>
  <div aria-hidden="true" class="absolute top-10 right-10 h-72 w-72 rounded-full bg-sky-200/40 blur-3xl"></div>
  <div aria-hidden="true" class="absolute bottom-10 left-10 h-80 w-80 rounded-full bg-indigo-200/40 blur-3xl"></div>

  <!-- المحتوى العام -->
  <div
    class="relative rounded-3xl bg-white/70 p-10 shadow-2xl ring-1 ring-slate-200 backdrop-blur-xl md:p-16"
  >
    <div class="grid gap-12 md:grid-cols-2">
      <!-- النص -->
      <div class="flex flex-col justify-center">
        <span
          class="inline-block w-fit rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700 ring-1 ring-sky-200"
        >
          خلنا نبدأ مع بعض
        </span>

        <h3 class="mt-4 text-3xl font-extrabold text-slate-900 sm:text-4xl leading-snug">
          خلنا نبني
          <span
            class="bg-gradient-to-r from-sky-500 to-indigo-600 bg-clip-text text-transparent"
            >المستقبل</span
          >
          — سوا.
        </h3>

        <p class="mt-4 text-base leading-relaxed text-slate-600">
          تبي تصمم <b>فيلا ذكية فخمة</b>؟ أو تطور <b>شبكة IT متكاملة</b> لشركتك؟  
          أو حتى <b>تجهز مبنى تجاري بأنظمة أتمتة كاملة</b>؟  
          في <strong>أوكتونيكس</strong> نوفر لك <b>مهندسين معتمدين من KNX</b> وخبراء في <b>تكامل الذكاء الاصطناعي</b>،
          ونقدم حلول مصممة خصيصاً <b>لأسلوب الحياة والمناخ في الكويت</b> — بجودة عالمية ولمسة محلية.
        </p>

        <ul class="mt-8 space-y-3 text-sm text-slate-700">
          <li class="flex items-center gap-2">✅ زيارة ميدانية وتصميم دقيق للأنظمة</li>
          <li class="flex items-center gap-2">📄 عرض سعر واضح وجدول تنفيذ مضمون</li>
          <li class="flex items-center gap-2">🛠️ ضمان طويل المدى وخدمة فنية على مدار السنة</li>
        </ul>

        <div class="mt-8">
          <p class="text-sm text-slate-500">
            تبي تتواصل مباشرة؟ راسلنا على:
            <a
              href="mailto:info@octonics.com"
              class="font-medium text-sky-600 underline decoration-sky-300 hover:text-indigo-600"
              >info@octonics.com</a
            >
          </p>
        </div>
      </div>

      <!-- النموذج -->
      <form
        action="https://formspree.io/f/meorpdle"
        method="POST"
        class="grid gap-4 text-right"
      >
        <input
          name="name"
          required
          placeholder="الاسم الكامل"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        />
        <input
          type="email"
          name="_replyto"
          required
          placeholder="البريد الإلكتروني"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        />
        <input
          name="phone"
          placeholder="رقم الهاتف"
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        />
        <textarea
          name="message"
          rows="4"
          placeholder="تكلم عن مشروعك أو الفكرة اللي تبي تبدأها..."
          class="rounded-2xl border border-slate-200 bg-white/60 px-4 py-3 text-sm text-slate-800 outline-none backdrop-blur-sm transition focus:ring-2 focus:ring-sky-400 hover:border-sky-300"
        ></textarea>
        <button
          class="mt-2 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-sky-300/40"
        >
          إرسال الرسالة
        </button>
      </form>
    </div>
  </div>

  <!-- التوهج الزخرفي -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 right-1/2 h-48 w-[90%] translate-x-1/2 rounded-full bg-gradient-to-r from-sky-200/40 via-indigo-200/30 to-sky-200/40 blur-3xl"
  ></div>
</section>