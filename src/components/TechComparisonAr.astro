---
import { Building2, Wifi, Radio } from "lucide-react";
---

<!-- ============================================================ -->
<!-- مقارنة تقنيات الأتمتة الذكية – نسخة أوكتونيكس العربية -->
<!-- ============================================================ -->
<section
  id="tech-comparison"
  dir="rtl"
  class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:px-8 text-right"
  data-animate
>
  <!-- العنوان -->
  <div class="text-center mb-14">
    <span
      class="inline-block rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700 ring-1 ring-sky-200"
    >
      اختر نظامك الأساسي
    </span>

    <h3 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">
      قارن بين تقنيات الأتمتة الذكية
    </h3>

    <p class="mt-3 max-w-2xl mx-auto text-slate-600 leading-relaxed">
      كل مشروع له طابعه الخاص — سواء كنت تصمم <b>فيلا فاخرة</b> أو <b>مكتبًا حديثًا</b> أو <b>شقة للتجديد</b>،
      تساعدك أوكتونيكس في اختيار نظام الأتمتة الأنسب لضمان <strong>الاستقرار والأداء طويل الأمد</strong>.
    </p>
  </div>

  <!-- شبكة المقارنة -->
  <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
    {[
      {
        name: "KNX",
        type: "سلكي",
        ideal: "الفيلات والمباني التجارية",
        tech: "ناقل بيانات DALI / TP / IP",
        brands: "Theben، Jung، ABB، MDT",
        icon: Building2,
        color: "from-indigo-600 to-sky-500",
        highlight:
          "معيار عالمي مفتوح تدعمه أكثر من 500 شركة مصنّعة و30 عامًا من الموثوقية.",
      },
      {
        name: "Zigbee / Z-Wave",
        type: "لاسلكي شبكي",
        ideal: "الشقق والمشاريع القائمة (Retrofit)",
        tech: "شبكة Mesh ذاتية الإصلاح",
        brands: "Aqara، Philips Hue، SONOFF، Shelly",
        icon: Radio,
        color: "from-sky-500 to-teal-500",
        highlight:
          "تقنية لاسلكية تعتمد على الشبكات المترابطة لتوفير التغطية والاستقرار وسهولة التوسع.",
      },
      {
        name: "Wi-Fi IoT",
        type: "لاسلكي",
        ideal: "الغرف الذكية والمكاتب الصغيرة",
        tech: "اتصال مباشر عبر الشبكة / السحابة",
        brands: "Tuya، Shelly، Broadlink",
        icon: Wifi,
        color: "from-purple-600 to-indigo-600",
        highlight:
          "حل سريع ومنخفض التكلفة يعتمد على شبكة الواي فاي الحالية لديك.",
      },
    ].map((t) => (
      <div
        class={`group relative rounded-3xl bg-gradient-to-br ${t.color} p-[1px] shadow-lg hover:shadow-2xl transition-transform hover:-translate-y-1`}
      >
        <div
          class="flex flex-col h-full rounded-3xl bg-white/90 p-8 backdrop-blur-xl transition group-hover:bg-white"
        >
          <!-- الأيقونة -->
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-indigo-700 shadow-inner mb-4"
          >
            <t.icon class="h-8 w-8 text-indigo-600" />
          </div>

          <!-- العنوان -->
          <h4 class="text-2xl font-bold text-slate-900">{t.name}</h4>
          <p class="mt-1 text-sm font-medium text-indigo-600">{t.type}</p>

          <!-- التفاصيل -->
          <p class="mt-3 text-sm text-slate-700 leading-relaxed">
            <strong>الأفضل لـ:</strong> {t.ideal}<br />
            <strong>التقنية:</strong> {t.tech}<br />
            <strong>أمثلة على العلامات التجارية:</strong> {t.brands}
          </p>

          <!-- المميزات -->
          <p class="mt-4 text-sm italic text-slate-600">{t.highlight}</p>

          <!-- الزر -->
          <div class="mt-6 flex justify-center">
            <a
              href="/ar/contact"
              class="rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-md transition hover:scale-105 hover:shadow-sky-300/40"
            >
              اكتشف {t.name} →
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- تأثيرات خلفية جمالية -->
  <div
    class="absolute -top-20 right-1/3 h-56 w-56 rounded-full bg-sky-200/30 blur-3xl"
  ></div>
  <div
    class="absolute -bottom-24 left-1/4 h-56 w-56 rounded-full bg-indigo-300/30 blur-3xl"
  ></div>
</section>

<!-- ============================================================ -->
<!-- تحسينات التصميم -->
<!-- ============================================================ -->
<style>
@media (max-width: 768px) {
  #tech-comparison .h-16 {
    height: 3.5rem;
    width: 3.5rem;
  }
}
</style>