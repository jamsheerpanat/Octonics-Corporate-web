---
import {
  Target,
  Network,
  Brain,
  Smartphone,
  Sparkles,
} from "lucide-react";
---

<!-- ============================================================ -->
<!-- مخطط تدفق النظام – النسخة العربية من أوكتونيكس -->
<!-- ============================================================ -->
<section
  id="system-flow"
  dir="rtl"
  class="relative mx-auto max-w-6xl px-4 py-28 sm:px-6 lg:px-8 text-right"
  data-animate
>
  <!-- العنوان -->
  <div class="text-center mb-14">
    <span
      class="inline-block rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700 ring-1 ring-sky-200"
    >
      آلية التكامل الذكي
    </span>

    <h3 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">
      كيف تعمل أنظمة أوكتونيكس الذكية
    </h3>

    <p class="mt-3 max-w-2xl mx-auto text-slate-600 leading-relaxed">
      يتبع كل منزل أو مبنى ذكي من أوكتونيكس <strong>تسلسلاً متكاملًا</strong> من الخطوات — حيث يتم ربط
      المستشعرات ووحدات التحكم وواجهات المستخدم في نظام واحد يعمل بانسجام تام.
    </p>
  </div>

  <!-- مراحل النظام -->
  <div
    class="relative flex flex-col items-center md:flex-row md:justify-between gap-10 md:gap-6 text-center md:text-right"
  >
    {[
      {
        step: 1,
        title: "المستشعرات والمدخلات",
        desc: "حساسات الحركة والإضاءة ودرجة الحرارة والطقس والإشغال تجمع البيانات من العالم الحقيقي.",
        icon: Target,
        color: "from-sky-500 to-indigo-600",
      },
      {
        step: 2,
        title: "شبكة KNX / DALI",
        desc: "العمود الفقري للنظام الذي يربط جميع الأجهزة بسرعة عالية باستخدام كابل مزدوج أو شبكة IP.",
        icon: Network,
        color: "from-indigo-600 to-sky-500",
      },
      {
        step: 3,
        title: "وحدات التحكم والمنطق",
        desc: "وحدات RTI ومعالجات KNX تقوم بتنفيذ القواعد الزمنية والعمليات المؤتمتة والقرارات الذكية.",
        icon: Brain,
        color: "from-teal-500 to-sky-500",
      },
      {
        step: 4,
        title: "واجهات المستخدم",
        desc: "شاشات الجدران، تطبيقات الجوال، والمساعدات الصوتية تمنح المستخدم تحكمًا بديهيًا وسلسًا.",
        icon: Smartphone,
        color: "from-indigo-500 to-purple-500",
      },
      {
        step: 5,
        title: "التجربة الذكية",
        desc: "النتيجة — إضاءة وراحة وأمان تتكيف تلقائيًا مع أسلوب حياتك دون أي مجهود.",
        icon: Sparkles,
        color: "from-sky-400 to-indigo-600",
      },
    ].map((stage, idx) => (
      <div class="relative flex flex-col items-center text-center md:w-1/5">
        <!-- الأيقونة -->
        <div
          class={`flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br ${stage.color} shadow-lg mb-4 text-white`}
        >
          <stage.icon class="h-10 w-10 text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.4)]" />
        </div>

        <!-- العنوان -->
        <h4 class="text-lg font-semibold text-slate-900">{stage.title}</h4>
        <p class="mt-2 text-sm text-slate-600 leading-relaxed">{stage.desc}</p>

        <!-- الخطوط بين المراحل -->
        {idx < 4 && (
          <div
            class="hidden md:block absolute top-10 left-[-50%] h-[2px] w-[100%] bg-gradient-to-l from-sky-400/40 to-indigo-400/40"
          ></div>
        )}
      </div>
    ))}
  </div>

  <!-- تأثيرات زخرفية -->
  <div
    class="absolute -top-20 right-1/4 h-56 w-56 rounded-full bg-sky-300/20 blur-3xl"
  ></div>
  <div
    class="absolute bottom-0 left-1/3 h-56 w-56 rounded-full bg-indigo-300/20 blur-3xl"
  ></div>
</section>

<!-- ============================================================ -->
<!-- تحسينات العرض للأجهزة الصغيرة -->
<!-- ============================================================ -->
<style>
@media (max-width: 768px) {
  #system-flow .h-20 {
    height: 4.5rem;
    width: 4.5rem;
  }
  #system-flow h4 {
    font-size: 1rem;
  }
}
</style>