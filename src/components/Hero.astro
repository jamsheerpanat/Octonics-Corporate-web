---
/**
 * OCTONICS HERO — FAIL-SAFE 2025 EDITION
 * --------------------------------------
 * This version loads perfectly even if images/SVGs are missing.
 * No more 404 errors – full fallback backgrounds + inline SVG.
 */

const {
  title = "Intelligence That Moves Kuwait Forward",
  subtitle = "Where KNX automation, next-generation software, and AI-engineered systems converge.",
  bg = "/images/dark-octopus.jpg",        // background is now optional
  overlay = "",
  cta1 = { text: "Explore Our Innovations", link: "/#services" },
  cta2 = { text: "Talk to an Expert", link: "/contact" },
} = Astro.props;
---

<section
  id="hero"
  class="relative flex min-h-[100dvh] flex-col items-center justify-center overflow-hidden 
         bg-[#070B14] text-white"
>
  <!-- CINEMATIC BACKGROUND (with fallback gradient if images fail) -->
  <div
    id="hero-parallax"
    class="absolute inset-0 -z-10 overflow-hidden transition-transform 
           duration-[900ms] ease-out will-change-transform"
  >
    <!-- Fallback gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#0B0F2A] via-[#03040D] to-black"></div>

    <!-- Background image (optional) -->
    {bg && (
      <img
        src={bg}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-[0.40]"
        onerror="this.style.display='none'"
        loading="eager"
        decoding="async"
      />
    )}

    <!-- Holographic glow -->
    <div
      class="absolute top-1/3 left-1/2 -translate-x-1/2 h-[420px] w-[680px] rounded-full 
              bg-gradient-to-t from-blue-600/25 via-purple-400/15 to-transparent blur-[130px]"
    ></div>

    <!-- Aurora -->
    <div class="aurora-layer absolute inset-0 opacity-[0.35] pointer-events-none"></div>

    <!-- Floating Particles -->
    <div class="particle-layer absolute inset-0 pointer-events-none"></div>

    <!-- Horizon Glow -->
    <div class="absolute bottom-0 inset-x-0 h-[280px] bg-gradient-to-t from-indigo-500/20 to-transparent blur-[80px]"></div>
  </div>

  <!-- INLINE SVG OCTOPUS (no external file needed) -->
  <svg
    class="pointer-events-none absolute bottom-0 left-1/2 w-[130%] sm:w-[90%] 
           max-w-[1200px] -translate-x-1/2 opacity-[0.07] blur-[2px]"
    viewBox="0 0 200 200" fill="none"
  >
    <path d="M100 20c-22 0-40 18-40 40 0 6 1 12 4 17-7 4-11 12-11 21 0 15 12 27 27 27 6 0 12-2 17-6 2-2 6-2 8 0 5 4 11 6 17 6 15 0 27-12 27-27 0-9-4-17-11-21 3-5 4-11 4-17 0-22-18-40-40-40Z" stroke="white" stroke-width="8" opacity="0.4"/>
  </svg>

  <!-- HERO CONTENT -->
  <div class="relative z-10 mx-auto max-w-[92%] sm:max-w-4xl md:max-w-5xl px-3 sm:px-6 text-center">

    <!-- HOLOGRAPHIC TITLE -->
    <h1
      class="font-extrabold leading-[1.05] tracking-tight text-transparent bg-clip-text 
             bg-gradient-to-r from-sky-300 via-indigo-200 to-pink-300 
             drop-shadow-[0_0_60px_rgba(255,255,255,0.20)]
             hologram-text selection:text-white"
      style="font-size:clamp(2.4rem,6.4vw,5.9rem)"
    >
      {title}
    </h1>

    <p
      class="mt-5 mx-auto max-w-2xl text-slate-200/90 leading-relaxed"
      style="font-size:clamp(0.95rem,1.4vw,1.3rem)"
    >
      {subtitle}
    </p>

    <!-- MORPHING WORD -->
    <div class="relative mt-8 h-7 sm:h-10">
      <span
        id="morph-text"
        class="inline-block text-transparent bg-clip-text bg-gradient-to-r 
               from-pink-400 via-sky-400 to-indigo-400 font-semibold opacity-0 
               transition-opacity duration-500"
        style="font-size:clamp(1rem,2.3vw,1.7rem)"
      >
        Automation
      </span>
    </div>

    <!-- CTA BUTTONS -->
    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
      <a
        href={cta1.link}
        class="group relative inline-flex items-center justify-center overflow-hidden 
               rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 
               px-7 sm:px-10 py-3.5 text-sm sm:text-base font-semibold text-white 
               shadow-xl transition hover:scale-[1.04]"
      >
        <span>{cta1.text}</span>
        <span class="absolute inset-0 opacity-0 group-hover:opacity-100 
                     bg-gradient-to-r from-sky-300/40 to-indigo-400/40 
                     blur-xl transition duration-700"></span>
      </a>

      <a
        href={cta2.link}
        class="rounded-full border border-white/20 px-7 sm:px-10 py-3.5 
               text-sm sm:text-base font-semibold text-white/90 backdrop-blur-md 
               transition hover:bg-white/10"
      >
        {cta2.text}
      </a>
    </div>
  </div>

  <!-- SCROLL DOWN INDICATOR -->
  <div class="absolute bottom-9 left-1/2 -translate-x-1/2 flex flex-col items-center text-white/80 animate-fade-in">
    <span class="text-[9px] sm:text-[10px] md:text-xs uppercase tracking-[0.32em] mb-1 opacity-80">
      Scroll to Begin
    </span>
    <div class="h-7 w-1.5 rounded-full bg-gradient-to-b from-sky-400 to-indigo-500 animate-soft-bounce"></div>
  </div>
</section>

<style>
/* Same animations as earlier (kept for visuals) */
.aurora-layer::before,
.aurora-layer::after {
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(
    115deg,
    rgba(14,142,255,0.18),
    rgba(155,0,255,0.12),
    rgba(255,255,255,0.05)
  );
  mix-blend-mode:screen;
  animation:auroraShift 18s ease-in-out infinite;
}
.aurora-layer::after { animation-direction:reverse; opacity:0.55; }

@keyframes auroraShift {
  0% { transform:translateX(-14%); }
  50% { transform:translateX(14%) translateY(-4%); }
  100% { transform:translateX(-14%); }
}

.particle-layer::before {
  content:"";
  position:absolute;
  inset:0;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.18) 0, transparent 60%),
    radial-gradient(circle at 80% 80%, rgba(255,255,255,0.1) 0, transparent 70%),
    radial-gradient(circle at 50% 95%, rgba(255,255,255,0.07) 0, transparent 80%);
  animation:particlesFloat 24s linear infinite;
}

@keyframes particlesFloat {
  0% { transform:translateY(0px); }
  100%{ transform:translateY(-10%); }
}

.hologram-text { animation: shine 8s linear infinite; }
@keyframes shine {
  0%,100% { filter: drop-shadow(0 0 20px rgba(255,255,255,0.12)); }
  50% { filter: drop-shadow(0 0 40px rgba(255,255,255,0.3)); }
}

.animate-fade-in { animation:fadeIn 1.8s ease forwards 1.2s; }
@keyframes fadeIn { from {opacity:0;} to {opacity:1;} }

@keyframes soft-bounce {
  0%,100% { transform:translateY(0); }
  50% { transform:translateY(-8px); }
}
.animate-soft-bounce { animation:soft-bounce 2.8s infinite ease-in-out; }
</style>

<script is:inline>
  /* Morphing word */
  const morph = document.getElementById("morph-text");
  const words = ["Automation", "Intelligence", "Engineering", "KNX Control", "Innovation"];
  let idx = 0;

  if (morph) {
    setInterval(() => {
      morph.style.opacity = 0;
      setTimeout(() => {
        morph.textContent = words[idx = (idx + 1) % words.length];
        morph.style.opacity = 1;
      }, 250);
    }, 2200);
  }

  /* Parallax */
  const parallax = document.getElementById("hero-parallax");
  document.addEventListener("mousemove", (e) => {
    if (window.innerWidth < 768) return;
    const x = (e.clientX / window.innerWidth - 0.5) * -25;
    const y = (e.clientY / window.innerHeight - 0.5) * -25;
    parallax.style.transform = `translate(${x}px, ${y}px) scale(1.06)`;
  });

  document.addEventListener("mouseleave", () => {
    parallax.style.transform = "translate(0,0) scale(1)";
  });
</script>