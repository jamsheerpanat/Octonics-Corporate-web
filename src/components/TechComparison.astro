---
import { Building2, Wifi, Radio } from "lucide-react";
---

<!-- ============================================================ -->
<!-- TECHNOLOGY COMPARISON GRID – Enhanced Octonics Edition -->
<!-- ============================================================ -->
<section
  id="tech-comparison"
  class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:px-8"
  data-animate
>
  <!-- Heading -->
  <div class="text-center mb-14">
    <span class="inline-block rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700 ring-1 ring-sky-200">
      Choose Your Backbone
    </span>

    <h3 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">
      Compare Smart Automation Technologies
    </h3>

    <p class="mt-3 max-w-2xl mx-auto text-slate-600 leading-relaxed">
      Every project is unique — whether you’re designing a <b>luxury villa</b>, <b>modern office</b>, or <b>retrofit apartment</b>,
      Octonics helps you select the right automation foundation for long-term stability and performance.
    </p>
  </div>

  <!-- Comparison Grid -->
  <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
    {[
      {
        name: "KNX",
        type: "Wired",
        ideal: "Villas, Commercial Buildings",
        tech: "Bus-based DALI, TP, IP",
        brands: "Theben, Jung, ABB, MDT",
        icon: Building2,
        color: "from-indigo-600 to-sky-500",
        highlight:
          "A global open standard with 500+ certified manufacturers and 30+ years of reliability.",
      },
      {
        name: "Zigbee / Z-Wave",
        type: "Wireless Mesh",
        ideal: "Apartments, Retrofit Projects",
        tech: "Mesh Networking",
        brands: "Aqara, Philips Hue, SONOFF, Shelly",
        icon: Radio,
        color: "from-sky-500 to-teal-500",
        highlight:
          "Wireless mesh technology with self-healing networks and easy scalability.",
      },
      {
        name: "Wi-Fi IoT",
        type: "Wireless",
        ideal: "Smart Rooms, Small Offices",
        tech: "Direct IP / Cloud",
        brands: "Tuya, Shelly, Broadlink",
        icon: Wifi,
        color: "from-purple-600 to-indigo-600",
        highlight:
          "Quick to deploy and cost-effective using your existing Wi-Fi infrastructure.",
      },
    ].map((t) => (
      <div
        class={`group relative rounded-3xl bg-gradient-to-br ${t.color} p-[1px] shadow-lg hover:shadow-2xl transition-transform hover:-translate-y-1`}
      >
        <div
          class="flex flex-col h-full rounded-3xl bg-white/90 p-8 backdrop-blur-xl transition group-hover:bg-white"
        >
          <!-- Icon -->
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 text-indigo-700 shadow-inner mb-4"
          >
            <t.icon class="h-8 w-8 text-indigo-600" />
          </div>

          <!-- Title -->
          <h4 class="text-2xl font-bold text-slate-900">{t.name}</h4>
          <p class="mt-1 text-sm font-medium text-indigo-600">{t.type}</p>

          <!-- Details -->
          <p class="mt-3 text-sm text-slate-700 leading-relaxed">
            <strong>Best for:</strong> {t.ideal}<br />
            <strong>Technology:</strong> {t.tech}<br />
            <strong>Example Brands:</strong> {t.brands}
          </p>

          <!-- Highlight -->
          <p class="mt-4 text-sm italic text-slate-600">{t.highlight}</p>

          <!-- Button -->
          <div class="mt-6 flex justify-center">
            <a
              href="/#contact"
              class="rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-md transition hover:scale-105 hover:shadow-sky-300/40"
            >
              Explore {t.name} →
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Decorative glows -->
  <div class="absolute -top-20 left-1/3 h-56 w-56 rounded-full bg-sky-200/30 blur-3xl"></div>
  <div class="absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-indigo-300/30 blur-3xl"></div>
</section>

<!-- ============================================================ -->
<!-- STYLE ENHANCEMENTS -->
<!-- ============================================================ -->
<style>
@media (max-width: 768px) {
  #tech-comparison .h-16 {
    height: 3.5rem;
    width: 3.5rem;
  }
}
</style>