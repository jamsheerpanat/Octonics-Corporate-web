---
const mainLinks = [
  { label: "الرئيسية", href: "/ar/" },
  {
    label: "عن الشركة",
    submenu: [
      { label: "نبذة عن أوكتونيكس", href: "/ar/about" },
      { label: "شهادات KNX و RTI", href: "/ar/knx-certification" },
    ],
  },
  {
    label: "الخدمات",
    submenu: [
      {
        label: "برمجيات تخطيط موارد المؤسسات (ERP)",
        href: "/ar/services/erp-business-software",
      },
      {
        label: "تطوير أنظمة ERP مخصصة",
        href: "/ar/services/custom-erp-development",
      },
      { label: "تخصيص Odoo ERP", href: "/ar/services/odoo-erp-customization" },
      { label: "نظام مانتر ERP", href: "/ar/services/manter-erp" },
      {
        label: "تحليلات البيانات والذكاء الاصطناعي",
        href: "/ar/services/data-analytics-ai",
      },
      {
        label: "البنية التحتية لتقنية المعلومات",
        href: "/ar/services/it-infrastructure",
      },
      {
        label: "حوكمة تقنية المعلومات والأمن السيبراني",
        href: "/ar/services/it-governance-cybersecurity",
      },
      { label: "دعم تقنية المعلومات", href: "/ar/services/it-support" },
      { label: "الأتمتة الذكية", href: "/ar/services/smart-automation" },
      {
        label: "التحكم الذكي بالمنازل والمباني (KNX / DALI)",
        href: "/ar/services/smart-home-building",
      },
      {
        label: "أنظمة المراقبة والتحكم في الوصول",
        href: "/ar/services/surveillance-access-control",
      },
      {
        label: "تطوير تطبيقات الويب",
        href: "/ar/services/web-app-development",
      },
    ],
  },
  {
    label: "المنتجات",
    submenu: [
      { label: "جميع المنتجات", href: "/ar/products" },
      {
        label: "كيو آر الكويت — نظام الطلب الذكي",
        href: "/ar/products/qrkuwait",
      },
      { label: "أوكتو براين — ذكاء الأعمال", href: "/ar/products/octobrain" },
      {
        label: "أوكتو فاير — نظام تشغيل المؤسسات",
        href: "/ar/products/octovyre",
      },
      { label: "أوكتو جارد — المراقبة الذكية", href: "/ar/products/octoguard" },
      { label: "أوكتو سينس — ذكاء الطاقة", href: "/ar/products/octosense" },
      {
        label: "أوكتو ديسك — دعم تقنية المعلومات",
        href: "/ar/products/octodesk",
      },
      { label: "أوكتو ريتيل — ذكاء التجزئة", href: "/ar/products/octoretail" },
      {
        label: "أوكتو إتش آر — إدارة الموارد البشرية",
        href: "/ar/products/octohr",
      },
      { label: "أوكتو فولت — إدارة المستندات", href: "/ar/products/octovault" },
      { label: "أوكتو سيلز — ذكاء المبيعات", href: "/ar/products/octosales" },
      { label: "أوكتو توين — التوأم الرقمي", href: "/ar/products/octotwin" },
    ],
  },
  {
    label: "الخبرات",
    submenu: [
      { label: "المعرض", href: "/ar/gallery" },
      { label: "المدونة", href: "/ar/blog" },
    ],
  },
  { label: "تواصل معنا", href: "/ar/contact" },
];

const isArabic = Astro.url.pathname.startsWith("/ar");
const switchHref = isArabic
  ? Astro.url.pathname.replace("/ar", "") || "/"
  : `/ar${Astro.url.pathname}`;
---

<header
  id="site-header"
  dir="rtl"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-in-out"
>
  <nav
    id="navbar"
    class="mx-auto mt-2 sm:mt-4 mx-2 sm:mx-auto max-w-7xl flex items-center justify-between rounded-2xl sm:rounded-full border border-slate-200 bg-white/95 backdrop-blur-lg px-4 sm:px-6 py-2 sm:py-3 shadow-lg transition-all duration-500 hover:bg-white"
  >
    <!-- الشعار -->
    <a href="/ar/" class="flex items-center gap-2">
      <img
        src="/images/octonics-logo.png"
        alt="شعار أوكتونيكس إنوفيشنز"
        loading="lazy"
        class="h-8 sm:h-9 w-auto drop-shadow-md transition-transform hover:scale-105"
      />
    </a>

    <!-- زر القائمة للجوال -->
    <button
      id="nav-toggle"
      class="lg:hidden flex items-center justify-center rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 w-10 h-10 sm:w-11 sm:h-11 text-white shadow-md transition-transform active:scale-95"
      aria-label="فتح القائمة"
    >
      <svg
        class="w-5 h-5 sm:w-6 sm:h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- القائمة الرئيسية لسطح المكتب -->
    <ul
      class="hidden lg:flex items-center gap-4 xl:gap-7 text-[14px] xl:text-[15px] font-semibold text-slate-700"
    >
      {
        mainLinks.map((link) => (
          <li class="relative group">
            <a
              href={link.href ?? "#"}
              class="flex items-center gap-1 py-2 transition relative hover:text-sky-700 after:absolute after:bottom-0 after:right-0 after:h-[2px] after:w-0 after:bg-gradient-to-l after:from-sky-400 after:to-indigo-500 after:transition-all after:duration-300 group-hover:after:w-full"
            >
              {link.label}
              {link.submenu && (
                <span class="mr-1 text-xs text-slate-500">▾</span>
              )}
            </a>

            {link.submenu && (
              <ul class="absolute right-0 top-full mt-3 min-w-[260px] opacity-0 translate-y-3 scale-95 invisible group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-300 ease-out rounded-2xl border border-white/30 bg-white/80 p-3 shadow-2xl backdrop-blur-xl text-right">
                {link.submenu.map((sublink) => (
                  <li>
                    <a
                      href={sublink.href}
                      class="block rounded-xl px-3 py-2 text-sm text-slate-800 hover:bg-gradient-to-l hover:from-sky-50 hover:to-indigo-50 hover:text-sky-700 transition-all"
                    >
                      {sublink.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }

      <!-- زر اللغة -->
      <li>
        <a
          href={switchHref}
          class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-gradient-to-l hover:from-sky-500 hover:to-indigo-600 hover:text-white transition shadow-sm"
        >
          English
        </a>
      </li>

      <li>
        <a
          href="/ar/contact"
          class="rounded-full bg-gradient-to-l from-sky-500 to-indigo-600 px-5 py-2 text-white shadow-md transition hover:scale-105 hover:shadow-sky-300/40"
        >
          احصل على عرض
        </a>
      </li>
    </ul>
  </nav>

  <!-- قائمة الجوال -->
  <div
    id="mobile-panel"
    class="lg:hidden fixed left-2 right-2 top-[72px] sm:left-4 sm:right-4 sm:top-[80px] max-h-[calc(100vh-100px)] overflow-y-auto origin-top-left scale-95 opacity-0 invisible rounded-[2rem] border border-white/20 bg-white/90 backdrop-blur-2xl p-6 shadow-2xl transition-all duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] z-[100]"
  >
    <div
      class="mb-6 flex items-center justify-between opacity-50 px-2 uppercase tracking-[0.2em] text-[10px] font-bold text-slate-500"
    >
      <span>واجهة التنقل الرقمية</span>
      <span>v2.0</span>
    </div>
    <ul class="flex flex-col gap-3 font-bold text-slate-900 text-right">
      {
        mainLinks.map((link, idx) => (
          <li style={`animation-delay: ${idx * 50}ms`} class="mobile-item">
            {link.submenu ? (
              <details class="group/mobile">
                <summary class="list-none flex justify-between items-center p-4 rounded-2xl transition-colors active:bg-slate-100">
                  <span class="text-lg">{link.label}</span>
                  <svg
                    class="w-4 h-4 transition-transform group-open/mobile:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <ul class="pr-4 pl-2 py-2 space-y-1">
                  {link.submenu.map((sublink) => (
                    <li>
                      <a
                        href={sublink.href}
                        class="block p-3 rounded-xl text-slate-600 active:text-sky-600 active:bg-sky-50 transition-all text-sm"
                      >
                        {sublink.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={link.href}
                class="block p-4 text-lg rounded-2xl active:bg-slate-100"
              >
                {link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <!-- Mobile Action Bar -->
    <div class="mt-8 pt-6 border-t border-slate-200/50 space-y-3">
      <a
        href={switchHref}
        class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 text-slate-700 font-bold"
      >
        <span>تغيير اللغة</span>
        <span
          class="text-xs px-3 py-1 rounded-full bg-white border border-slate-200"
          >English</span
        >
      </a>

      <a
        href="/ar/contact"
        class="flex items-center justify-center p-5 rounded-[1.5rem] bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-black text-lg shadow-xl shadow-sky-500/20 active:scale-95 transition-transform"
      >
        ابدأ مشروعك
      </a>
    </div>
  </div>

  <style>
    .mobile-item {
      opacity: 0;
      transform: translateX(10px);
      transition: all 0.4s ease;
    }
    #mobile-panel:not(.opacity-0) .mobile-item {
      opacity: 1;
      transform: translateX(0);
    }
  </style>

  <!-- شريط التمرير -->
  <div
    id="progress"
    class="fixed left-0 top-0 h-[3px] w-0 bg-gradient-to-l from-sky-400 via-indigo-500 to-pink-500 shadow-[0_0_14px_rgba(99,102,241,.45)] transition-all duration-150"
  >
  </div>

  <script is:inline>
    const btn = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-panel");
    const progress = document.getElementById("progress");
    const header = document.getElementById("site-header");
    const navbar = document.getElementById("navbar");

    btn?.addEventListener("click", () => {
      panel?.classList.toggle("scale-95");
      panel?.classList.toggle("opacity-0");
      panel?.classList.toggle("invisible");
    });

    window.addEventListener("scroll", () => {
      const doc = document.documentElement;
      const scrolled = doc.scrollTop;
      const height = doc.scrollHeight - doc.clientHeight;
      const pct = Math.min(100, (scrolled / height) * 100);
      progress.style.width = pct + "%";
      header.style.filter = `hue-rotate(${pct * 3.6}deg)`;

      if (window.scrollY > 80) {
        navbar.classList.add(
          "bg-white",
          "border-slate-200",
          "shadow-[0_8px_40px_rgba(0,0,0,0.1)]",
        );
        navbar.classList.remove("bg-white/60", "border-white/30");
      } else {
        navbar.classList.add("bg-white/60", "border-white/30");
        navbar.classList.remove("bg-white", "border-slate-200");
      }
    });
  </script>
</header>
