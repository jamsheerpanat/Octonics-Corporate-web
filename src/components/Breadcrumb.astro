---
/**
 * Breadcrumb – simple breadcrumb navigation component
 */
interface BreadcrumbItem {
  href: string;
  label: string;
}

const { items = [] } = Astro.props;
---
<nav aria-label="breadcrumb" class="flex items-center space-x-2 text-sm text-slate-500 mb-6" dir="ltr">
  {items.map((item, idx) => (
    <>
      <a href={item.href} class="hover:underline text-slate-300">{item.label}</a>
      {idx < items.length - 1 && <span class="mx-1">/</span>}
    </>
  ))}
</nav>
