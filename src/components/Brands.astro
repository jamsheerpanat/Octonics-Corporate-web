---
/* ============================================================
   BRANDS / TECHNOLOGY SHOWCASE – Enhanced Premium Section
   Author: Octonics Innovations | Kuwait
   ============================================================ */
---

<section
  id="brands"
  class="relative mx-auto mt-28 max-w-7xl overflow-hidden px-4 py-24 sm:px-6 lg:px-8"
  data-animate
>
  <!-- Gradient background layers -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-br from-white via-slate-50 to-sky-50"></div>
  <div aria-hidden="true" class="absolute -top-16 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-sky-200/40 blur-3xl"></div>
  <div aria-hidden="true" class="absolute bottom-0 right-10 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"></div>

  <!-- Section Heading -->
  <div class="text-center">
    <span
      class="inline-block rounded-full bg-gradient-to-r from-sky-100 to-indigo-100 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-sky-700 ring-1 ring-sky-200"
    >
      Technology Partners
    </span>

    <h2 class="mt-4 text-4xl font-extrabold text-slate-900 sm:text-5xl">
      Trusted <span class="text-sky-600">Brands</span> in Every Connection
    </h2>

    <p class="mx-auto mt-4 max-w-2xl text-slate-600 leading-relaxed">
      We integrate world-class <b>smart home</b>, <b>AI</b>, and <b>automation technologies</b> to deliver seamless
      reliability, security, and intelligent experiences — transforming every environment into a connected ecosystem.
    </p>
  </div>

  <!-- Marquee Container -->
  <div
    class="relative mx-auto mt-16 overflow-hidden rounded-3xl bg-white/80 shadow-2xl ring-1 ring-slate-200 backdrop-blur-lg"
  >
    <div
      class="flex min-w-full animate-[marquee_45s_linear_infinite] gap-12 whitespace-nowrap py-8 hover:[animation-play-state:paused]"
    >
      {[
        "/images/brands/knx.png",
        "/images/brands/theben.png",
        "/images/brands/gira.png",
        "/images/brands/abb.png",
        "/images/brands/schneider.png",
        "/images/brands/rti.png",
        "/images/brands/dali.png",
        "/images/brands/philips.png",
        "/images/brands/somfy.png",
        "/images/brands/sonos.png",
      ].map((src) => (
        <div
          class="relative mx-8 inline-flex h-20 items-center justify-center rounded-2xl bg-gradient-to-br from-white/95 to-slate-100/80 px-8 shadow-md ring-1 ring-slate-200 backdrop-blur-md transition hover:-translate-y-1 hover:shadow-2xl hover:ring-sky-300 hover:bg-white"
        >
          <img
            src={src}
            alt="Technology Brand"
            loading="lazy"
            class="h-12 w-auto max-w-[160px] mix-blend-multiply brightness-110 contrast-110 opacity-95 transition-all hover:opacity-100 hover:scale-105"
            onerror="this.src='/images/placeholder-logo.png'; this.style.opacity='0.3';"
          />
          <div
            class="absolute inset-0 rounded-2xl bg-gradient-to-r from-sky-100/0 via-sky-100/20 to-transparent opacity-0 transition hover:opacity-100"
          ></div>
        </div>
      ))}

      <!-- Duplicate for seamless scroll -->
      {[
        "/images/brands/knx.png",
        "/images/brands/theben.png",
        "/images/brands/gira.png",
        "/images/brands/abb.png",
        "/images/brands/schneider.png",
        "/images/brands/rti.png",
        "/images/brands/dali.png",
        "/images/brands/philips.png",
        "/images/brands/somfy.png",
        "/images/brands/sonos.png",
      ].map((src) => (
        <div
          class="relative mx-8 inline-flex h-20 items-center justify-center rounded-2xl bg-gradient-to-br from-white/95 to-slate-100/80 px-8 shadow-md ring-1 ring-slate-200 backdrop-blur-md transition hover:-translate-y-1 hover:shadow-2xl hover:ring-sky-300 hover:bg-white"
        >
          <img
            src={src}
            alt="Technology Brand"
            loading="lazy"
            class="h-12 w-auto max-w-[160px] mix-blend-multiply brightness-110 contrast-110 opacity-95 transition-all hover:opacity-100 hover:scale-105"
            onerror="this.src='/images/placeholder-logo.png'; this.style.opacity='0.3';"
          />
          <div
            class="absolute inset-0 rounded-2xl bg-gradient-to-r from-sky-100/0 via-sky-100/20 to-transparent opacity-0 transition hover:opacity-100"
          ></div>
        </div>
      ))}
    </div>
  </div>

  <!-- Subtext -->
  <p class="mx-auto mt-10 max-w-xl text-center text-sm text-slate-500">
    Partnering with leaders in <b>KNX</b>, <b>DALI</b>, <b>AI Visualization</b>, and <b>Home Intelligence</b>.
  </p>

  <!-- Decorative glow ring -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 left-1/2 h-48 w-[90%] -translate-x-1/2 rounded-full bg-gradient-to-r from-sky-200/30 via-indigo-200/20 to-sky-200/30 blur-3xl"
  ></div>
</section>

<!-- ============================================================ -->
<!-- MARQUEE ANIMATION & MEDIA QUERIES -->
<!-- ============================================================ -->
<style>
@keyframes marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media (max-width: 768px) {
  #brands .h-12 {
    height: 2.5rem; /* smaller logos for mobile */
  }
  #brands .mx-8 {
    margin-left: 1rem;
    margin-right: 1rem;
  }
  #brands .px-8 {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}
</style>