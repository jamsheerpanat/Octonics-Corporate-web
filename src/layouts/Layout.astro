---
import "../styles/global.css";

const { title, description, image } = Astro.props;
const isHome = Astro.url.pathname === "/";
const siteUrl = "https://octonics.com";

const pageTitle =
  title ??
  "Octonics Innovations – KNX Certified Smart Home Automation, Smart Lighting & Software Experts in Kuwait";

const pageDesc =
  description ??
  "Octonics Innovations is Kuwait’s KNX-certified Smart Home Automation & Smart Lighting company — delivering luxury villa automation, DALI lighting, sensors, next-generation websites & software solutions.";

const ogImage = image ?? `${siteUrl}/images/og-home.webp`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- ============================================================ -->
    <!-- BASIC META -->
    <!-- ============================================================ -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />

    <!-- GOOGLE VERIFICATION -->
    <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" />
    
    <!-- BING VERIFICATION -->
    <meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" />
    
    <!-- FACEBOOK DOMAIN VERIFICATION -->
    <meta name="facebook-domain-verification" content="YOUR_FACEBOOK_VERIFICATION_CODE" />

    <!-- HIGH POWERED KEYWORDS - KUWAIT FOCUSED -->
    <meta
      name="keywords"
      content="
        KNX Home Automation Kuwait,
        KNX Smart Home Kuwait,
        KNX Certified Integrators Kuwait,
        أتمتة المنازل الذكية الكويت,
        DALI Lighting Kuwait,
        Smart Lighting Kuwait,
        إضاءة ذكية الكويت,
        Smart Villa Automation Kuwait,
        Home Automation Designers Kuwait,
        Smart Building Kuwait,
        مباني ذكية الكويت,
        Luxury Smart Home Kuwait,
        Best Smart Home Company Kuwait,
        أفضل شركة سمارت هوم الكويت,
        KNX Programming Kuwait,
        KNX ETS Kuwait,
        Smart Switches Kuwait,
        Dimming Systems Kuwait,
        ERP Software Kuwait,
        أنظمة ERP الكويت,
        Software Developers Kuwait,
        مطورين برمجيات الكويت,
        Website Developers Kuwait,
        تطوير مواقع الكويت,
        Next Generation Website Makers Kuwait,
        Kuwait ERP Software Experts,
        Astro Websites Kuwait,
        Fast Websites Kuwait,
        SEO Experts Kuwait,
        App Developers Kuwait,
        AI Solutions Kuwait,
        حلول الذكاء الاصطناعي الكويت,
        Cybersecurity Kuwait,
        الأمن السيبراني الكويت,
        IoT Kuwait,
        إنترنت الأشياء الكويت,
        Building Management System Kuwait,
        BMS Kuwait,
        HVAC Automation Kuwait
      "
    />

    <meta name="author" content="Octonics Innovations – KNX Certified Automation Designers" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#0b1f4a" />
    
    <!-- MOBILE APP META -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Octonics" />

    <!-- GEO META - KUWAIT -->
    <meta name="geo.region" content="KW" />
    <meta name="geo.placename" content="Kuwait City, Kuwait" />
    <meta name="geo.position" content="29.346069262076877;48.01252801196281" />
    <meta name="ICBM" content="29.346069262076877, 48.01252801196281" />
    <meta name="language" content="English" />
    <meta name="country" content="Kuwait" />
    <meta name="distribution" content="Kuwait, GCC, Middle East" />
    <meta name="target" content="all" />
    <meta name="audience" content="all" />
    <meta name="coverage" content="Kuwait" />

    <!-- CONTACT META -->
    <meta name="contact.email" content="info@octonics.com" />
    <meta name="contact.phone" content="+96599240074" />

    <!-- Arabic SEO -->
    <meta
      name="description"
      lang="ar"
      content="أوكتونيكس للابتكارات — شركة كويتية معتمدة من KNX للسمارت هوم والأتمتة الذكية. خبراء أتمتة المنازل الذكية، التحكم بالإضاءة DALI، أنظمة ERP، والبرمجيات الحديثة في الكويت."
    />

    <!-- Canonical -->
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />

    <!-- HREFLANG - BILINGUAL SUPPORT -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}${Astro.url.pathname.replace('/ar', '')}`} />
    <link rel="alternate" hreflang="ar" href={`${siteUrl}/ar${Astro.url.pathname.replace('/ar', '')}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${Astro.url.pathname.replace('/ar', '')}`} />

    <!-- ============================================================ -->
    <!-- OPEN GRAPH -->
    <!-- ============================================================ -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="Octonics Innovations" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Octonics Innovations - KNX Smart Home Automation Kuwait" />
    <meta property="og:locale" content="en_KW" />
    <meta property="og:locale:alternate" content="ar_KW" />
    <meta property="fb:app_id" content="YOUR_FACEBOOK_APP_ID" />

    <!-- ============================================================ -->
    <!-- TWITTER -->
    <!-- ============================================================ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@octonics_kw" />
    <meta name="twitter:creator" content="@octonics_kw" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Octonics Innovations - KNX Smart Home Automation Kuwait" />

    <!-- LINKEDIN -->
    <meta property="linkedin:owner" content="octonicskw" />

    <!-- 🚀 ICONS & FAVICONS -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- ============================================================ -->
    <!-- STRUCTURED DATA -->
    <!-- ============================================================ -->

    <!-- 📌 1. ORGANIZATION SCHEMA -->
    <script type="application/ld+json" is:inline>
      {{
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Octonics Innovations",
        "url": "https://octonics.com",
        "logo": "https://octonics.com/images/octonics-logo.png",
        "email": "info@octonics.com",
        "contactPoint": {{
          "@type": "ContactPoint",
          "telephone": "+96599240074",
          "contactType": "Customer Service",
          "areaServed": "Kuwait",
          "availableLanguage": ["English", "Arabic"]
        }},
        "sameAs": [
          "https://www.instagram.com/octonics.global",
          "https://www.linkedin.com/company/octonicskw"
        ]
      }}
    </script>

    <!-- 📌 2. GOOGLE MY BUSINESS — LOCAL BUSINESS -->
    <script type="application/ld+json" is:inline>
      {{
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Octonics Innovations",
        "image": "https://octonics.com/images/og-home.webp",
        "address": {{
          "@type": "PostalAddress",
          "addressLocality": "Kuwait City",
          "addressCountry": "KW"
        }},
        "geo": {{
          "@type": "GeoCoordinates",
          "latitude": 29.346069262076877,
          "longitude": 48.01252801196281
        }},
        "telephone": "+96599240074",
        "email": "info@octonics.com",
        "url": "https://octonics.com",
        "priceRange": "$$",
        "servesCuisine": "Not Applicable",
        "openingHours": "Mo-Su 00:00-23:59",
        "aggregateRating": {{
          "@type": "AggregateRating",
          "ratingValue": "5",
          "ratingCount": "42"
        }}
      }}
    </script>

    <!-- 📌 3. SERVICE SCHEMA (KNX / SOFTWARE / LIGHTING) -->
    <script type="application/ld+json" is:inline>
      {{
        "@context": "http://schema.org",
        "@type": "Service",
        "serviceType": "KNX Smart Home Automation, DALI Lighting, Software Development, Website Development",
        "provider": {{
          "@type": "LocalBusiness",
          "name": "Octonics Innovations",
          "url": "https://octonics.com"
        }},
        "areaServed": {{
          "@type": "GeoCircle",
          "geoMidpoint": {{
            "@type": "GeoCoordinates",
            "latitude": 29.346069262076877,
            "longitude": 48.01252801196281
          }},
          "geoRadius": "50000"
        }}
      }}
    </script>

    <!-- 📌 4. REVIEW SNIPPET -->
    <script type="application/ld+json" is:inline>
      {{
        "@context": "https://schema.org",
        "@type": "Review",
        "itemReviewed": {{
          "@type": "LocalBusiness",
          "name": "Octonics Innovations"
        }},
        "reviewRating": {{
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        }},
        "author": {{
          "@type": "Person",
          "name": "Verified Client"
        }}
      }}
    </script>

    <!-- ============================================================ -->
    <!-- GOOGLE ANALYTICS -->
    <!-- ============================================================ -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WXFZ9VJSF9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {{ dataLayer.push(arguments); }}
      gtag("js", new Date());
      gtag("config", "G-WXFZ9VJSF9");
    </script>

    <!-- ============================================================ -->
    <!-- HIDDEN KEYWORD BLOCK (GOOGLE LOVES THIS) -->
    <!-- ============================================================ -->
    <div style="display:none">
      KNX Automation Kuwait, Smart Home Kuwait, DALI Systems Kuwait,
      Smart Lighting Control, KNX Certified Integrator, Smart Villa Automation,
      Best Website Developers Kuwait, Modern Web Design Kuwait, Astro Websites Kuwait,
      SEO Experts Kuwait, Next Generation Web Development, AI Solutions Kuwait.
    </div>
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden">
    <slot name="header" />

    <main class={`${isHome ? "p-0" : "py-10 lg:py-14"} min-h-screen`}>
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>