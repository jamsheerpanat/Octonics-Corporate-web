---
import "../styles/global.css";

const { title, description, image } = Astro.props;
const isHome = Astro.url.pathname === "/";
const siteUrl = "https://octonics.com";
const pageTitle = title ?? "Octonics Innovations – Smart Automation & AI Solutions in Kuwait";
const pageDesc =
  description ??
  "Kuwait’s KNX-certified Smart Automation, ERP, and IT Solutions company — delivering intelligent systems for homes, enterprises, and industries.";
const ogImage = image ?? `${siteUrl}/images/og-home.webp`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- ============================================================ -->
    <!-- BASIC META -->
    <!-- ============================================================ -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content="Octonics Innovations Kuwait, Smart Automation, KNX, DALI, RTI, ERP Software, AI Kuwait, IT Infrastructure, Smart Home, Building Automation, Cybersecurity Kuwait, Octonics KNX Certified" />
    <meta name="author" content="Octonics Innovations" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b1f4a" />

    <!-- Canonical -->
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />

    <!-- ============================================================ -->
    <!-- OPEN GRAPH / WHATSAPP / FACEBOOK / LINKEDIN -->
    <!-- ============================================================ -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="Octonics Innovations" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- ============================================================ -->
    <!-- TWITTER CARDS -->
    <!-- ============================================================ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@OctonicsKW" />

    <!-- ============================================================ -->
    <!-- SEO & PERFORMANCE IMPROVEMENTS -->
    <!-- ============================================================ -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Preconnect for faster load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- ============================================================ -->
    <!-- STRUCTURED DATA (JSON-LD for Google) -->
    <!-- ============================================================ -->
    <script type="application/ld+json" is:inline>
      {{
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Octonics Innovations",
        "url": "https://octonics.com",
        "logo": "https://octonicskw.com/images/octonics-logo.png",
        "sameAs": [
          "https://www.instagram.com/octonics.global",
          "https://www.linkedin.com/company/octonicskw",
          "https://www.facebook.com/octonics"
        ],
        "description": "Octonics Innovations is Kuwait’s next-generation KNX-certified technology company specializing in Smart Automation, ERP Software, AI, and IT Infrastructure.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Office 46, Hawally Arab Complex, Block 205, Plot 4",
          "addressLocality": "Hawally",
          "addressCountry": "KW"
        },
        "contactPoint": [
          {{
            "@type": "ContactPoint",
            "telephone": "+96599240074",
            "contactType": "Customer Support",
            "areaServed": "KW",
            "availableLanguage": ["English", "Arabic"]
          }}
        ]
      }}
    </script>

    <!-- ============================================================ -->
    <!-- GOOGLE ANALYTICS -->
    <!-- ============================================================ -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WXFZ9VJSF9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){{dataLayer.push(arguments);}}
      gtag('js', new Date());
      gtag('config', 'G-WXFZ9VJSF9');
    </script>
  </head>

  <!-- ============================================================ -->
  <!-- BODY CONTENT -->
  <!-- ============================================================ -->
  <body class="bg-slate-50 text-slate-900 antialiased overflow-x-hidden">
    <slot name="header" />

    <main class={`${isHome ? "p-0" : "py-10 lg:py-14"} min-h-screen`}>
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>