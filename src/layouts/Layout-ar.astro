---
import "../styles/global.css";
const { title, description, image } = Astro.props;

const siteUrl = "https://octonics.com";
const pageTitle = title ?? "أوكتونيكس للابتكارات – أنظمة الأتمتة الذكية وحلول الذكاء الاصطناعي في الكويت";
const pageDesc =
  description ??
  "شركة أوكتونيكس للابتكارات في الكويت، معتمدة من KNX، متخصصة في الأتمتة الذكية للمنازل والمباني، الأنظمة السحابية، وحلول الذكاء الاصطناعي وإدارة الأعمال.";
const ogImage = image ?? `${siteUrl}/images/og-home-ar.webp`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <!-- ============================================================ -->
    <!-- البيانات الأساسية -->
    <!-- ============================================================ -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta
      name="keywords"
      content="أوكتونيكس الكويت, أتمتة المنازل, KNX الكويت, DALI, أنظمة تحكم ذكية, الذكاء الاصطناعي, أنظمة المباني الذكية, شركة تقنية معلومات الكويت, برامج ERP, الأمن السيبراني الكويت"
    />
    <meta name="author" content="Octonics Innovations" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b1f4a" />

    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- ============================================================ -->
    <!-- بيانات المشاركة (واتساب / فيسبوك / لينكدإن) -->
    <!-- ============================================================ -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:locale" content="ar_KW" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="Octonics Innovations" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- ============================================================ -->
    <!-- بطاقات تويتر -->
    <!-- ============================================================ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@OctonicsKW" />

    <!-- ============================================================ -->
    <!-- تحسين الأداء -->
    <!-- ============================================================ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- ============================================================ -->
    <!-- بيانات منظمة Schema.org -->
    <!-- ============================================================ -->
    <script type="application/ld+json" is:inline>
      {{
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "شركة أوكتونيكس للابتكارات",
        "url": "https://octonics.com/ar",
        "logo": "https://octonics.com/images/octonics-logo.png",
      "sameAs": [
          "https://www.instagram.com/octonics.global",
          "https://www.linkedin.com/company/octonicskw",
          "https://www.facebook.com/octonics"
        ],
        "description": "شركة أوكتونيكس للابتكارات في الكويت، معتمدة من KNX، تقدم حلول أتمتة ذكية للمنازل والشركات، وأنظمة الذكاء الاصطناعي و ERP.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "مكتب رقم 46، الطابق السفلي، مجمع العربي، حولي، الكويت",
          "addressLocality": "حولي",
          "addressCountry": "KW"
        },
        "contactPoint": [
          {{
            "@type": "ContactPoint",
            "telephone": "+96599240074",
            "contactType": "خدمة العملاء",
            "areaServed": "الكويت",
            "availableLanguage": ["Arabic", "English"]
          }}
        ]
      }}
    </script>

    <!-- ============================================================ -->
    <!-- Google Analytics -->
    <!-- ============================================================ -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WXFZ9VJSF9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){{dataLayer.push(arguments);}}
      gtag('js', new Date());
      gtag('config', 'G-WXFZ9VJSF9');
    </script>
  </head>

  <!-- ============================================================ -->
  <!-- BODY -->
  <!-- ============================================================ -->
  <body class="bg-slate-50 text-slate-900 antialiased font-[Tajawal] overflow-x-hidden">
    <slot name="header" />
    <main class="min-h-screen">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>